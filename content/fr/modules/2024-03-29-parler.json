      "fr": "nous parlons",
      "gloss": "we speak",
      "note": "add -ons (pronounced!)"
    },
    {
      "word_id": "vous-parlez-fr",
      "fr": "vous parlez",
      "gloss": "you speak (formal)",
      "note": "add -ez (pronounced!)"
    },
