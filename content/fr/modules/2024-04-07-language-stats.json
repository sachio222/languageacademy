  "sections": [
    {
      "id": "s-french-sounds-phonology",
      "heading": "French sounds",
      "text": "French has about 36 distinct sounds. Four of them are nasal vowels, which English does not have.",
      "examples": [
        {
          "fr": "blanc",
          "en": "white",
          "note": "the nasal vowel in {an}"
        },
        {
          "fr": "le vin",
          "en": "wine",
          "note": "the nasal vowel in {in}"
        },
        {
          "fr": "bon",
          "en": "good",
          "note": "the nasal vowel in {on}"
        },
        {
          "fr": "un",
          "en": "one",
          "note": "the nasal vowel in {un}"
        },
        {
          "fr": "rouge",
          "en": "red",
          "note": "the r comes from the back of the throat"
        }
      ]
    },
    {
      "id": "s-syllable-timed-language",
      "heading": "Even rhythm",
      "text": "French gives each syllable about the same length. English stresses some syllables and shortens others.",
      "layout": "plain",
      "examples": [
        {
          "text": "No stressed syllable inside a word, as English has"
        },
        {
          "text": "A little more weight on the last syllable of a phrase"
        },
        {
          "text": "An even, flowing rhythm"
        }
      ]
    },
    {
      "id": "s-speaking-speed",
      "heading": "Speaking speed",
      "text": "French speakers say about 7 to 8 syllables a second, and English speakers about 6.5.",
      "layout": "plain",
      "examples": [
        {
          "text": "French needs more syllables to say the same thing"
        },
        {
          "text": "So speakers talk faster, and about as much is said each second"
        }
      ]
    },
    {
      "id": "s-the-alphabet-accents",
      "heading": "Letters and accents",
      "text": "French uses the 26 English letters, five accents and two joined letters. Each word below shows one of them.",
      "examples": [
        {
          "fr": "l'été",
          "en": "summer",
          "note": "é"
        },
        {
          "fr": "très",
          "en": "very",
          "note": "è"
        },
        {
          "fr": "la fête",
          "en": "the party",
          "note": "ê"
        },
        {
          "fr": "Noël",
          "en": "Christmas",
          "note": "ë"
        },
        {
          "fr": "ça",
          "en": "that",
          "note": "ç"
        },
        {
          "fr": "le cœur",
          "en": "the heart",
          "note": "œ"
        }
      ]
    },
    {
      "id": "s-vocabulary-size",
      "heading": "How many words",
      "text": "A large French dictionary lists about 100,000 words in common use.",
      "layout": "plain",
      "examples": [
        {
          "text": "Le Grand Robert dictionary: 100,000 words and 350,000 definitions"
        },
        {
          "text": "An educated speaker uses about 30,000 words"
        },
        {
          "text": "Most people know between 5,000 and 30,000"
        }
      ]
    },
    {
      "id": "s-french-influence-on-english",
      "heading": "French in English",
      "text": "About 29% of English words come from French, many since the Norman Conquest of 1066. English took the French words for several kinds of meat.",
      "examples": [
        {
          "fr": "le bœuf",
          "en": "beef, and also the animal"
        },
        {
          "fr": "le porc",
          "en": "pork, and also the animal"
        },
        {
          "fr": "le mouton",
          "en": "mutton, and also the sheep"
        },
        {
          "fr": "le parlement",
          "en": "parliament"
        }
      ]
    },
    {
      "id": "s-grammar-complexity",
      "heading": "Grammar in numbers",
      "text": "French has two genders and many tenses, though everyday speech uses only a few of them.",
      "layout": "plain",
      "examples": [
        {
          "text": "Every noun is masculine or feminine"
        },
        {
          "text": "Three groups of regular verbs, ending in -er, -ir and -re"
        },
        {
          "text": "About 350 irregular verbs, of which about 50 are common"
        },
        {
          "text": "Subject, verb, object: the same order as English"
        }
      ]
    },
    {
      "id": "s-global-ranking",
      "heading": "French in the world",
      "text": "French is the fifth most spoken language and the second most studied.",
      "layout": "plain",
      "examples": [
        {
          "text": "About 300 million speakers in 2023"
        },
        {
          "text": "About 700 million expected by 2050"
        },
        {
          "text": "An official language in 29 countries"
        },
        {
          "text": "One of the six official languages of the UN"
        }
      ]
    },
    {
      "id": "s-fun-language-facts",
      "heading": "Records",
      "text": "A few records from French. The most common letter is e.",
      "examples": [
        {
          "fr": "anticonstitutionnellement",
          "en": "unconstitutionally",
          "note": "one of the longest French words, with 25 letters"
        },
        {
          "fr": "de",
          "en": "of, from",
          "note": "the most common French word"
        }
      ]
    },
    {
      "id": "s-liaison-flow",
      "heading": "Liaison",
      "text": "A final consonant that is usually silent is said when the next word starts with a vowel.",
      "examples": [
        {
          "fr": "les enfants",
          "en": "the children",
          "note": "sounds like lay-zahn-fahn"
        },
        {
          "fr": "un homme",
          "en": "a man",
          "note": "sounds like uh-nom"
        },
        {
          "fr": "les amis",
          "en": "the friends",
          "note": "sounds like lay-za-mee"
        }
      ]
    },
    {
      "id": "s-l-academie-francaise",
      "heading": "{l'Académie française}",
      "text": "Since 1635 the French Academy has set the official rules of French. Its 40 members are called the immortals, and they suggest French words in place of English ones.",
      "examples": [
        {
          "fr": "un ordinateur",
          "en": "a computer"
        },
        {
          "fr": "un courriel",
          "en": "an email",
          "note": "the Academy's word; many people say {e-mail}"
        }
      ]
    },
    {
      "id": "s-perfect-french-pangram",
      "heading": "A sentence with every letter",
      "text": "This sentence uses all 26 letters of the alphabet.",
      "examples": [
        {
          "fr": "Portez ce vieux whisky au juge blond qui fume.",
          "en": "Bring this old whisky to the blond judge who is smoking."
        }
      ]
    }
  ]
