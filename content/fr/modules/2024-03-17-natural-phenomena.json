  "concepts": [
    {
      "id": "c-natural-process-verbs",
      "term": "Natural Process Verbs",
      "definition": "Verbs that describe what happens in nature - shining, growing, raining",
      "example": "{Le soleil brille} (the sun shines), {Les plantes poussent} (plants grow), {Le vent souffle} (the wind blows)"
    },
    {
      "id": "c-pleuvoir-impersonal-verb",
      "term": "{pleuvoir} - Impersonal Verb",
      "definition": "Pleuvoir (to rain) only uses '{il}' form - il pleut (it rains)",
      "example": "{il pleut} (it rains), {il a plu} (it rained), {il pleuvait} (it was raining)"
    },
    {
      "id": "c-rendre-critical-causative-verb",
      "term": "{rendre} - CRITICAL Causative Verb!",
      "definition": "{rendre} with an adjective means to make something that way. It is a regular -re verb, like {attendre}: {nous rendons}, {ils rendent}.",
      "example": "{Le soleil rend l'herbe verte} (the sun makes grass green), {Le froid rend l'eau glacée} (cold makes water frozen)"
    },
    {
      "id": "c-causative-pattern-rendre-adjective",
      "term": "Causative Pattern: rendre + adjective",
      "definition": "Pattern: [subject] + rendre + [object] + [adjective] = subject makes object [adjective]",
      "example": "{La pluie rend la terre humide} (rain makes the earth wet), {Le soleil rend l'herbe verte} (the sun makes grass green)"
    },
    {
      "id": "c-setting-up-question-patterns",
      "term": "Setting Up Question Patterns",
      "definition": "The next lessons use these verbs to ask why and how.",
      "example": "{Pourquoi est-ce que le soleil brille ? Comment est-ce que les plantes poussent ?}"
    },
    {
      "id": "c-ne-plus-no-longer",
      "term": "{ne … plus}: no longer",
      "definition": "Put {ne} before the verb and {plus} after it to say that something has stopped. It works like {ne … pas}.",
      "example": "{Il ne pleut plus.} (It isn't raining any more.) {Le vent ne souffle plus.} (The wind isn't blowing any more.)"
    }
  ],
