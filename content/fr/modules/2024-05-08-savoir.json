    {
      "id": "c-savoir-to-know-facts",
      "term": "{savoir} = to know",
      "definition": "Use {savoir} for facts you know and for things you know how to do.",
      "examples": [
        {
          "fr": "Je sais la réponse.",
          "en": "I know the answer."
        },
        {
          "fr": "Je sais que c'est vrai.",
          "en": "I know it's true."
        }
      ]
    },
    {
