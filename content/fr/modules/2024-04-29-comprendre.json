    },
    {
      "id": "c-most-common-use-je",
      "term": "{Je ne comprends pas}",
      "definition": "The sentence you will need most while you learn.",
      "examples": [
        {
          "fr": "Je ne comprends pas.",
          "en": "I don't understand."
        },
        {
          "fr": "Pardon, je ne comprends pas.",
          "en": "Sorry, I don't understand."
        },
        {
          "fr": "Tu comprends ?",
          "en": "Do you understand?"
        }
      ]
    },
    {
      "id": "c-comprendre-noun",
      "term": "Understanding people and things",
      "definition": "Put the person or thing straight after the verb.",
      "examples": [
        {
          "fr": "Je comprends Marie.",
          "en": "I understand Marie."
        },
        {
          "fr": "Je comprends la leçon.",
          "en": "I understand the lesson."
        }
      ]
    },
    {
      "id": "c-building-on-prendre-knowledge",
      "term": "The {prendre} family",
      "definition": "{prendre} means to take. With a front added, it gives {apprendre}, to learn, and {comprendre}, to understand.",
      "examples": [
        {
          "fr": "Je prends le livre.",
          "en": "I take the book."
        },
        {
          "fr": "J'apprends le français.",
          "en": "I'm learning French."
        },
        {
          "fr": "Je comprends la leçon.",
          "en": "I understand the lesson."
        }
      ]
    }
