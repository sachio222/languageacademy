  "concepts": [
    {
      "id": "c-dormir-to-sleep-rank",
      "term": "{dormir} = to sleep (rank 54)",
      "definition": "Regular -IR verb for sleeping - essential for daily routines",
      "example": "{je dors} (I sleep), {je dors huit heures} (I sleep 8 hours), {tu dors bien?} (do you sleep well?)"
    },
    {
      "id": "c-travailler-to-work-rank",
      "term": "{travailler} = to work (rank 55)",
      "definition": "Regular -ER verb for working - essential for adult life",
      "example": "{je travaille} (I work), {je travaille à Paris} (I work in Paris), {où travaillez-vous?} (where do you work?)"
    },
    {
      "id": "c-vivre-to-live-rank",
      "term": "{vivre} = to live (rank 56)",
      "definition": "Irregular verb for living/being alive - existential and location",
      "example": "{je vis} (I live), {je vis à Paris} (I live in Paris), {vivre sa vie} (to live one's life)"
    },
    {
      "id": "c-daily-life-integration",
      "term": "Daily Life Integration",
      "definition": "These three verbs complete your ability to describe human existence",
      "example": "{Je vis à Paris, je travaille au centre-ville, et je dors bien} (I live in Paris, work downtown, and sleep well)"
    }
