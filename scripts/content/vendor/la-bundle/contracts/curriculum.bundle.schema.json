    "GuideBody": {
      "type": "object",
      "required": [
        "line",
        "parts"
      ],
      "additionalProperties": false,
      "description": "Body of a guide's interactive-help step. The guide's checks are items of kind guide_check placed in this step through item_ids; its minutes are the step estimate and its can-do lines are the entry's can_do.",
      "properties": {
        "more": {
          "type": "object",
          "required": ["label", "url"],
          "additionalProperties": false,
          "description": "One outside link for anyone who wants more, shown at the end of the guide page as a Read more card that opens in a new tab. Optional; leave it out when there is none. Not shown in the guide preview or player.",
          "properties": {
            "label": { "type": "string", "minLength": 1, "maxLength": 80, "description": "Plain English, no braces, such as Read more about silent letters." },
            "url": { "type": "string", "pattern": "^https://[^\\s\"'<>]+$", "maxLength": 500 }
          }
        },
        "line": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "The one line under the guide's title."
        },
        "parts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "heading",
              "text"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "maxLength": 60
              },
              "heading": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "text": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "description": "A paragraph; French marked with braces."
                }
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 1000
              },
              "blocks": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/GuideBlock"
                }
              }
            }
          }
        }
      }
    },
    "ReadingBody": {
      "type": "object",
      "required": [
        "story_id",
        "passage"
      ],
      "additionalProperties": false,
      "description": "Body of a reading's reading-passage step. A block with fr also has en; a block with neither has img (checked by release validation). Comprehension questions are items placed through item_ids.",
      "properties": {
        "story_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "maxLength": 60,
          "description": "The BundleStory this reading tells."
        },
        "passage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$",
                "maxLength": 60
              },
              "fr": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              },
              "speaker": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "img": {
                "type": "object",
                "required": [
                  "src",
                  "w",
                  "h",
                  "alt"
                ],
                "additionalProperties": false,
                "properties": {
                  "src": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 300
                  },
                  "w": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "h": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "alt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              },
              "layout": {
                "type": "string",
                "enum": [
                  "dateline",
                  "scene",
                  "end"
                ]
              }
            }
          }
        },
        "glossary": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "fr",
              "en"
            ],
            "additionalProperties": false,
            "properties": {
              "fr": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "en": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        },
        "preview_blocks": {
          "type": "array",
          "description": "Passage block ids shown in the free preview when the step is locked.",
          "items": {
            "type": "string",
            "maxLength": 60
          }
        }
      }
    }
  }
}
