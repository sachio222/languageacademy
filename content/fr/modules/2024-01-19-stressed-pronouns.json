  "kind": "lesson",
  "status": "written",
  "title": "Stressed Pronouns - {moi, toi, lui...}",
  "description": "Learn the special pronouns used after words like 'with', 'for', 'without' - different from subject pronouns!",
  "can_do": [
    "Use special pronouns after 'with', 'for', 'without' (avec moi, pour toi)",
    "Emphasize who you're talking about (c'est moi - it's me)",
    "Give short emphatic answers (Moi? - Me?)"
  ],
  "teaches": {
    "constructions": [
      "fr:cx:pronoun.stressed"
    ]
  },
  "vocabulary": [
    {
      "word_id": "moi-fr",
      "fr": "moi",
      "gloss": "me (stressed)",
      "note": "after prepositions"
    },
    {
      "word_id": "toi-fr",
      "fr": "toi",
      "gloss": "you (stressed, informal)",
      "note": "pour toi = for you"
    },
    {
      "word_id": "lui-fr",
      "fr": "lui",
      "gloss": "him (stressed)",
      "note": "avec lui = with him"
    },
    {
      "word_id": "elle-fr.stressed",
      "fr": "elle",
      "gloss": "her (stressed)",
      "note": "same as subject pronoun"
    },
    {
      "word_id": "nous-fr.stressed",
      "fr": "nous",
      "gloss": "us (stressed)",
      "note": "same as subject pronoun"
    },
    {
      "word_id": "vous-fr.stressed",
      "fr": "vous",
      "gloss": "you (stressed, formal/plural)",
      "note": "same as subject pronoun"
    },
    {
      "word_id": "eux-fr",
      "fr": "eux",
      "gloss": "them (stressed, masculine)",
      "note": "avec eux = with them"
    },
    {
      "word_id": "elles-fr.stressed",
      "fr": "elles",
      "gloss": "them (stressed, feminine)",
      "note": "same as subject pronoun"
    },
    {
      "word_id": "il-est-avec-moi-fr",
      "fr": "il est avec moi",
      "gloss": "he is with me"
    },
    {
      "word_id": "c-est-pour-toi-fr",
      "fr": "c'est pour toi",
      "gloss": "it's for you"
    }
  ],
  "concepts": [
    {
      "id": "c-stressed-pronouns-pronoms-toniques",
      "term": "Stressed pronouns",
      "definition": "These pronouns stand on their own, come after a word such as {avec}, or add weight to who you mean.",
      "examples": [
        {
          "fr": "avec moi",
          "en": "with me"
        },
        {
          "fr": "pour toi",
          "en": "for you"
        },
        {
          "fr": "Moi ?",
          "en": "Me?"
        }
      ]
    },
    {
      "id": "c-when-to-use-stressed",
      "term": "When to use them",
      "definition": "Use them after a word such as {avec}, after {c'est}, and on their own as a one-word answer.",
      "examples": [
        {
          "fr": "Il est avec moi.",
          "en": "He is with me."
        },
        {
          "fr": "C'est pour toi.",
          "en": "It's for you."
        },
        {
          "fr": "C'est lui.",
          "en": "It's him."
        },
        {
          "fr": "Moi ?",
          "en": "Me?"
        }
      ]
    },
    {
      "id": "c-subject-vs-stressed",
      "term": "Subject or stressed",
      "definition": "Subject pronouns go before the verb. Stressed pronouns go after a preposition.",
      "examples": [
        {
          "fr": "Je suis avec toi.",
          "en": "I am with you."
        },
        {
          "fr": "Tu es avec moi.",
          "en": "You are with me."
        }
      ]
    }
  ],
  "items": [
    {
      "id": "i-moi",
      "type": "respond",
      "situation": "What is the stressed pronoun for 'I/me'?",
      "cue": "me (stressed - after prepositions)",
      "answer": "moi",
      "hint": "Different from '{je}' - three letters",
      "mistakes": [
        {
          "answer": "je",
          "feedback": "That's subject pronoun. Use stressed form '{moi}'"
        },
        {
          "answer": "me",
          "feedback": "That's object pronoun. Use stressed form '{moi}'"
        }
      ]
    },
    {
      "id": "i-toi",
