{
  "schema": "la-module@1",
  "module_key": "2024-01-29-partir",
  "kind": "lesson",
  "status": "written",
  "title": "Essential Verb - {partir} (to leave)",
  "description": "Master departures through active recall and composition practice!",
  "can_do": [
    "Express leaving and departing (I leave, you leave, they leave)",
    "Talk about departures and travel",
    "Combine with venir and aller for complete movement vocabulary"
  ],
  "vocabulary": [
    {
      "word_id": "partir-fr",
      "fr": "partir",
      "gloss": "to leave / to depart",
      "note": "infinitive form"
    }
  ],
  "concepts": [
    {
      "id": "c-partir-to-leave-to",
      "term": "{partir} = to leave / to depart",
      "definition": "Common verb for leaving a place or departing",
      "example": "Essential for talking about travel and movement away from places"
    },
    {
      "id": "c-regular-ir-conjugation",
      "term": "The t you hear only in the plural",
      "definition": "In {je pars}, {tu pars} and {il part} you hear no t. In {ils partent}, {vous partez} and {nous partons} the t comes back and is heard.",
      "example": "{il part} (no t heard), {ils partent} (t heard)"
    },
    {
      "id": "c-composition-power",
      "term": "Composition Power",
      "definition": "{partir} slots into the verbs you know: {vouloir}, {pouvoir} and {aller} each take it straight after.",
      "example": "{je veux partir}, {tu peux partir}, {on va partir}"
    }
  ],
  "items": [
    {
      "id": "i-je-pars",
      "type": "respond",
      "situation": "Say what you do",
      "cue": "I leave",
      "answer": "je pars",
      "hint": "{je pars}",
      "mistakes": [
        {
          "answer": "je part",
          "feedback": "Je takes '{pars}', not 'part'. Remember: je pars, il part"
        },
        {
          "answer": "tu pars",
          "feedback": "That's 'you leave', not 'I leave'. Focus on the pronoun!"
        }
      ]
    },
    {
      "id": "i-tu-pars",
      "type": "respond",
      "situation": "Say what you do",
      "cue": "you leave (informal)",
      "answer": "tu pars",
      "hint": "{tu pars}",
      "mistakes": [
        {
          "answer": "tu part",
          "feedback": "Tu takes '{pars}', not 'part'. Pattern: je pars, tu pars"
        }
      ]
    },
    {
      "id": "i-il-part",
      "type": "respond",
      "situation": "Say what he does",
      "cue": "he leaves",
      "answer": "il part",
      "hint": "{il part}",
      "mistakes": [
        {
          "answer": "il pars",
          "feedback": "Il takes '{part}', not 'pars'. Remember: il part, elle part"
        }
      ]
    },
    {
      "id": "i-elle-part",
      "type": "respond",
      "situation": "Say what she does",
      "cue": "she leaves",
      "answer": "elle part",
      "hint": "{elle part}",
      "mistakes": [
        {
          "answer": "elle pars",
          "feedback": "Elle takes '{part}', not 'pars'. Same as il part"
        }
      ]
    },
    {
      "id": "i-nous-partons",
      "type": "respond",
      "situation": "Say what we do",
      "cue": "we leave",
      "answer": "nous partons",
      "hint": "{nous partons}",
      "mistakes": [
        {
          "answer": "nous pars",
          "feedback": "Nous takes '{partons}', not 'pars'. Regular ending!"
        },
        {
          "answer": "nous part",
          "feedback": "Nous takes '{partons}', not 'part'. Completely different!"
        }
      ]
    },
    {
      "id": "i-vous-partez",
      "type": "respond",
      "situation": "Say what you do (formal)",
      "cue": "you leave (formal)",
      "answer": "vous partez",
      "hint": "{vous partez}",
      "mistakes": [
        {
          "answer": "vous pars",
          "feedback": "Vous takes '{partez}', not 'pars'. Regular ending!"
        },
        {
          "answer": "vous part",
          "feedback": "Vous takes '{partez}', not 'part'. Remember: vous partez"
        }
      ]
    },
    {
      "id": "i-ils-partent",
      "type": "respond",
      "situation": "Say what they do (masculine)",
      "cue": "they leave (masculine)",
      "answer": "ils partent",
      "hint": "{ils partent}",
      "mistakes": [
        {
          "answer": "ils pars",
          "feedback": "Ils takes '{partent}', not 'pars'. Regular ending!"
        },
        {
          "answer": "ils part",
          "feedback": "Ils takes '{partent}', not 'part'. Regular ending!"
        }
      ]
    },
    {
      "id": "i-elles-partent",
      "type": "respond",
      "situation": "Say what they do (feminine)",
      "cue": "they leave (feminine)",
      "answer": "elles partent",
      "hint": "{elles partent}",
      "mistakes": [
        {
          "answer": "elles pars",
          "feedback": "Elles takes '{partent}', not 'pars'. Same as ils partent"
        },
        {
          "answer": "elles part",
          "feedback": "Elles takes '{partent}', not 'part'. Regular ending!"
        }
      ]
    },
    {
      "id": "i-je-pars-avec-toi",
      "type": "respond",
      "hint": "{je pars + de ça}",
      "situation": "Your friend asks if you are coming to the café. You are leaving, and you want her to come too.",
      "cue": "I'm leaving with you",
      "answer": "je pars avec toi",
      "mistakes": [
        {
          "answer": "je part avec toi",
          "feedback": "With {je} it is {pars}, with an s you do not hear."
        }
      ]
    },
    {
      "id": "i-quand-tu-pars",
      "type": "respond",
      "hint": "{qu'est-ce que tu pars}",
      "situation": "Your friend has her coat on. Ask her when she is leaving.",
      "cue": "When are you leaving?",
      "answer": "quand est-ce que tu pars ?",
      "accept": [
        "quand pars-tu ?",
        "tu pars quand ?"
      ],
      "mistakes": [
        {
          "answer": "quand est-ce que tu part ?",
          "feedback": "With {tu} it is {pars}, like {je pars}."
        }
      ]
    },
    {
      "id": "i-il-part-avec-elle",
      "type": "respond",
      "hint": "{il part + de ça}",
      "situation": "Someone asks where your brother is. He is leaving with your sister.",
      "cue": "He's leaving with her",
      "answer": "il part avec elle",
      "mistakes": [
        {
          "answer": "il pars avec elle",
          "feedback": "With {il} it is {part}, ending in a t you do not hear."
        }
      ]
    },
    {
      "id": "i-nous-partons-en-normandie",
      "type": "respond",
      "hint": "{nous partons + de ça}",
      "situation": "A neighbour asks about your weekend plans. Your family is going to Normandy.",
      "cue": "We're leaving for Normandy",
      "answer": "nous partons en Normandie",
      "accept": [
        "on part en Normandie"
      ],
      "mistakes": [
        {
          "answer": "nous pars en Normandie",
          "feedback": "With {nous} it is {partons}: the t comes back."
        }
      ]
    },
    {
      "id": "i-pourquoi-tu-veux-partir",
      "type": "respond",
      "hint": "{qu'est-ce que tu veux partir}",
      "situation": "Your friend says she does not like the party. Ask her why she wants to leave.",
      "cue": "Why do you want to leave?",
      "answer": "pourquoi est-ce que tu veux partir ?",
      "accept": [
        "pourquoi veux-tu partir ?",
        "pourquoi tu veux partir ?",
        "tu veux partir pourquoi ?"
      ],
      "mistakes": [
        {
          "answer": "pourquoi est-ce que tu veux pars ?",
          "feedback": "After {veux}, the verb stays whole: {partir}."
        }
      ]
    },
    {
      "id": "i-je-veux-partir",
      "type": "respond",
      "hint": "{je veux partir + de ça}",
