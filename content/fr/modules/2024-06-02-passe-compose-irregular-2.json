  "concepts": [
    {
      "id": "c-modal-verbs-with-u",
      "term": "Participles in -u",
      "definition": "{vouloir} gives {voulu} and {pouvoir} gives {pu}. {devoir} gives {dû}, with an accent.",
      "examples": [
        {
          "fr": "J'ai voulu partir, mais je n'ai pas pu.",
          "en": "I wanted to leave, but I couldn't."
        },
        {
          "fr": "Tu as pu venir ?",
          "en": "Were you able to come?"
        },
        {
          "fr": "Elle a dû travailler hier.",
          "en": "She had to work yesterday."
        }
      ]
    },
    {
      "id": "c-dire-dit-said",
      "term": "{dire}: {j'ai dit}",
      "definition": "The participle of {dire} is {dit}.",
      "examples": [
        {
          "fr": "J'ai dit oui.",
          "en": "I said yes."
        },
        {
          "fr": "Qu'est-ce que tu as dit ?",
          "en": "What did you say?"
        },
        {
          "fr": "On a dit non.",
          "en": "We said no."
        }
      ]
    },
    {
      "id": "c-prendre-family-is-ending",
      "term": "{prendre} and its family: -is",
      "definition": "{prendre} gives {pris}, and the verbs built on it end the same way.",
      "examples": [
        {
          "fr": "J'ai pris le bus.",
          "en": "I took the bus.",
          "note": "from {prendre}"
        },
        {
          "fr": "Vous avez compris ?",
          "en": "Did you understand?",
          "note": "from {comprendre}"
        },
        {
          "fr": "On a appris le français.",
          "en": "We learned French.",
          "note": "from {apprendre}"
        }
      ]
    },
    {
      "id": "c-mettre-mis-put",
      "term": "{mettre}: {j'ai mis}",
      "definition": "The participle of {mettre} is {mis}.",
      "examples": [
        {
          "fr": "J'ai mis mon manteau.",
          "en": "I put on my coat."
        },
        {
          "fr": "Nous avons mis nos livres sur la table.",
          "en": "We put our books on the table."
        },
        {
          "fr": "J'ai mis ça là.",
          "en": "I put that there."
        }
      ]
    },
    {
      "id": "c-modal-verbs-infinitive-in",
      "term": "Wanted to, could, had to",
      "definition": "After these participles, the second verb stays in the infinitive.",
      "examples": [
        {
          "fr": "J'ai voulu aller au cinéma, mais je n'ai pas eu le temps.",
          "en": "I wanted to go to the cinema, but I didn't have time."
        },
        {
          "fr": "J'ai pu venir.",
          "en": "I was able to come."
        },
        {
          "fr": "Elle a dû partir tôt.",
          "en": "She had to leave early."
        }
      ]
    },
    {
      "id": "c-all-use-avoir-as",
      "term": "All of these take {avoir}",
      "definition": "Like most verbs, these make their past with {avoir}.",
      "examples": [
        {
          "fr": "j'ai voulu",
          "en": "I wanted"
        },
        {
          "fr": "j'ai pu",
          "en": "I could"
        },
        {
          "fr": "j'ai dû",
          "en": "I had to"
        },
        {
          "fr": "j'ai dit",
          "en": "I said"
        },
        {
          "fr": "j'ai pris",
          "en": "I took"
        },
        {
          "fr": "j'ai mis",
          "en": "I put"
        }
      ]
    }
  ],
