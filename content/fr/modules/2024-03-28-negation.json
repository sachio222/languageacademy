      "fr": "je ne suis pas",
      "gloss": "I am not",
      "note": "être negated"
    },
    {
      "word_id": "je-n-ai-pas-fr",
      "fr": "je n'ai pas",
      "gloss": "I don't have",
      "note": "avoir negated"
    },
    {
      "word_id": "je-ne-veux-pas-fr",
      "fr": "je ne veux pas",
      "gloss": "I don't want",
      "note": "vouloir negated"
    },
    {
      "word_id": "je-ne-fais-pas-fr",
      "fr": "je ne fais pas",
      "gloss": "I don't do/make",
      "note": "faire negated"
    },
    {
