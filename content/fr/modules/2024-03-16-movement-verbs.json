  "concepts": [
    {
      "id": "c-six-essential-movement-verbs",
      "term": "Six Essential Movement Verbs",
      "definition": "These verbs describe all basic types of movement in nature and daily life",
      "example": "{nager} (swim), {sauter} (jump), {voler} (fly), {courir} (run), {marcher} (walk), {grimper} (climb)"
    },
    {
      "id": "c-regular-er-verbs-pattern",
      "term": "Regular -ER Verbs Pattern",
      "definition": "Most movement verbs follow the regular -ER pattern you already know",
      "example": "{nager}: {je nage}, {tu nages}, {il nage}, {nous nageons}, {vous nagez}, {ils nagent}"
    },
    {
      "id": "c-courir-irregular-ir-verb",
      "term": "{courir} - Irregular -IR Verb",
      "definition": "Courir (to run) is irregular but common - memorize the pattern",
      "example": "{je cours}, {tu cours}, {il court}, {nous courons}, {vous courez}, {ils courent}"
    },
    {
      "id": "c-animals-movement",
      "term": "Animals + Movement",
      "definition": "Combine with animal vocabulary to describe how animals move",
      "example": "{La tortue nage} (the turtle swims), {Les oiseaux volent} (birds fly), {L'écureuil saute} (the squirrel jumps)"
    },
    {
      "id": "c-works-in-all-tenses",
      "term": "Works in All Tenses",
      "definition": "These verbs work in every tense you know. The table below shows the present, the passé composé and the imparfait.",
      "example": "{Je nage} (I swim), {J'ai nagé} (I swam), {Je nageais} (I was swimming, I used to swim)"
    },
    {
      "id": "c-savoir-infinitive",
      "term": "{savoir} + infinitive: know how to",
      "definition": "Use {savoir} with an infinitive for a skill someone has learned, and {pouvoir} for whether they are able to at that moment.",
      "example": "{Je sais nager.} (I can swim, I know how.) {Les petits oiseaux ne savent pas encore voler.} (Baby birds can't fly yet.)"
    }
  ],
