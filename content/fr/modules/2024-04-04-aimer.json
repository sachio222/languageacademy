{
  "schema": "la-module@1",
  "module_key": "2024-04-04-aimer",
  "kind": "lesson",
  "status": "written",
  "title": "{aimer} - To Like / To Love",
  "description": "Express what you like and love: j'aime le café (I like coffee), j'aime bien (I like), je t'aime (I love you)",
  "can_do": [
    "Express what you like and love (I like coffee, I love you)",
    "Distinguish between liking and loving in French",
    "Use aimer with object pronouns (I love him/her)"
  ],
  "teaches": {
    "constructions": [
      "fr:cx:frame.aimer-infinitive"
    ]
  },
  "vocabulary": [
    {
      "word_id": "aimer-fr",
      "fr": "aimer",
      "gloss": "to like / to love",
      "note": "infinitive form - regular -ER verb"
    },
    {
      "word_id": "j-aime-fr",
      "fr": "j'aime",
      "gloss": "I like / I love",
      "note": "j' before vowel"
    },
    {
      "word_id": "tu-aimes-fr",
      "fr": "tu aimes",
      "gloss": "you like / you love (informal)",
      "note": "regular -ER ending: -es"
    },
    {
      "word_id": "il-elle-aime-fr",
      "fr": "il/elle aime",
      "gloss": "he/she likes / loves",
      "note": "regular -ER ending: -e"
    },
    {
      "word_id": "nous-aimons-fr",
      "fr": "nous aimons",
      "gloss": "we like / we love",
      "note": "regular -ER ending: -ons"
    },
    {
      "word_id": "vous-aimez-fr",
      "fr": "vous aimez",
      "gloss": "you like / you love (formal/plural)",
      "note": "regular -ER ending: -ez"
    },
    {
      "word_id": "ils-elles-aiment-fr",
      "fr": "ils/elles aiment",
      "gloss": "they like / they love",
      "note": "regular -ER ending: -ent (silent)"
    },
    {
      "word_id": "aimer-bien-fr",
      "fr": "aimer bien",
      "gloss": "to like (casual)",
      "note": "less intense than aimer alone"
    },
    {
      "word_id": "je-t-aime-fr",
      "fr": "je t'aime",
      "gloss": "I love you",
      "note": "❤️ famous phrase!"
    },
    {
      "word_id": "j-aime-ma-mere-fr",
      "fr": "j'aime ma mère",
      "gloss": "I love my mother"
    }
  ],
  "concepts": [
    {
      "id": "c-aimer-to-like-or",
      "term": "{aimer} = to like OR to love",
      "definition": "Context determines meaning - can mean both 'like' and 'love'",
      "example": "{j'aime le café} (I like coffee), {j'aime ma mère} (I love my mother)"
    },
    {
      "id": "c-aimer-bien-to-like",
      "term": "{aimer bien} = to like (casual)",
      "definition": "Adding '{bien}' makes it clearly 'like' not 'love' - less intense",
      "example": "{j'aime bien ce livre} (I like this book)"
    },
    {
      "id": "c-regular-er-verb-pattern",
      "term": "Regular -ER verb pattern",
      "definition": "Follows same pattern as parler - drop -er, add endings",
      "example": "{je parle} → {j'aime}, {tu parles} → {tu aimes}, {il parle} → {il aime}"
    },
    {
      "id": "c-with-people-vs-things",
      "term": "With people vs things",
      "definition": "With people often means 'love', with things means 'like'",
      "example": "{j'aime Pierre} (I love Pierre), {j'aime le pain} (I like bread)"
    },
    {
      "id": "c-with-infinitives",
      "term": "With infinitives",
      "definition": "Use aimer + infinitive to say you like doing something",
      "example": "{j'aime parler français} (I like speaking French)"
    }
  ],
