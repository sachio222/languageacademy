  "kind": "guide",
  "status": "written",
  "title": "Cognates",
  "description": "Discover words that are almost the same in English and French",
  "can_do": [
    "Recognize French words that look like English ones, such as {un restaurant} and {une idée}.",
    "Say them the French way, with {un} or {une} in front."
  ],
  "minutes": 4,
  "line": "French words you can already read, and how French says them.",
  "parts": [
    {
      "id": "p-words-you-may-know",
      "heading": "Words you may know already",
      "text": [
        "A cognate is a word that looks and sounds alike in two languages because both come from the same older word. English took thousands of words from French after the Norman Conquest in 1066."
      ],
      "note": "Over 30% of English words come from French or Latin, so you already know more French words than you think."
    },
    {
      "id": "p-spelled-exactly-the-same",
      "heading": "Spelled exactly the same",
      "text": [
        "These words are spelled the same in both languages. Tap each one: the spelling matches, the sound does not."
      ],
      "blocks": [
        {
          "pairs": [
            [
              "un restaurant",
              "restaurant"
            ],
            [
              "un garage",
              "garage"
            ],
            [
              "une station",
              "station"
            ],
            [
              "une radio",
              "radio"
            ],
            [
