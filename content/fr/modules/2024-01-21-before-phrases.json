  "title": "{Avant que...} - Before Phrases",
  "description": "Talk about timing! '{Avant que tu partes}' (Before you leave), '{Appelle-moi avant qu'il arrive}' (Call me before he arrives). Sequence your actions!",
  "teaches": {
    "constructions": [
      "fr:cx:subj.avant-que"
    ]
  },
  "vocabulary": [
    {
      "word_id": "avant-que-tu-partes-fr",
      "fr": "avant que tu partes",
      "gloss": "before you leave",
      "note": "⭐ very common!"
    },
    {
      "word_id": "avant-qu-il-arrive-fr",
      "fr": "avant qu'il arrive",
      "gloss": "before he arrives",
      "note": "timing coordination"
    },
    {
      "word_id": "avant-qu-elle-vienne-fr",
      "fr": "avant qu'elle vienne",
      "gloss": "before she comes",
      "note": "expecting someone"
    },
    {
      "word_id": "avant-qu-on-parte-fr",
      "fr": "avant qu'on parte",
      "gloss": "before we leave",
      "note": "group departure"
