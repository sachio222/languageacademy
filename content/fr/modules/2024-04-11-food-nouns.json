  "concepts": [
    {
      "id": "c-food-genders-learn-the",
      "term": "Food Genders - Learn the article!",
      "definition": "Always learn food nouns with their article - gender matters!",
      "example": "{le pain} (masculine), {la viande} (feminine), {l'eau} (feminine)"
    },
    {
      "id": "c-using-partitive-articles",
      "term": "Using Partitive Articles",
      "definition": "With food, use du/de la/des for 'some' - je veux du pain (I want some bread)",
      "example": "{je veux du café} (some coffee), {de la viande} (some meat), {des légumes} (some vegetables)"
    },
    {
      "id": "c-at-the-restaurant",
      "term": "At the Restaurant",
      "definition": "These are the foods you'll see and order every day!",
      "example": "{je voudrais du pain, s'il vous plaît} (I would like some bread, please)"
    },
    {
      "id": "c-with-aimer",
      "term": "With aimer",
      "definition": "Use definite article (le/la/les) with aimer - j'aime le pain (I like bread)",
      "example": "{j'aime le café} (I like coffee), {j'aime la viande} (I like meat)"
    }
  ],
