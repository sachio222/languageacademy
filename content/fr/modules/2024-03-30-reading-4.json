    {
      "id": "b-oui-je-viens-toujours",
      "speaker": "Paul",
      "fr": "Oui ! Je viens toujours ici. Je ne vais jamais aux autres cafés. Ce café est le meilleur !",
      "en": "Yes! I always come here. I never go to the other cafés. This café is the best!"
    },
    {
      "id": "b-tu-parles-bien-francais",
      "speaker": "Marie",
      "fr": "Tu parles bien français, Paul. Moi, je ne parle pas toujours bien.",
      "en": "You speak French well, Paul. Me, I don't always speak well."
