{
  "schema": "la-module@1",
  "module_key": "2024-04-05-avoir-past",
  "kind": "lesson",
  "status": "written",
  "title": "{avoir} - Past Tense (had)",
  "description": "Talk about what you had in the past: j'avais (I had), tu avais (you had), il avait (he had)",
  "can_do": [
    "Express past possession (I had, you had, they had)",
    "Describe what you possessed in the past",
    "Combine with être past to tell complete stories"
  ],
  "vocabulary": [
    {
      "word_id": "j-avais-fr",
      "fr": "j'avais",
      "gloss": "I had",
      "note": "imperfect tense"
    },
    {
      "word_id": "tu-avais-fr",
      "fr": "tu avais",
      "gloss": "you had (informal)",
      "note": "sounds same as j'avais"
    },
    {
      "word_id": "il-elle-avait-fr",
      "fr": "il/elle avait",
      "gloss": "he/she had",
      "note": "slightly different pronunciation"
    },
    {
      "word_id": "nous-avions-fr",
      "fr": "nous avions",
      "gloss": "we had",
      "note": "imperfect tense"
    },
    {
      "word_id": "vous-aviez-fr",
      "fr": "vous aviez",
      "gloss": "you had (formal/plural)",
      "note": "imperfect tense"
    },
    {
      "word_id": "ils-elles-avaient-fr",
      "fr": "ils/elles avaient",
      "gloss": "they had",
      "note": "sounds like 'avè'"
    },
    {
      "word_id": "avoir-faim-fr",
      "fr": "avoir faim",
      "gloss": "to be hungry",
      "note": "literally 'to have hunger'"
    },
    {
      "word_id": "avoir-raison-fr",
      "fr": "avoir raison",
      "gloss": "to be right",
      "note": "literally 'to have reason'"
    }
  ],
  "concepts": [
    {
      "id": "c-past-tense-imperfect-imparfait",
      "term": "Past Tense = Imperfect (Imparfait)",
      "definition": "Describes what you possessed or experienced in the past",
      "example": "{j'avais un chat} (I had a cat), {nous avions une maison} (we had a house)"
    },
    {
      "id": "c-avais-had-singular",
      "term": "{avais} = had (singular)",
      "definition": "For je, tu - describing past possession",
      "example": "{j'avais un livre} (I had a book), {tu avais raison} (you were right - literally 'had reason')"
    },
    {
      "id": "c-avait-had-third-person",
      "term": "{avait} = had (third person singular)",
      "definition": "For il/elle - describing what he/she/it had",
      "example": "{il avait un chien} (he had a dog), {elle avait le temps} (she had time)"
    },
    {
      "id": "c-avions-aviez-avaient-had",
      "term": "{avions, aviez, avaient} = had (plural)",
      "definition": "For nous, vous, ils/elles - plural past possession",
      "example": "{nous avions une voiture} (we had a car), {ils avaient faim} (they were hungry)"
    },
    {
      "id": "c-common-expressions-with-avoir",
      "term": "Common expressions with avoir",
      "definition": "Many French expressions use avoir (not être!): avoir faim (to be hungry), avoir raison (to be right)",
      "example": "{j'avais faim} (I was hungry), {tu avais raison} (you were right)"
    }
  ],
