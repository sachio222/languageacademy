{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "la-module@1/guide",
  "description": "A written guide module (la-module@1), status written and no plan. Generated from scripts/content/schema/ by pnpm pipeline module-schemas --write; do not edit.",
  "type": "object",
  "required": [
    "schema",
    "module_key",
    "kind",
    "status",
    "title",
    "description",
    "minutes",
    "line",
    "parts",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "la-module@1"
    },
    "module_key": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}-)?[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "kind": {
      "const": "guide"
    },
    "status": {
      "const": "written"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "can_do": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "teaches": {
      "type": "object",
      "required": [
        "constructions"
      ],
      "properties": {
        "constructions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "words": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "object",
      "required": [
        "constructions"
      ],
      "properties": {
        "constructions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "additionalProperties": false
    },
    "short_title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "minutes": {
      "type": "integer",
      "minimum": 1
    },
    "line": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "heading",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "heading": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "text": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "blocks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/block"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "ask",
          "options",
          "why"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "ask": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "say": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "sound": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "show": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "options": {
            "$ref": "#/$defs/options"
          },
          "why": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "block": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "pairs"
          ],
          "properties": {
            "pairs": true,
            "heading": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "ties"
          ],
          "properties": {
            "ties": true,
            "heading": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "cmp"
          ],
          "properties": {
            "cmp": true,
            "heading": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "build"
          ],
          "properties": {
            "build": true,
            "heading": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "rise"
          ],
          "properties": {
            "rise": true,
            "heading": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "flip"
          ],
          "properties": {
            "flip": true,
            "heading": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "ways"
          ],
          "properties": {
            "ways": true,
            "heading": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "verbs"
          ],
          "properties": {
            "verbs": true,
            "heading": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "table"
          ],
          "properties": {
            "table": true,
            "heading": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "list"
          ],
          "properties": {
            "list": true,
            "heading": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "lines"
          ],
          "properties": {
            "lines": true,
            "heading": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "fr": {
            "type": "boolean"
          },
          "right": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
