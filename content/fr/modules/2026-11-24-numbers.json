  "concepts": [
    {
      "id": "c-0-to-16",
      "term": "0 to 16",
      "definition": "Each number up to 16 has its own word. Learn these by heart.",
      "example": "{zéro}, {un}, {deux}, {trois}, {quatre}, {cinq}, {six}, {sept}, {huit}, {neuf}, {dix}, {onze}, {douze}, {treize}, {quatorze}, {quinze}, {seize}"
    },
    {
      "id": "c-17-to-19",
      "term": "17 to 19",
      "definition": "Say ten, then the number: 17 is ten-seven.",
      "example": "{dix-sept} (17), {dix-huit} (18), {dix-neuf} (19)"
    },
    {
      "id": "c-tens-up-to-60",
      "term": "Tens up to 60",
      "definition": "Learn the tens, then add the numbers 1 to 9 after them.",
      "example": "{vingt} (20), {trente} (30), {quarante} (40), {cinquante} (50), {soixante} (60)"
    },
    {
      "id": "c-21-31-41-51",
      "term": "21, 31, 41, 51 and 61",
      "definition": "Put '{et}' between the ten and '{un}'. From 2 to 9, join them with a hyphen. Before a feminine noun, 'un' becomes '{une}', as in '{une voiture}'.",
      "example": "{vingt et un} (21), {vingt-deux} (22), {trente et un} (31), {quarante-cinq} (45), {cinquante et une voitures} (51)"
    },
    {
      "id": "c-70-to-79",
      "term": "70 to 79",
      "definition": "French says 70 as sixty-ten, then counts on with 11 to 19: sixty-eleven, sixty-twelve, up to sixty-nineteen. 71 keeps '{et}': '{soixante et onze}'.",
      "example": "{soixante-dix} (70), {soixante et onze} (71), {soixante-douze} (72), {soixante-quinze} (75), {soixante-dix-neuf} (79)"
    },
    {
      "id": "c-80-to-100",
      "term": "80 to 100",
      "definition": "80 is four twenties, with an s. From 81 on, the s goes and there is no '{et}'. 90 to 99 add 10 to 19 to four twenties. 100 is '{cent}'.",
      "example": "{quatre-vingts} (80), {quatre-vingt-un} (81), {quatre-vingt-cinq} (85), {quatre-vingt-dix} (90), {quatre-vingt-onze} (91), {quatre-vingt-dix-neuf} (99), {cent} (100)"
    },
    {
      "id": "c-age-uses-avoir",
      "term": "Age uses avoir",
      "definition": "To give an age, French says you have that many years: '{avoir}', the number, then '{ans}'.",
      "example": "J'ai vingt ans. Paul a trente et un ans. La maison a cent ans."
    },
    {
      "id": "c-more-numbers-in-the",
      "term": "More numbers in the Reference section",
      "definition": "The Numbers page in the Reference section lists 200, 1,000 and more, and the words Belgium and Switzerland use for 70 and 90. Open it whenever you need a number.",
      "example": "{deux cents} (200), {mille} (1,000)"
    }
  ],
