  "concepts": [
    {
      "id": "c-donner-to-give",
      "term": "{donner} = to give",
      "definition": "Very common verb for giving things, offering help, providing information",
      "example": "{je donne le livre} (I give the book), {tu donnes ton nom} (you give your name)"
    },
    {
      "id": "c-regular-er-conjugation",
      "term": "Regular -er conjugation",
      "definition": "Present tense: je donne, tu donnes, il donne, nous donnons, vous donnez, ils donnent",
      "example": "Regular pattern: donn- + endings (-e, -{es}, -e, -ons, -ez, -ent)"
    },
    {
      "id": "c-common-uses-of-donner",
      "term": "Common uses of donner",
      "definition": "Giving objects (donner un cadeau), giving information (donner l'adresse), giving help (donner de l'aide)",
      "example": "{je donne mon numéro} (I give my number), {ça donne faim} (it makes you hungry)"
    },
    {
      "id": "c-donner-vs-prendre",
      "term": "Donner vs Prendre",
      "definition": "Perfect opposites - donner (to give) and prendre (to take)",
      "example": "{je donne le livre à Marie, elle prend le livre} (I give the book to Marie, she takes the book)"
    },
    {
      "id": "c-with-prepositions",
      "term": "With prepositions",
      "definition": "Often used with 'à' (to) - donner quelque chose à quelqu'un",
      "example": "{je donne le livre à mon ami} (I give the book to my friend)"
    },
    {
      "id": "c-ne-rien",
      "term": "{ne … rien}: nothing",
      "definition": "{rien} takes the place of {pas}: {ne} goes before the verb and {rien} after it.",
      "example": "{Il ne donne rien.} (He doesn't give anything.), {Je ne vois rien.} (I don't see anything.)"
    }
  ],
