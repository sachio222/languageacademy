{
  "schema": "la-module@1",
  "module_key": "2024-05-01-croire",
  "kind": "lesson",
  "status": "written",
  "title": "{croire} - To Believe",
  "description": "Express belief and softer opinions: je crois que oui (I believe so), tu crois? (do you believe it?)",
  "can_do": [
    "Express beliefs and tentative opinions (I believe that...)",
    "Sound more tentative than penser (I think)",
    "Use croire with que for softer assertions"
  ],
  "teaches": {
    "constructions": [
      "fr:cx:frame.verb-que-clause"
    ]
  },
  "vocabulary": [
    {
      "word_id": "croire-fr",
      "fr": "croire",
      "gloss": "to believe / to think",
      "note": "infinitive - irregular verb"
    },
    {
      "word_id": "je-crois-fr",
      "fr": "je crois",
      "gloss": "I believe / I think",
      "note": "pronounced 'krwa'"
    },
    {
      "word_id": "tu-crois-fr",
      "fr": "tu crois",
      "gloss": "you believe (informal)",
      "note": "same sound as je crois"
    },
    {
      "word_id": "il-elle-croit-fr",
      "fr": "il/elle croit",
      "gloss": "he/she believes",
      "note": "same sound, different spelling"
    },
    {
      "word_id": "nous-croyons-fr",
      "fr": "nous croyons",
      "gloss": "we believe",
      "note": "pronounced 'krwa-yon' with y sound"
    },
    {
      "word_id": "vous-croyez-fr",
      "fr": "vous croyez",
      "gloss": "you believe (formal/plural)",
      "note": "pronounced 'krwa-yay' with y sound"
    },
    {
      "word_id": "ils-elles-croient-fr",
      "fr": "ils/elles croient",
      "gloss": "they believe",
      "note": "pronounced 'krwa' (silent -ent)"
    },
    {
      "word_id": "je-crois-que-oui-fr",
      "fr": "je crois que oui",
      "gloss": "I believe so / I think so",
      "note": "⭐ softer than '{je pense que oui}'"
    },
    {
      "word_id": "je-ne-crois-pas-fr",
      "fr": "je ne crois pas",
      "gloss": "I don't believe so / I don't think so",
      "note": "common negative response"
    },
    {
      "word_id": "tu-crois-fr.question",
      "fr": "Tu crois?",
      "gloss": "Do you think so? / Do you believe it?",
      "note": "asking for opinion/belief"
    }
  ],
  "concepts": [
    {
      "id": "c-croire-to-believe-to",
      "term": "{croire} = to believe, to think",
      "definition": "Like {penser}, but less sure. It also means to believe someone.",
      "examples": [
        {
          "fr": "Je crois que c'est vrai.",
          "en": "I believe it's true."
        },
        {
          "fr": "Tu crois ?",
          "en": "Do you think so?"
        },
        {
          "fr": "Je te crois.",
          "en": "I believe you."
        }
      ]
    },
    {
      "id": "c-irregular-conjugation",
      "term": "The forms of {croire}",
      "definition": "The three singular forms sound the same. The forms for we and you take a y.",
      "layout": "forms",
      "examples": [
        {
          "fr": "je crois",
          "en": "I believe"
        },
        {
          "fr": "tu crois",
          "en": "you believe"
        },
        {
          "fr": "il croit",
          "en": "he believes"
        },
        {
          "fr": "nous croyons",
          "en": "we believe"
        },
        {
          "fr": "vous croyez",
          "en": "you believe"
        },
        {
          "fr": "ils croient",
          "en": "they believe"
        }
      ]
    },
    {
      "id": "c-croire-que-to-believe",
      "term": "{croire que} = to believe that",
      "definition": "Put {que} before what you believe, as with {penser}.",
      "examples": [
        {
          "fr": "Je crois que oui.",
          "en": "I think so."
        },
        {
          "fr": "Je ne crois pas.",
          "en": "I don't think so."
        }
      ]
    },
    {
      "id": "c-croire-a-croire-en",
      "term": "{croire en}, {croire à} = to believe in",
      "definition": "Use {en} for a person you trust, and {à} for an idea or a thing.",
      "examples": [
        {
          "fr": "Je crois en toi.",
          "en": "I believe in you."
        },
        {
          "fr": "Je crois à ça.",
          "en": "I believe in that."
        }
      ]
    },
    {
      "id": "c-penser-vs-croire",
      "term": "{penser} or {croire}",
      "definition": "{je pense} sounds more sure. {je crois} leaves more room for doubt.",
      "examples": [
        {
          "fr": "Je pense qu'il vient.",
          "en": "I think he's coming.",
          "note": "fairly sure"
        },
        {
          "fr": "Je crois qu'il vient.",
          "en": "I believe he's coming.",
          "note": "less sure"
        }
      ]
    }
  ],
  "tables": [
