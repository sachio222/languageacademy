{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "la-module@1/practice",
  "description": "A written practice module (la-module@1), status written and no plan. Generated from scripts/content/schema/ by pnpm pipeline module-schemas --write; do not edit.",
  "type": "object",
  "required": [
    "schema",
    "module_key",
    "kind",
    "status",
    "title",
    "description",
    "items",
    "tests"
  ],
  "properties": {
    "schema": {
      "const": "la-module@1"
    },
    "module_key": {
      "type": "string",
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2}-)?[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "kind": {
      "const": "practice"
    },
    "status": {
      "const": "written"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "can_do": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "teaches": {
      "type": "object",
      "required": [
        "constructions"
      ],
      "properties": {
        "constructions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "maxItems": 0
        },
        "words": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "maxItems": 0
        }
      },
      "additionalProperties": false
    },
    "tests": {
      "type": "object",
      "required": [
        "constructions"
      ],
      "properties": {
        "constructions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "additionalProperties": false
    },
    "items": {
      "$ref": "#/$defs/items"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "item_choice": {
      "type": "object",
      "required": [
        "id",
        "type",
        "question",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "type": {
          "const": "choice"
        },
        "hint": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "mistakes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "answer",
              "feedback"
            ],
            "properties": {
              "answer": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "feedback": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "additionalProperties": false
          }
        },
        "word_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "options": {
          "$ref": "#/$defs/options"
        }
      },
      "additionalProperties": false
    },
    "item_gapfill": {
      "type": "object",
      "required": [
        "id",
        "type",
        "text",
        "blanks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "type": {
          "const": "gapfill"
        },
        "hint": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "mistakes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "answer",
              "feedback"
            ],
            "properties": {
              "answer": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "feedback": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "additionalProperties": false
          }
        },
        "word_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "blanks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "answer"
            ],
            "properties": {
              "answer": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "accept": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "gloss": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": false
    },
    "item_transform": {
      "type": "object",
      "required": [
        "id",
        "type",
        "instruction",
        "shown",
        "answer"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "type": {
          "const": "transform"
        },
        "hint": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "mistakes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "answer",
              "feedback"
            ],
            "properties": {
              "answer": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "feedback": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "additionalProperties": false
          }
        },
        "word_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "shown": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "accept": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/item_transform"
          },
          {
            "$ref": "#/$defs/item_gapfill"
          },
          {
            "$ref": "#/$defs/item_choice"
          }
        ]
      }
    },
    "options": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "fr": {
            "type": "boolean"
          },
          "right": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
