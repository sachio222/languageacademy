  "title": "Negation - {ne...pas} (not)",
  "description": "Say what you DON'T want, DON'T have, or DON'T do! Simple pattern: wrap your verb with ne...pas.",
  "can_do": [
    "Say what you don't do, don't have, or don't want",
    "Negate any French sentence with ne...pas",
    "Express disagreement and refusal politely"
  ],
  "vocabulary": [
    {
      "word_id": "ne-pas-fr",
      "fr": "ne...pas",
      "gloss": "not",
      "note": "wraps around verb"
    },
    {
