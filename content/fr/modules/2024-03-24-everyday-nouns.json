        "l'addition s'il vous plaît",
        "l'addition s il vous plait"
      ],
      "hint": "l'addition + s'il vous plaît (formal please!)",
      "mistakes": [
        {
          "answer": "l'addition, s'il te plaît",
          "feedback": "Use formal '{s'il vous plaît}' when asking for the bill in a restaurant"
        }
      ]
    },
    {
      "id": "i-je-vois-quelqu-un",
      "type": "respond",
      "situation": "I see someone",
      "answer": "je vois quelqu'un",
      "hint": "{je vois + quelqu'un}",
      "mistakes": [
        {
