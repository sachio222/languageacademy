  "concepts": [
    {
      "id": "c-comment-est-ce-que",
      "term": "comment est-ce que + [subject] + [verb]",
      "definition": "Pattern for asking how something does something - subject does the action",
      "example": "{Comment est-ce qu'une tortue nage? Comment est-ce qu'un oiseau vole?}"
    },
    {
      "id": "c-animals-movement-questions",
      "term": "Animals + Movement Questions",
      "definition": "Perfect for asking how animals perform their characteristic movements",
      "example": "{Comment est-ce qu'un lapin saute? Comment est-ce qu'un poisson nage?}"
    },
    {
      "id": "c-natural-process-questions",
      "term": "Natural Process Questions",
      "definition": "Ask how natural phenomena occur",
      "example": "{Comment est-ce que les plantes poussent? Comment est-ce que le soleil brille?}"
    },
    {
      "id": "c-people-questions",
      "term": "People Questions",
      "definition": "Ask how people do things - very practical!",
      "example": "{Comment est-ce qu'on fait ça? Comment est-ce que tu fais ça? Comment est-ce qu'il court si vite?}"
    },
    {
      "id": "c-formal-inversion-introduction",
      "term": "Formal Inversion (Introduction)",
      "definition": "In formal French, you can invert subject-verb: Comment nage une tortue?",
      "example": "Informal: Comment est-ce qu'une tortue nage? Formal: {Comment nage une tortue?}"
    }
  ],
