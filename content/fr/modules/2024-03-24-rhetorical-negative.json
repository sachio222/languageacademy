      "accept": [
        "n'as-tu pas faim"
      ],
      "mistakes": [
        {
          "answer": "n'as pas-tu faim ?",
          "feedback": "{pas} comes after the inverted pair: {n'as-tu pas}."
        }
      ]
    },
    {
      "id": "i-ne-veux-tu-pas",
      "type": "transform",
      "instruction": "Ask it with inversion.",
