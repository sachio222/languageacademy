  "concepts": [
    {
      "id": "c-imperative-mood-commands",
      "term": "Telling someone to do something",
      "definition": "A command has no subject pronoun. The verb starts the sentence.",
      "examples": [
        {
          "fr": "Mange !",
          "en": "Eat!"
        },
        {
          "fr": "Parle !",
          "en": "Speak!"
        },
        {
          "fr": "Pars tôt !",
          "en": "Leave early!"
        }
      ]
    },
    {
      "id": "c-tu-form-just-drop",
      "term": "The {tu} form without {tu}",
      "definition": "For most verbs, a command to a friend is the {tu} form with no pronoun.",
      "examples": [
        {
          "fr": "Viens !",
          "en": "Come!",
          "note": "from {tu viens}"
        },
        {
          "fr": "Prends !",
          "en": "Take it!",
          "note": "from {tu prends}"
        },
        {
          "fr": "Pars !",
          "en": "Leave!",
          "note": "from {tu pars}"
        }
      ]
    },
    {
      "id": "c-er-verbs-drop-the",
      "term": "-er verbs drop the s",
      "definition": "For -er verbs, the command also drops the final s of the {tu} form.",
      "examples": [
        {
          "fr": "Mange !",
          "en": "Eat!",
          "note": "from {tu manges}"
        },
        {
          "fr": "Parle !",
          "en": "Speak!",
          "note": "from {tu parles}"
        },
        {
          "fr": "Pense !",
          "en": "Think!",
          "note": "from {tu penses}"
        }
      ]
    },
    {
      "id": "c-use-with-friends-and",
      "term": "For friends and family",
      "definition": "Use these commands with people you call {tu}.",
      "examples": [
        {
          "fr": "Écoute !",
          "en": "Listen!"
        },
        {
          "fr": "Regarde !",
          "en": "Look!"
        },
        {
          "fr": "Viens, on est en retard !",
          "en": "Come on, we're late!"
        }
      ]
    }
  ],
  "items": [
    {
      "id": "commands-tu-1",
      "type": "respond",
      "situation": "Give the command 'Eat!' (to a friend)",
      "cue": "Eat! (informal)",
      "answer": "mange",
      "hint": "manger → drop tu and final -s",
      "mistakes": [
        {
          "answer": "manges",
          "feedback": "Drop the -s for -ER verb commands: Mange! (not Manges!)"
        }
      ]
    },
    {
      "id": "commands-tu-2",
      "type": "respond",
      "situation": "Give the command 'Speak!' (to a friend)",
