      "id": "s-days-of-the-week",
      "heading": "Days of the Week",
      "text": "Seven days - NEVER capitalized in French (unlike English!)",
      "example": "{lundi} (Monday), {mardi} (Tuesday), {mercredi} (Wednesday), {jeudi} (Thursday), {vendredi} (Friday), {samedi} (Saturday), {dimanche} (Sunday)"
    },
