  "concepts": [
    {
      "id": "c-comprendre-to-understand",
      "term": "{comprendre} = to understand",
      "definition": "The verb for understanding a language, a person or an idea.",
      "examples": [
        {
          "fr": "Je comprends le français.",
          "en": "I understand French."
        },
        {
          "fr": "Je comprends bien.",
          "en": "I understand well."
        }
      ]
    },
    {
      "id": "c-same-pattern-as-prendre",
      "term": "Like {prendre}",
      "definition": "{comprendre} is {prendre} with com- in front, so its forms change the same way.",
      "layout": "forms",
      "examples": [
        {
          "fr": "je comprends",
          "en": "I understand"
        },
        {
          "fr": "tu comprends",
          "en": "you understand"
        },
