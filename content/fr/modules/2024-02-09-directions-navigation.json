  "concepts": [
    {
      "id": "c-cardinal-directions",
      "term": "Cardinal Directions",
      "definition": "The four main compass directions in French",
      "example": "{le nord} (north), {le sud} (south), {l'est} (east), {l'ouest} (west)"
    },
    {
      "id": "c-turn-directions",
      "term": "Turn Directions",
      "definition": "Essential for giving and following directions",
      "example": "{tournez à gauche} (turn left), {tournez à droite} (turn right), {tout droit} (straight ahead)"
    },
    {
      "id": "c-location-descriptions",
      "term": "Location Descriptions",
      "definition": "Describe where things are relative to other things",
      "example": "{à côté de} (next to), {en face de} (across from), {près de} (near), {loin de} (far from)"
    },
    {
      "id": "c-giving-directions",
      "term": "Giving Directions",
      "definition": "Complete phrases for helping someone navigate",
      "example": "{Allez tout droit jusqu'à la gare, puis tournez à gauche} (Go straight as far as the station, then turn left)"
    },
    {
      "id": "c-asking-for-directions",
      "term": "Asking for Directions",
      "definition": "How to ask for help when lost",
      "example": "{Excusez-moi}, {où est...?} ({Excuse me}, where is...?), {Comment aller à...?} (How do you get to...?)"
    }
  ],
