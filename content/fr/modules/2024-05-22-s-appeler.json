        {
          "fr": "Elle s'appelle Sophie.",
          "en": "Her name is Sophie."
        }
      ]
    },
    {
      "id": "c-reflexive-pattern",
      "term": "{me} becomes {m'}",
      "definition": "Before a vowel, {me} and {te} drop their e.",
      "examples": [
        {
          "fr": "Je m'appelle Paul.",
          "en": "My name is Paul."
        },
        {
          "fr": "Tu t'appelles Pierre ?",
          "en": "Is your name Pierre?"
        }
      ]
    },
