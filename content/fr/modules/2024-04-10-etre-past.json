{
  "schema": "la-module@1",
  "module_key": "2024-04-10-etre-past",
  "kind": "lesson",
  "status": "written",
  "title": "{être} - Past Tense (was / were)",
  "description": "Talk about how things were in the past: j'étais (I was), tu étais (you were), il était (he was)",
  "can_do": [
    "Talk about the past (I was, you were, they were)",
    "Describe past states and conditions",
    "Say 'I was happy' or 'We were in Paris' in French"
  ],
  "teaches": {
    "constructions": [
      "fr:cx:imparfait"
    ]
  },
  "vocabulary": [
    {
      "word_id": "j-etais-fr",
      "fr": "j'étais",
      "gloss": "I was",
      "note": "imperfect tense"
    },
    {
      "word_id": "tu-etais-fr",
      "fr": "tu étais",
      "gloss": "you were (informal)",
      "note": "sounds same as j'étais"
    },
    {
      "word_id": "il-elle-etait-fr",
      "fr": "il/elle était",
      "gloss": "he/she was",
      "note": "sounds similar to j'étais/tu étais"
    },
    {
      "word_id": "nous-etions-fr",
      "fr": "nous étions",
      "gloss": "we were",
      "note": "imperfect tense"
    },
    {
      "word_id": "vous-etiez-fr",
      "fr": "vous étiez",
      "gloss": "you were (formal/plural)",
      "note": "imperfect tense"
    },
    {
      "word_id": "ils-elles-etaient-fr",
      "fr": "ils/elles étaient",
      "gloss": "they were",
      "note": "sounds like 'étè'"
    }
  ],
  "concepts": [
    {
      "id": "c-past-tense-imperfect-imparfait",
      "term": "Past Tense = Imperfect (Imparfait)",
      "definition": "Describes ongoing states or repeated actions in the past",
      "example": "{j'étais heureux} (I was happy), {nous étions à Paris} (we were in Paris)"
    },
    {
      "id": "c-etait-was-singular",
      "term": "{était} = was (singular)",
      "definition": "For je, tu, il/elle - describing past states",
      "example": "{j'étais jeune} (I was young), {tu étais là} (you were there), {il était bon} (it was good)"
    },
    {
      "id": "c-etions-etiez-etaient-were",
      "term": "{étions, étiez, étaient} = were (plural)",
      "definition": "For nous, vous, ils/elles - plural past states",
      "example": "{nous étions contents} (we were happy), {ils étaient ici} (they were here)"
    },
    {
      "id": "c-pattern-recognition",
      "term": "Pattern Recognition",
      "definition": "Notice: j'étais, tu étais, il/elle était all sound the same!",
      "example": "All singular forms end in -ais, -ais, -ait (similar sound)"
    },
    {
      "id": "c-with-negation",
      "term": "With Negation",
      "definition": "Use ne...pas around the past tense verb",
      "example": "{je n'étais pas} (I was not), {il n'était pas} (he was not)"
    }
  ],
  "items": [
