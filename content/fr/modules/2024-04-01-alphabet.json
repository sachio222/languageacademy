  "sections": [
    {
      "id": "s-the-french-alphabet",
      "heading": "The French Alphabet",
      "text": "French uses the same 26 letters as English, but pronunciation is very different!",
      "example": "A ({ah}), B (bay), C (say), D (day), E ({euh}), F (eff), G (zhay), H (ash), I (ee), J (zhee), K (kah), L (ell), M (emm), N (enn), O ({oh}), P (pay), Q (koo), R ({air}), S (ess), T (tay), U (oo), V (vay), W (doo-bluh-vay), X (eex), Y (ee-grek), Z (zed)"
    },
    {
      "id": "s-accent-aigu-e",
      "heading": "Accent Aigu (é)",
      "text": "The acute accent - appears only on 'e' and makes it sound like 'ay'",
      "example": "{café}, {été} (summer), {déjà}"
    },
    {
      "id": "s-accent-grave-e-a",
      "heading": "{Accent Grave} ({è, à, ù})",
      "text": "The grave accent - on 'e' makes it sound like 'eh', on 'a' and 'u' it distinguishes meaning",
      "example": "{très}, {où} (where), {là} (there)"
    },
    {
      "id": "s-accent-circonflexe-a-e",
      "heading": "Accent Circonflexe ({â, ê, î, ô, û})",
      "text": "The circumflex - can appear on any vowel, often indicates a historical 's' was dropped",
      "example": "{être} (to be), {hôtel}, {pâtes} (pasta), {île} (island)"
    },
    {
      "id": "s-trema-e-i-u",
      "heading": "{Tréma} ({ë, ï, ü, ÿ})",
      "text": "The diaeresis - indicates two vowels are pronounced separately",
      "example": "{Noël} (Christmas), {naïve}, {maïs} (corn)"
    },
    {
      "id": "s-cedille-c",
      "heading": "{Cédille} (ç)",
      "text": "The cedilla - makes 'c' sound like 's' before a, o, u",
      "example": "{ça}, {français}, {garçon} (boy)"
    },
    {
      "id": "s-ligatures-oe-ae",
      "heading": "Ligatures ({œ, æ})",
      "text": "Two letters merged together - œ is common, æ is rare",
      "example": "{cœur} (heart), {sœur} (sister), curriculum vitæ"
    }
  ]
}
