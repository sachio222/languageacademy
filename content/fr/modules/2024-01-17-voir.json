      "instruction": "Say what you see. Say \"I see\": I see / I am seeing",
      "shown": "voir",
      "answer": "je vois",
      "hint": "{je + voir = ?}",
      "mistakes": [
        {
          "answer": "tu vois",
          "feedback": "That's \"you see (informal)\", not \"I see\""
