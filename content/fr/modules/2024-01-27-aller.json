{
  "schema": "la-module@1",
  "module_key": "2024-01-27-aller",
  "kind": "lesson",
  "status": "written",
  "title": "Essential Verb - {aller} (to go)",
  "description": "Master movement through active recall and composition practice!",
  "can_do": [
    "Express movement and going places (I go, you go, they go)",
    "Talk about future plans (I'm going to...)",
    "Say 'Where are you going?' or 'I'm going to Paris'"
  ],
  "teaches": {
    "constructions": [
      "fr:cx:frame.aller-infinitive"
    ]
  },
  "vocabulary": [
    {
      "word_id": "aller-fr",
      "fr": "aller",
      "gloss": "to go",
      "note": "infinitive form"
    },
    {
      "word_id": "je-vais-fr",
      "fr": "je vais",
      "gloss": "I go / I'm going",
      "note": "aller - irregular!"
    },
    {
      "word_id": "tu-vas-fr",
      "fr": "tu vas",
      "gloss": "you go (informal)",
      "note": "different from je"
    },
    {
      "word_id": "il-va-fr",
      "fr": "il va",
      "gloss": "he goes",
      "note": "also in '{ça va}'"
    },
    {
      "word_id": "elle-va-fr",
      "fr": "elle va",
      "gloss": "she goes",
      "note": "same as il"
    },
    {
      "word_id": "nous-allons-fr",
      "fr": "nous allons",
      "gloss": "we go",
      "note": "completely different stem!"
    },
    {
      "word_id": "vous-allez-fr",
      "fr": "vous allez",
      "gloss": "you go (formal)",
      "note": "similar to nous"
    },
    {
      "word_id": "ils-vont-fr",
      "fr": "ils vont",
      "gloss": "they go (masc)",
      "note": "yet another form!"
    },
    {
      "word_id": "elles-vont-fr",
      "fr": "elles vont",
      "gloss": "they go (fem)",
      "note": "same as ils"
    }
  ],
  "concepts": [
    {
      "id": "c-aller-to-go",
      "term": "{aller} = to go",
      "definition": "The verb for going somewhere. With a second verb after it, it also says what is going to happen.",
      "examples": [
        {
          "fr": "Je vais au café.",
          "en": "I'm going to the café."
        },
        {
          "fr": "Je vais voir Paul.",
          "en": "I'm going to see Paul."
        },
        {
          "fr": "Il va me voir.",
          "en": "He's going to see me."
        }
      ]
    },
    {
      "id": "c-irregular-conjugation",
      "term": "Its forms",
      "definition": "Almost every form is different, so learn each one with its pronoun.",
      "layout": "forms",
      "examples": [
        {
          "fr": "je vais",
          "en": "I go"
        },
        {
          "fr": "tu vas",
          "en": "you go"
        },
        {
          "fr": "il va",
          "en": "he goes"
        },
        {
          "fr": "nous allons",
          "en": "we go"
        },
        {
          "fr": "vous allez",
          "en": "you go"
        },
        {
          "fr": "ils vont",
          "en": "they go"
        }
      ]
    },
    {
      "id": "c-composition-power",
      "term": "Going to do something",
      "definition": "Put a second verb after {aller} to say what is going to happen, as in English.",
      "examples": [
        {
          "fr": "Je vais venir.",
          "en": "I'm going to come."
        },
        {
          "fr": "Je vais avoir ça.",
          "en": "I'm going to have that."
        },
        {
          "fr": "Qu'est-ce que tu vas avoir ?",
          "en": "What are you going to have?"
        }
      ]
    }
  ],
