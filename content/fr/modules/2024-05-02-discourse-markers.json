  "concepts": [
    {
      "id": "c-what-are-discourse-markers",
      "term": "Small words that fill speech",
      "definition": "French speakers use short words to link ideas, take a pause and soften what they say. They make you sound natural.",
      "examples": [
        {
          "fr": "Je ne comprends pas.",
          "en": "I don't understand."
        },
        {
          "fr": "Bon, je ne comprends pas, donc je veux apprendre, quoi.",
          "en": "Well, I don't understand, so I want to learn, you know.",
          "note": "the same idea, the way people say it"
        }
      ]
    },
    {
      "id": "c-donc-so-therefore",
      "term": "{donc} = so, therefore",
      "definition": "{donc} links a cause to its result. At the start of a question it means so.",
      "examples": [
        {
          "fr": "Je pense, donc je suis.",
          "en": "I think, therefore I am.",
          "note": "Descartes"
        },
        {
          "fr": "Donc, tu comprends ?",
          "en": "So, do you understand?"
        }
      ]
    },
    {
      "id": "c-en-fait-in-fact",
      "term": "{en fait} = actually",
      "definition": "Use it to correct or explain what was just said.",
      "examples": [
        {
          "fr": "En fait, je ne sais pas.",
          "en": "Actually, I don't know."
        },
        {
          "fr": "En fait, c'est comme ça.",
          "en": "In fact, that's how it is."
        }
      ]
    },
    {
      "id": "c-bah-well",
      "term": "{bah} = well",
      "definition": "An informal sound for a pause before you explain.",
      "examples": [
        {
          "fr": "Bah, c'est comme ça.",
          "en": "Well, that's how it is."
        },
        {
          "fr": "Bah, je ne sais pas.",
          "en": "Well, I don't know."
        }
      ]
    },
    {
      "id": "c-quoi-like-you-know",
      "term": "{quoi} at the end = you know",
      "definition": "Put {quoi} at the end of a sentence to stress it in casual speech.",
      "examples": [
        {
          "fr": "C'est bon, quoi.",
          "en": "It's good, you know."
        },
        {
          "fr": "C'est comme ça, quoi.",
          "en": "That's how it is, you know."
        }
      ]
    },
    {
      "id": "c-more-discourse-markers",
      "term": "{bon} and {alors}",
      "definition": "Both often start a sentence. {bon} means well, and {alors} means so or then.",
      "examples": [
        {
          "fr": "Bon, on commence ?",
          "en": "Well, shall we start?"
        },
        {
          "fr": "Alors, tu viens ?",
          "en": "So, are you coming?"
        },
        {
          "fr": "Alors, tu vas à l'université ? En fait, je n'ai pas de cours aujourd'hui.",
          "en": "So, are you going to the university? Actually, I don't have class today."
        },
        {
          "fr": "Bon, voilà la réponse.",
          "en": "Well, there's the answer."
        }
      ]
    }
  ],
