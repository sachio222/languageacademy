  "concepts": [
    {
      "id": "c-demander-to-ask-for",
      "term": "{demander} = to ask, to ask for",
      "definition": "One verb for asking a question and for asking for something.",
      "examples": [
        {
          "fr": "Je demande de l'aide.",
          "en": "I'm asking for help."
        },
        {
          "fr": "Pourquoi tu demandes ?",
          "en": "Why do you ask?"
        }
      ]
    },
    {
      "id": "c-regular-er-verb-pattern",
      "term": "The forms of {demander}",
      "definition": "{demander} changes like {parler}.",
      "layout": "forms",
      "examples": [
        {
          "fr": "je demande",
          "en": "I ask"
        },
        {
          "fr": "tu demandes",
          "en": "you ask"
        },
        {
          "fr": "il demande",
          "en": "he asks"
        },
        {
          "fr": "nous demandons",
          "en": "we ask"
        },
        {
          "fr": "vous demandez",
          "en": "you ask"
        },
        {
          "fr": "ils demandent",
          "en": "they ask"
        }
      ]
    },
    {
      "id": "c-demander-quelque-chose-to",
      "term": "Asking for something",
      "definition": "The thing you ask for comes straight after the verb. English needs for, French does not.",
      "examples": [
        {
          "fr": "Tu demandes un café.",
          "en": "You ask for a coffee."
        },
        {
          "fr": "Il demande ton nom.",
          "en": "He asks for your name."
        },
        {
          "fr": "Elle demande l'addition.",
          "en": "She asks for the bill."
        }
      ]
    },
    {
      "id": "c-demander-a-quelqu-un",
      "term": "Asking someone",
      "definition": "Use {à} before the person you ask.",
      "examples": [
        {
          "fr": "Je demande à Marie.",
          "en": "I'll ask Marie."
        },
        {
          "fr": "Tu demandes à ton père.",
          "en": "You ask your father."
        },
        {
          "fr": "Il demande à sa mère.",
          "en": "He asks his mother."
        }
      ]
    },
    {
      "id": "c-demander-de-infinitive",
      "term": "Asking someone to do something",
      "definition": "Put {de} before the second verb.",
      "examples": [
        {
          "fr": "Il me demande de venir.",
          "en": "He asks me to come."
        },
        {
          "fr": "Elle nous demande d'attendre.",
          "en": "She asks us to wait."
        },
        {
          "fr": "Je demande de partir.",
          "en": "I ask to leave."
        }
      ]
    },
    {
      "id": "c-common-uses",
      "term": "Saying sorry, asking permission",
      "definition": "Two phrases with {demander} that you hear often.",
      "examples": [
        {
          "fr": "Je demande pardon.",
          "en": "I apologize."
        },
        {
          "fr": "Nous demandons la permission.",
          "en": "We ask for permission."
        }
      ]
    }
  ],
