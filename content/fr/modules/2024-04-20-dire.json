      "gloss": "I tell you",
      "note": "te = you (object pronoun)"
    },
    {
      "word_id": "il-me-dit-fr",
      "fr": "il me dit",
      "gloss": "he tells me",
      "note": "me = me (object pronoun)"
    },
    {
      "word_id": "c-est-a-dire-fr",
      "fr": "c'est-à-dire",
      "gloss": "that is to say / i.e.",
      "note": "useful connector - abbreviated as 'càd'"
    },
    {
      "word_id": "on-dit-que-fr",
      "fr": "on dit que",
      "gloss": "they say that / people say that",
      "note": "on = people in general"
    },
