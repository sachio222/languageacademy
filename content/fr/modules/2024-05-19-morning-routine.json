  "concepts": [
    {
      "id": "c-se-reveiller-to-wake",
      "term": "{se réveiller} = to wake up",
      "definition": "First action of the day - reflexive because you wake yourself up",
      "example": "{je me réveille à 7h} (I wake up at 7am), {tu te réveilles tôt} (you wake up early)"
    },
    {
      "id": "c-se-lever-to-get",
      "term": "{se lever} = to get up / to stand up",
      "definition": "After waking, you get yourself up - natural sequence!",
      "example": "{je me lève à 7h30} (I get up at 7:30), {tu te lèves tard} (you get up late)"
    },
