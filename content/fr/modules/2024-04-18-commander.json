  "concepts": [
    {
      "id": "c-commander-to-order",
      "term": "{commander} = to order",
      "definition": "Order food at restaurants, drinks at cafés, products online - regular -ER verb",
      "example": "{je commande un café} (I order a coffee), {nous commandons une pizza} (we order a pizza)"
    },
    {
      "id": "c-regular-er-verb-pattern",
      "term": "Regular -ER verb pattern",
      "definition": "Follows same pattern as parler, demander - drop -er, add endings",
      "example": "{je commande}, {tu commandes}, {il commande}, {nous commandons}, {vous commandez}, {ils commandent}"
    },
    {
      "id": "c-restaurant-cafe-context",
      "term": "{Restaurant}/café context",
      "definition": "Most common use - ordering food and drinks in restaurants",
      "example": "{je commande un steak} (I order a steak), {vous commandez le menu?} (are you ordering the set menu?)"
    },
    {
      "id": "c-online-shopping",
      "term": "Online shopping",
      "definition": "Also used for ordering products online or by phone",
      "example": "{je commande en ligne} (I order online), {commander sur Amazon} (to order on Amazon)"
    },
    {
      "id": "c-similar-to-demander",
      "term": "Similar to demander",
      "definition": "Both mean 'to ask for', but commander specifically means 'to order' (more formal/transactional)",
      "example": "{demander} = ask for (general), {commander} = order ({restaurant}/shop)"
    }
  ],
