      "hint": "{on se voit + demain}"
    },
    {
      "id": "reciprocal-4",
      "type": "translate",
      "prompt": "They talk to each other",
      "answer": "ils se parlent",
      "hint": "{ils se + parler}"
    },
    {
      "id": "reciprocal-5",
      "type": "translate",
      "prompt": "They know each other",
