      "fr": "parler",
      "gloss": "to speak / to talk",
      "note": "infinitive form - regular -ER verb"
    },
    {
      "word_id": "je-parle-fr",
      "fr": "je parle",
      "gloss": "I speak",
      "note": "drop -er, add -e (silent)"
    },
    {
      "word_id": "tu-parles-fr",
      "fr": "tu parles",
      "gloss": "you speak (informal)",
      "note": "add -es (silent)"
    },
    {
      "word_id": "il-parle-fr",
      "fr": "il parle",
      "gloss": "he speaks",
      "note": "add -e (sounds same as je)"
