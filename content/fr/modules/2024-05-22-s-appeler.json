  "concepts": [
    {
      "id": "c-s-appeler-to-be",
      "term": "{s'appeler} = to be called",
      "definition": "The verb for saying a name. Literally, it means to call yourself.",
      "examples": [
        {
          "fr": "Je m'appelle Marie.",
          "en": "My name is Marie."
        },
        {
          "fr": "Comment tu t'appelles ?",
          "en": "What's your name?"
        },
        {
          "fr": "Mon frère s'appelle Paul.",
          "en": "My brother's name is Paul."
        }
      ]
    },
    {
      "id": "c-this-should-ve-been",
      "term": "Introducing yourself",
      "definition": "With {s'appeler} you can say who you are and ask someone's name.",
      "examples": [
        {
          "fr": "Bonjour, je m'appelle Marie.",
          "en": "Hello, my name is Marie."
        },
        {
          "fr": "Comment vous vous appelez ?",
          "en": "What's your name?",
          "note": "to someone you call {vous}"
