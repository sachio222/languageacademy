  "concepts": [
    {
      "id": "c-connaitre-to-know-people",
      "term": "{connaître} = to know",
      "definition": "Use {connaître} for people and places you know, and for things you are familiar with.",
      "examples": [
        {
          "fr": "Je connais Marie.",
          "en": "I know Marie."
        },
        {
          "fr": "Je connais Paris.",
          "en": "I know Paris."
        },
        {
          "fr": "Je ne sais pas, je ne connais pas Paris.",
          "en": "I don't know, I don't know Paris."
        }
      ]
    },
    {
      "id": "c-irregular-conjugation-with-i",
      "term": "The forms of {connaître}",
      "definition": "The form for he and she keeps the î. The plural forms add -ss-.",
      "layout": "forms",
      "examples": [
        {
          "fr": "je connais",
          "en": "I know"
        },
        {
          "fr": "tu connais",
          "en": "you know"
        },
        {
          "fr": "il connaît",
          "en": "he knows"
        },
        {
          "fr": "nous connaissons",
          "en": "we know"
        },
        {
          "fr": "vous connaissez",
          "en": "you know"
        },
        {
          "fr": "ils connaissent",
          "en": "they know"
        }
      ]
    },
    {
      "id": "c-the-key-distinction-savoir",
      "term": "{savoir} or {connaître}",
      "definition": "{savoir} is for facts and skills. {connaître} is for people, places and things you know well.",
      "examples": [
        {
          "fr": "Je sais la réponse.",
          "en": "I know the answer."
        },
        {
          "fr": "Je connais Marie.",
          "en": "I know Marie."
        },
        {
          "fr": "Je sais son nom, mais je ne le connais pas.",
          "en": "I know his name, but I don't know him."
        }
      ]
    },
    {
      "id": "c-never-use-connaitre-infinitive",
      "term": "A skill takes {savoir}",
      "definition": "Before another verb, always use {savoir}, never {connaître}.",
      "examples": [
        {
          "fr": "Je sais parler français.",
          "en": "I can speak French."
        },
        {
          "fr": "Tu sais faire ça ?",
          "en": "Do you know how to do that?"
        }
      ]
    },
    {
      "id": "c-common-uses",
      "term": "Knowing places and things",
      "definition": "Use {connaître} for a film, a restaurant or a book you know.",
      "examples": [
        {
          "fr": "Je connais ce film.",
          "en": "I know this film."
        },
        {
          "fr": "Tu connais ce restaurant ?",
          "en": "Do you know this restaurant?"
        }
      ]
    }
  ],
