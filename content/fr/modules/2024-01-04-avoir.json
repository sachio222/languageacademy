  "items": [
    {
      "id": "i-j-ai",
      "type": "transform",
      "instruction": "Talk about something you possess. Say \"I have\"",
      "shown": "avoir",
      "answer": "j'ai",
      "hint": "{je + avoir = ?}",
      "mistakes": [
        {
          "answer": "je ai",
          "feedback": "Use j'ai with an apostrophe, not 'je ai'"
        },
        {
          "answer": "tu as",
          "feedback": "That's 'you have', not 'I have'"
        }
      ]
    },
