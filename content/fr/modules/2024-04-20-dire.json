  "kind": "lesson",
  "status": "written",
  "title": "{dire} - To Say / To Tell",
  "description": "Express what you say and tell: je dis (I say), tu dis la vérité (you tell the truth), il me dit (he tells me)",
  "can_do": [
    "Express what you say and tell (I say, you tell, they say)",
    "Report speech and convey information",
    "Use dire with que to quote what people say"
  ],
  "teaches": {
    "constructions": [
      "fr:cx:frame.verb-que-clause",
      "fr:cx:chunk.cest-a-dire"
    ]
  },
  "vocabulary": [
    {
