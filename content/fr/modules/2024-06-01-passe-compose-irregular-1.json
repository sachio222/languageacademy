  "concepts": [
    {
      "id": "c-avoir-eu-had",
      "term": "{avoir} → {eu} (had)",
      "definition": "Irregular past participle: j'ai eu, tu as eu, il a eu",
      "example": "{J'ai eu le temps} (I had time), {J'ai eu de la chance} (I had luck/I was lucky)"
    },
    {
      "id": "c-etre-ete-was-been",
      "term": "{être} → {été} (was/been)",
      "definition": "Irregular past participle: j'ai été, tu as été, il a été",
      "example": "{J'ai été content} (I was happy), {J'ai été à Paris} (I went to Paris - informal)"
    },
    {
      "id": "c-faire-fait-did-made",
      "term": "{faire} → {fait} (did/made)",
      "definition": "Irregular past participle: j'ai fait, tu as fait, il a fait",
      "example": "{J'ai fait ça} (I did that), {J'ai fait mes devoirs} (I did my homework), {J'ai fait un gâteau} (I made a cake)"
    },
    {
      "id": "c-voir-vu-saw",
      "term": "{voir} → {vu} (saw)",
      "definition": "Irregular past participle: j'ai vu, tu as vu, il a vu",
      "example": "{J'ai vu le film} (I saw the movie), {Tu as vu Marie?} (Did you see Marie?), {J'ai vu Paul, il est assis au café} (I saw Paul, he's sitting at the café)"
    },
    {
      "id": "c-memory-tip",
      "term": "Memory tip",
      "definition": "These 4 verbs are the most common - memorize them!",
      "example": "{eu}, {été}, {fait}, {vu} - practice these until automatic"
    },
    {
      "id": "c-all-use-avoir-as",
      "term": "All use AVOIR as auxiliary",
      "definition": "These 4 verbs all use '{avoir}' (not être) in passé composé",
      "example": "{j'ai eu}, {j'ai été}, {j'ai fait}, {j'ai vu} (all with '{avoir}')"
    }
  ],
