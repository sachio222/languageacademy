  "kind": "lesson",
  "status": "written",
  "title": "Modifiers - {tout, même, mal}",
  "description": "Complete your comparison words: tout le monde (everyone), c'est la même chose (it's the same thing), je comprends mal (I understand poorly)",
  "can_do": [
    "Use tout for 'all' and 'everyone' (tout le monde)",
    "Express sameness with même (the same thing)",
    "Describe how well or poorly you do things (mal, bien)"
  ],
  "teaches": {
    "constructions": [
      "fr:cx:chunk.tout-le-monde"
    ]
  },
  "vocabulary": [
    {
