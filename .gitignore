/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs
dist/
dist-ssr/
# release bundles for L (pnpm content:bundle); kept out of dist/, which Vercel serves
dist-content/
build/
