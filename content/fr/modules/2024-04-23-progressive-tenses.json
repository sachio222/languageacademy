  "kind": "lesson",
  "status": "written",
  "title": "Progressive & Future - Expressing Time",
  "description": "Say what you're doing now, what you're going to do, and what you can't/won't/shouldn't do",
  "can_do": [
    "Express ongoing actions (I'm eating, you're speaking)",
    "Talk about future plans (I'm going to go, we're going to eat)",
    "Use future tense for definite future actions"
  ],
  "vocabulary": [
    {
      "word_id": "etre-en-train-de-fr",
      "fr": "être en train de",
      "gloss": "to be in the process of",
      "note": "en train = in the train/process - literally 'in the act of'"
    },
    {
      "word_id": "je-suis-en-train-de-manger-fr",
      "fr": "je suis en train de manger",
      "gloss": "I am eating",
      "note": "present progressive - happening now!"
    },
    {
      "word_id": "j-etais-en-train-de-parler-fr",
      "fr": "j'étais en train de parler",
      "gloss": "I was talking",
      "note": "past progressive - was happening then"
    },
    {
      "word_id": "je-vais-partir-fr",
      "fr": "je vais partir",
      "gloss": "I am going to leave",
      "note": "near future - aller + infinitive"
    },
    {
      "word_id": "je-vais-manger-fr",
      "fr": "je vais manger",
      "gloss": "I am going to eat",
      "note": "near future"
    },
    {
      "word_id": "je-parlerai-fr",
      "fr": "je parlerai",
      "gloss": "I will speak",
      "note": "future tense - parler + ai"
    },
    {
      "word_id": "tu-mangeras-fr",
      "fr": "tu mangeras",
      "gloss": "you will eat",
      "note": "future tense - manger + as"
    },
    {
      "word_id": "il-ira-fr",
      "fr": "il ira",
      "gloss": "he will go",
      "note": "irregular future - from aller"
    },
    {
      "word_id": "je-ne-peux-pas-fr",
      "fr": "je ne peux pas",
      "gloss": "I can't",
      "note": "negative modal - pouvoir"
    },
    {
      "word_id": "je-ne-vais-pas-fr",
      "fr": "je ne vais pas",
      "gloss": "I'm not going to",
      "note": "negative near future"
    },
    {
      "word_id": "je-ne-devrais-pas-fr",
      "fr": "je ne devrais pas",
      "gloss": "I shouldn't",
      "note": "negative conditional - devoir"
    },
    {
      "word_id": "je-ne-ferai-pas-fr",
      "fr": "je ne ferai pas",
      "gloss": "I won't do",
      "note": "negative future tense"
    }
  ],
  "concepts": [
    {
      "id": "c-etre-en-train-de",
      "term": "être en train de + infinitive",
      "definition": "Express an action happening RIGHT NOW - like English 'I am doing...'",
      "example": "{je suis en train de manger} (I am eating), {il est en train de parler} (he is talking)"
    },
    {
      "id": "c-aller-infinitive-near-future",
      "term": "aller + infinitive (near future)",
      "definition": "Express what you're GOING TO DO - aller (to go) + verb infinitive",
      "example": "{je vais manger} (I'm going to eat), {tu vas parler} (you're going to speak)"
    },
    {
      "id": "c-future-tense-je-rai",
      "term": "Future tense - je ...-rai",
      "definition": "Express what you WILL do - add -rai, -ras, -ra, -rons, -rez, -ront to infinitive",
      "example": "{je parlerai} (I will speak), {tu mangeras} (you will eat), {il ira} (he will go - irregular)"
    },
    {
      "id": "c-negative-modals",
      "term": "Negative modals",
      "definition": "Express can't, won't, shouldn't - je ne peux pas, je ne vais pas, je ne devrais pas",
      "example": "{je ne peux pas partir} (I can't leave), {je ne devrais pas manger ça} (I shouldn't eat that)"
    },
    {
      "id": "c-j-etais-en-train",
      "term": "{J'étais en train de...} (past progressive)",
      "definition": "Say what you WERE doing - use past tense of être + en train de",
      "example": "{j'étais en train de manger} (I was eating), {ils étaient en train de parler} (they were talking)"
    }
  ],
