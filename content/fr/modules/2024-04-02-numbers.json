  "sections": [
    {
      "id": "s-numbers-0-20",
      "heading": "Numbers 0-20",
      "text": "The foundation numbers you need to memorize",
      "example": "{0 zéro}, {1 un}, {2 deux}, {3 trois}, {4 quatre}, {5 cinq}, {6 six}, {7 sept}, {8 huit}, {9 neuf}, {10 dix}, {11 onze}, {12 douze}, {13 treize}, {14 quatorze}, {15 quinze}, {16 seize}, {17 dix-sept}, {18 dix-huit}, {19 dix-neuf}, {20 vingt}"
    },
    {
      "id": "s-tens-20-60",
      "heading": "Tens (20-60)",
      "text": "Regular tens that follow a pattern",
      "example": "{20 vingt}, {30 trente}, {40 quarante}, {50 cinquante}, {60 soixante}"
    },
    {
      "id": "s-the-famous-french-70s",
      "heading": "The Famous French 70s!",
      "text": "70 = sixty-ten (soixante-dix). French counts: 71 (sixty-eleven), 72 (sixty-twelve), etc.",
      "example": "{70 soixante-dix}, {71 soixante-et-onze}, {75 soixante-quinze}, {79 soixante-dix-neuf}"
    },
    {
      "id": "s-the-infamous-french-80s",
      "heading": "The Infamous French 80s!",
      "text": "80 = four-twenties (quatre-vingts). A remnant of Celtic base-20 counting!",
      "example": "{80 quatre-vingts}, {81 quatre-vingt-un}, {85 quatre-vingt-cinq}, {89 quatre-vingt-neuf}"
    },
    {
      "id": "s-the-wild-french-90s",
      "heading": "The Wild French 90s!",
      "text": "90 = four-twenty-ten (quatre-vingt-dix). Combining both systems!",
      "example": "{90 quatre-vingt-dix, 91 quatre-vingt-onze, 95 quatre-vingt-quinze, 99 quatre-vingt-dix-neuf}"
    },
    {
      "id": "s-numbers-21-69-pattern",
      "heading": "Numbers 21-69 Pattern",
      "text": "Add single digits with a hyphen. Use '{et}' (and) for 21, 31, 41, 51, 61",
      "example": "{21 vingt-et-un}, {22 vingt-deux}, {35 trente-cinq}, {47 quarante-sept}, {69 soixante-neuf}"
    },
    {
      "id": "s-large-numbers",
      "heading": "Large Numbers",
      "text": "Hundreds, thousands, millions - building bigger numbers",
      "example": "{100 cent}, {200 deux cents}, {1000 mille}, 1,000,{000 un million}, 1,000,000,{000 un milliard}"
    },
    {
      "id": "s-belgian-swiss-variation",
      "heading": "Belgian & Swiss Variation",
      "text": "More logical! Belgium and Switzerland use: 70 septante, 90 nonante",
      "example": "70 septante (vs soixante-dix), 90 nonante (vs quatre-vingt-dix). Much easier!"
    },
    {
      "id": "s-important-exceptions-rules",
      "heading": "Important Exceptions & Rules",
      "text": "Key exceptions you need to know to avoid common mistakes",
      "example": "1) '{et}' (and) only for 21, 31, 41, 51, 61, 71 - NOT 81 or 91! 2) '{quatre-vingts}' (80) has 's' but '{quatre-vingt-un}' (81) loses it. 3) '{cents}' plural: '{deux cents}' (200) but '{deux cent un}' (201). 4) '{mille}' NEVER plural: '{trois mille}' (3,000) not 'milles'. 5) Hyphens between all parts EXCEPT before/after 'et' or '{cent}/{mille'}"
    }
  ]
}
