  "concepts": [
    {
      "id": "c-reciprocal-each-other",
      "term": "Reciprocal = Each Other",
      "definition": "Plural reflexive pronouns can mean 'each other' - mutual action!",
      "example": "{nous nous aimons} (we love each other), {ils se regardent} (they look at each other)"
    },
    {
      "id": "c-only-with-plural-subjects",
      "term": "Only with Plural Subjects",
      "definition": "You need nous, vous, ils, elles, or on to have 'each other'",
      "example": "{nous nous parlons} (we talk to each other), {ils se connaissent} (they know each other)"
    },
    {
      "id": "c-same-form-different-meaning",
      "term": "Same Form, Different Meaning",
      "definition": "The reflexive form is the same - context tells you if it's 'ourselves' or 'each other'",
      "example": "{nous nous préparons} (we prepare ourselves OR we prepare each other - context!)"
    },
    {
      "id": "c-common-reciprocal-expressions",
      "term": "Common Reciprocal Expressions",
      "definition": "Very common in relationships and social contexts",
      "example": "{on se voit demain} (we'll see each other tomorrow), {ils se parlent} (they talk to each other)"
    }
  ],
