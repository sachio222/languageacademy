    "constructions": [
      "fr:cx:imperative.irregular",
      "fr:cx:imperative.nous",
      "fr:cx:chunk.vas-y",
      "fr:cx:chunk.allons-y",
      "fr:cx:pronoun.y"
    ]
  },
