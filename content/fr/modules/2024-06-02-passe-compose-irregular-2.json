  "kind": "lesson",
  "status": "written",
  "title": "Irregular Past Participles - Set 2 (wanted, could, had to, said)",
  "description": "Learn modal verbs and -RE verbs in past tense: vouloir → voulu (wanted), pouvoir → pu (could), devoir → dû (had to), dire → dit (said), prendre → pris (took)",
  "can_do": [
    "Express past desires, abilities, and obligations (wanted, could, had to)",
    "Say 'I wanted to go', 'I could come', 'I had to work'",
    "Use irregular past forms for modal and -RE verbs"
  ],
  "teaches": {
    "constructions": [
      "fr:cx:passe-compose.avoir",
      "fr:cx:frame.modal-infinitive"
    ]
  },
  "vocabulary": [
    {
      "word_id": "j-ai-voulu-fr",
      "fr": "j'ai voulu",
      "gloss": "I wanted",
      "note": "⭐ vouloir → voulu (irregular!)"
    },
    {
      "word_id": "j-ai-pu-fr",
      "fr": "j'ai pu",
      "gloss": "I could / I was able to",
      "note": "⭐ pouvoir → pu (irregular!)"
    },
    {
      "word_id": "j-ai-du-fr",
      "fr": "j'ai dû",
      "gloss": "I had to / I must have",
      "note": "⭐ devoir → dû (irregular! - accent)"
    },
    {
      "word_id": "j-ai-dit-fr",
      "fr": "j'ai dit",
      "gloss": "I said",
      "note": "⭐ dire → dit (irregular!)"
    },
    {
      "word_id": "j-ai-pris-fr",
      "fr": "j'ai pris",
      "gloss": "I took",
      "note": "⭐ prendre → pris (irregular!)"
    },
    {
      "word_id": "j-ai-mis-fr",
      "fr": "j'ai mis",
      "gloss": "I put",
      "note": "mettre → mis (irregular!)"
    },
    {
      "word_id": "j-ai-compris-fr",
      "fr": "j'ai compris",
      "gloss": "I understood",
      "note": "comprendre → compris (like prendre)"
    },
    {
