  "concepts": [
    {
      "id": "c-abstract-vs-concrete-nouns",
      "term": "Abstract vs Concrete Nouns",
      "definition": "Abstract nouns (temps, vie, monde) express ideas. Concrete nouns (pain, eau, table) are physical objects.",
      "example": "{la vie} (life - abstract), {le pain} (bread - concrete)"
    },
    {
      "id": "c-using-in-real-conversations",
      "term": "Using in Real Conversations",
      "definition": "These are the nouns you'll use constantly in French - combine with verbs you know!",
      "example": "{je veux du pain, j'ai le temps, il parle du monde}"
    },
    {
      "id": "c-remember-the-gender",
      "term": "Remember the Gender!",
      "definition": "Always learn the article with the noun - it shows the gender",
      "example": "{le temps} (masculine), {la vie} (feminine)"
    }
  ],
  "items": [
    {
      "id": "i-j-ai-le-temps",
      "type": "respond",
      "situation": "I have time",
      "answer": "j'ai le temps",
      "hint": "j'ai + article + temps (masculine)",
      "mistakes": [
        {
          "answer": "j'ai la temps",
          "feedback": "temps is masculine, use '{le}' not 'la'"
        },
        {
          "answer": "j'ai un temps",
          "feedback": "Use definite article '{le}' for 'the time'"
        }
      ]
    },
    {
      "id": "i-la-vie-est-bonne",
      "type": "respond",
      "situation": "life is good",
      "answer": "la vie est bonne",
      "hint": "la vie + est + bon/bonne (feminine form!)",
      "mistakes": [
        {
          "answer": "la vie est bon",
          "feedback": "vie is feminine, adjective needs '{bonne}' not 'bon'"
        },
        {
          "answer": "le vie est bonne",
          "feedback": "vie is feminine, use '{la}' not 'le'"
        }
      ]
    },
    {
      "id": "i-le-monde-est-grand",
      "type": "respond",
      "situation": "the world is big",
      "answer": "le monde est grand",
      "hint": "le monde + est + grand (masculine)",
      "mistakes": [
        {
          "answer": "la monde est grand",
          "feedback": "monde is masculine, use '{le}' not 'la'"
        },
        {
          "answer": "le monde est grande",
          "feedback": "monde is masculine, use '{grand}' not 'grande'"
        }
      ]
    },
    {
      "id": "i-je-veux-de-l",
      "type": "respond",
      "situation": "I want water",
      "answer": "je veux de l'eau",
      "accept": [
        "je veux l'eau",
        "je veux de l eau"
      ],
      "hint": "je veux + de l'eau (use partitive with food/drink!)",
      "mistakes": [
        {
          "answer": "je veux le eau",
          "feedback": "eau starts with vowel, use l'eau not 'le eau'"
        }
      ]
    },
    {
      "id": "i-nous-avons-du-pain",
      "type": "respond",
      "situation": "we have bread",
      "answer": "nous avons du pain",
      "accept": [
        "nous avons le pain"
      ],
      "hint": "nous avons + du pain (use partitive with food!)",
      "mistakes": [
        {
          "answer": "nous avons la pain",
          "feedback": "pain is masculine, use '{le/du}' not 'la'"
        }
      ]
    },
    {
      "id": "i-il-n-a-pas",
      "type": "respond",
      "situation": "Say \"he does not have money\"",
      "cue": "he doesn't have money",
      "answer": "il n'a pas d'argent",
      "accept": [
        "il n a pas d argent",
        "il ne a pas d'argent"
      ],
      "hint": "il n'a pas + d'argent (negative with partitive!)",
      "mistakes": [
        {
          "answer": "il n'a pas l'argent",
          "feedback": "With negation and partitive, use '{pas d'argent}' not 'pas l'argent'"
        }
      ]
    },
    {
      "id": "i-je-dois-travailler",
      "type": "respond",
      "situation": "I must work",
      "answer": "je dois travailler",
      "hint": "je dois + travailler (work as a verb!)",
      "mistakes": [
        {
          "answer": "je dois le travail",
          "feedback": "'work' as verb is '{travailler}', not 'travail' (noun)"
        }
      ]
    },
    {
      "id": "i-elle-vit-dans-la",
      "type": "respond",
      "situation": "she lives in the city",
      "answer": "elle vit dans la ville",
      "accept": [
        "elle habite dans la ville"
      ],
      "hint": "elle + verb vivre (lives) + dans + la ville",
      "mistakes": [
        {
          "answer": "elle vit dans le ville",
          "feedback": "ville is feminine, use '{la}' not 'le'"
