{
  "schema": "la-module@1",
  "module_key": "2024-05-23-temporal-words",
  "kind": "lesson",
  "status": "written",
  "title": "Temporal & Sequential Words - Time & Order",
  "description": "Organize actions in time: pendant (during), avant (before), après (after), d'abord (first), ensuite (then), finalement (finally)",
  "can_do": [
    "Sequence events in time (first, then, finally)",
    "Describe when things happen (before, during, after)",
    "Tell stories with proper temporal flow"
  ],
  "vocabulary": [
    {
      "word_id": "pendant-fr",
      "fr": "pendant",
      "gloss": "during / for",
      "note": "duration - pendant une heure"
    },
    {
      "word_id": "avant-fr",
      "fr": "avant",
      "gloss": "before",
      "note": "time - avant le cours"
    },
    {
      "word_id": "apres-fr",
      "fr": "après",
      "gloss": "after / afterwards",
      "note": "sequence - après le dîner; can be connector or preposition"
    },
    {
      "word_id": "depuis-fr",
      "fr": "depuis",
      "gloss": "since / for",
      "note": "duration from past - depuis trois ans"
    },
    {
      "word_id": "d-abord-fr",
      "fr": "d'abord",
      "gloss": "first / first of all",
      "note": "⭐ starts sequences"
    },
    {
      "word_id": "ensuite-fr",
      "fr": "ensuite",
      "gloss": "then / next",
      "note": "⭐ continues sequence"
    },
    {
      "word_id": "puis-fr",
      "fr": "puis",
      "gloss": "then",
      "note": "another word for 'then'"
    },
    {
      "word_id": "finalement-fr",
      "fr": "finalement",
      "gloss": "finally",
      "note": "⭐ ends sequence"
    },
    {
      "word_id": "enfin-fr",
      "fr": "enfin",
      "gloss": "at last / finally",
      "note": "relief or conclusion"
    }
  ],
  "concepts": [
    {
      "id": "c-temporal-prepositions",
      "term": "Before, after, during",
      "definition": "These words go before a noun to say when something happens or how long it lasts.",
      "examples": [
        {
          "fr": "Après le travail, je bois un café.",
          "en": "After work, I have a coffee."
        },
        {
          "fr": "Avant le cours, j'étudie.",
          "en": "Before class, I study."
        },
        {
          "fr": "J'étudie pendant une heure.",
          "en": "I study for an hour."
        }
      ]
    },
    {
      "id": "c-time-phrases",
      "term": "When and how often",
      "definition": "Short phrases that say when something happens or how often.",
      "examples": [
        {
          "fr": "En ce moment, je suis à Paris.",
          "en": "Right now I'm in Paris."
        },
        {
          "fr": "Cette année, j'apprends le français.",
          "en": "This year I'm learning French."
        },
        {
          "fr": "J'ai mangé là-bas une fois.",
          "en": "I ate there once."
        }
      ]
    },
    {
      "id": "c-sequential-connectors",
      "term": "First, then, finally",
      "definition": "These words put actions in order. They usually start the sentence.",
      "examples": [
        {
          "fr": "D'abord, je mange.",
          "en": "First, I eat."
        },
        {
          "fr": "Ensuite, je pars.",
          "en": "Then I leave."
        },
        {
          "fr": "Finalement, j'arrive.",
          "en": "Finally, I arrive."
        }
      ]
    },
    {
      "id": "c-building-smooth-narratives",
      "term": "Telling things in order",
      "definition": "Without these words, short sentences sound choppy. With them, they sound like a story.",
      "examples": [
        {
          "fr": "Je mange. Je pars.",
          "en": "I eat. I leave.",
          "note": "choppy"
        },
        {
          "fr": "D'abord, je mange. Ensuite, je pars.",
          "en": "First I eat. Then I leave.",
          "note": "smooth"
        }
      ]
    },
    {
      "id": "c-position-in-sentence",
      "term": "Where these words go",
      "definition": "Words for order usually start the sentence. Words like {avant} and {après} go before a noun.",
      "examples": [
        {
          "fr": "D'abord, je pars.",
          "en": "First, I leave."
        },
        {
          "fr": "Je pars après le cours.",
          "en": "I leave after class."
        },
        {
          "fr": "Je suis ici depuis ce matin.",
          "en": "I've been here since this morning."
        }
      ]
    }
  ],
  "items": [
    {
      "id": "temporal-1",
      "type": "respond",
      "situation": "Say 'during' or 'for (a duration)'",
      "cue": "during / for",
      "answer": "pendant",
      "hint": "Temporal preposition - pendant une heure",
      "mistakes": [
        {
          "answer": "pour",
          "feedback": "Use '{pendant}' for duration, 'pour' is for purpose/recipient"
        }
      ]
    },
    {
      "id": "temporal-2",
      "type": "translate",
      "prompt": "before",
      "answer": "avant",
      "hint": "Temporal preposition - opposite of après",
      "mistakes": [
        {
          "answer": "après",
          "feedback": "That's 'after', not 'before'!"
        }
      ]
    },
    {
      "id": "temporal-3",
      "type": "translate",
      "prompt": "after",
      "answer": "après",
      "hint": "Temporal word - opposite of avant",
      "mistakes": [
        {
          "answer": "avant",
          "feedback": "That's 'before', not 'after'!"
        }
      ]
    },
    {
      "id": "temporal-4",
      "type": "respond",
      "situation": "Say 'since' or 'for (time period from past)'",
      "cue": "since / for",
      "answer": "depuis",
      "hint": "depuis - duration from a point in the past"
    },
    {
      "id": "temporal-5",
      "type": "respond",
      "situation": "Say 'first' or 'first of all' (to start a sequence)",
      "cue": "first / first of all",
      "answer": "d'abord",
      "hint": "Starts a sequence - d'..."
    },
    {
      "id": "temporal-6",
      "type": "respond",
      "situation": "Say 'then' or 'next'",
      "cue": "then / next",
      "answer": "ensuite",
      "hint": "Continues a sequence - most common word",
      "mistakes": [
        {
          "answer": "puis",
          "feedback": "That also works, but '{ensuite}' is more common"
        }
      ]
    },
    {
      "id": "temporal-7",
      "type": "translate",
      "prompt": "finally",
      "answer": "finalement",
      "hint": "Ends a sequence - finalement",
      "mistakes": [
        {
          "answer": "enfin",
          "feedback": "That also means 'finally', but '{finalement}' is more common"
        }
      ]
    },
    {
      "id": "temporal-8",
      "type": "translate",
      "prompt": "First, I eat",
      "answer": "d'abord, je mange",
      "hint": "D'abord + comma + je mange"
    },
    {
      "id": "temporal-9",
      "type": "translate",
      "prompt": "Then, I leave",
      "answer": "ensuite, je pars",
      "hint": "Ensuite + comma + je pars"
    },
    {
      "id": "temporal-10",
      "type": "translate",
      "prompt": "Before class, I study",
      "answer": "avant le cours, j'étudie",
      "hint": "Avant + le cours + comma + j'étudie"
    },
    {
      "id": "temporal-11",
      "type": "translate",
      "prompt": "After class, I review",
      "answer": "après le cours, je révise",
      "hint": "Après + le cours + comma + je révise"
    },
    {
      "id": "temporal-12",
      "type": "respond",
      "situation": "Say 'For an hour' or 'During an hour'",
      "cue": "for an hour",
