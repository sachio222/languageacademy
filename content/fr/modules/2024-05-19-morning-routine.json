  "concepts": [
    {
      "id": "c-se-reveiller-to-wake",
      "term": "{se réveiller} = to wake up",
      "definition": "A reflexive verb: you wake yourself up.",
      "examples": [
        {
          "fr": "Je me réveille à sept heures.",
          "en": "I wake up at seven."
        },
        {
          "fr": "Tu te réveilles tôt ?",
          "en": "Do you wake up early?"
        }
      ]
    },
    {
      "id": "c-se-lever-to-get",
      "term": "{se lever} = to get up",
      "definition": "Once you are awake, you get up. The e becomes è in {je me lève}.",
      "examples": [
        {
          "fr": "Elle se lève à huit heures.",
          "en": "She gets up at eight."
        },
        {
          "fr": "Tu te lèves tard.",
          "en": "You get up late."
        },
        {
          "fr": "Nous nous levons tôt.",
          "en": "We get up early."
        }
      ]
    },
