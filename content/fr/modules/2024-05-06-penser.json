  "concepts": [
    {
      "id": "c-penser-to-think",
      "term": "{penser} = to think",
      "definition": "The verb for saying what you think.",
      "examples": [
        {
          "fr": "Je pense que c'est bon.",
          "en": "I think it's good."
        },
        {
          "fr": "Les gens pensent ça.",
          "en": "People think that."
        }
      ]
    },
    {
      "id": "c-regular-er-verb",
      "term": "A regular -er verb",
      "definition": "{penser} changes like {parler}.",
      "layout": "forms",
      "examples": [
        {
          "fr": "je pense",
          "en": "I think"
        },
        {
          "fr": "tu penses",
          "en": "you think"
        },
        {
          "fr": "il pense",
          "en": "he thinks"
        },
        {
          "fr": "nous pensons",
          "en": "we think"
        },
        {
          "fr": "vous pensez",
          "en": "you think"
        },
        {
          "fr": "ils pensent",
          "en": "they think"
        }
      ]
    },
    {
      "id": "c-penser-que-to-think",
      "term": "{penser que} = to think that",
      "definition": "Put {que} before what you think. Before a vowel it becomes {qu'}.",
      "examples": [
        {
          "fr": "Je pense que oui.",
          "en": "I think so."
        },
        {
          "fr": "Je pense que non.",
          "en": "I don't think so."
        },
        {
          "fr": "Je pense que je connais Marie.",
          "en": "I think I know Marie."
        },
        {
          "fr": "Je pense qu'il sait parler anglais.",
          "en": "I think he can speak English."
        }
      ]
    },
    {
      "id": "c-penser-a-to-think",
      "term": "{penser à} = to think about",
      "definition": "Put {à} before the person or thing on your mind.",
      "examples": [
        {
          "fr": "Je pense à toi.",
          "en": "I'm thinking about you."
        },
        {
          "fr": "Je pense à ça.",
          "en": "I'm thinking about that."
        }
      ]
    },
    {
      "id": "c-asking-opinions",
      "term": "Asking what someone thinks",
      "definition": "Add {de} before the thing you ask about.",
      "examples": [
        {
          "fr": "Qu'est-ce que tu penses ?",
          "en": "What do you think?"
        },
        {
          "fr": "Qu'est-ce que tu penses de ça ?",
          "en": "What do you think of that?"
        }
      ]
    }
  ],
