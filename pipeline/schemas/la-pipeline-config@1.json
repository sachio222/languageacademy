{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "la-pipeline-config@1",
  "description": "pipeline/<language>/config.json (design section 5.4): engines per role, limits, timeouts, budget, sampling, alerts and the L target. Every key is required and unknown keys are refused, so a misspelt setting cannot fall back to a default.",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "tenant", "branch", "managed_units", "pilot_units", "plan_source", "engines", "api", "limits", "timeouts", "budget", "units", "sampling", "alerts", "l_target"],
  "properties": {
    "schema": { "const": "la-pipeline-config@1" },
    "tenant": { "type": "object", "additionalProperties": false, "required": ["language", "native"],
      "properties": { "language": { "type": "string", "pattern": "^[a-z]{2}$" }, "native": { "type": "string", "pattern": "^[a-z]{2}$" } } },
    "branch": { "type": "string", "pattern": "^pipeline/[a-z]{2}$", "description": "the pipeline's own branch (section 6.4)" },
    "managed_units": { "type": "array", "items": { "$ref": "la-pipeline-common@1#/$defs/unitKey" }, "description": "units the pipeline writes; empty until a unit opens" },
    "pilot_units": { "type": "array", "items": { "$ref": "la-pipeline-common@1#/$defs/unitKey" }, "description": "units whose every module Jake reviews (section 4.7)" },
    "plan_source": { "type": "object", "additionalProperties": false, "required": ["file", "sha256"],
      "description": "the course plan, outside the repository, pinned by hash (section 17 item 7)",
      "properties": { "file": { "type": "string", "minLength": 1 }, "sha256": { "$ref": "la-pipeline-common@1#/$defs/sha256" } } },
    "engines": { "type": "object", "additionalProperties": false, "required": ["draft", "repair", "review"],
      "properties": { "draft": { "$ref": "#/$defs/engine" }, "repair": { "$ref": "#/$defs/engine" }, "review": { "$ref": "#/$defs/reviewEngine" } } },
    "api": { "type": "object", "additionalProperties": false,
      "required": ["models", "max_tokens", "fallbacks", "batch_reviews", "max_concurrency", "prices_usd_per_mtok"],
      "properties": {
        "models": { "type": "object", "required": ["draft", "review"],
          "propertyNames": { "enum": ["draft", "repair", "review", "header"] }, "additionalProperties": { "type": "string", "minLength": 1 } },
        "max_tokens": { "type": "integer", "minimum": 1 },
        "fallbacks": { "type": ["string", "null"], "description": "the API's fallback setting, e.g. default; null for none" },
        "batch_reviews": { "type": "boolean" },
        "max_concurrency": { "type": "integer", "minimum": 1 },
        "prices_usd_per_mtok": { "type": "object", "description": "per model id",
          "additionalProperties": { "type": "object", "additionalProperties": false, "required": ["input", "output", "cache_read"],
            "properties": { "input": { "type": "number", "minimum": 0 }, "output": { "type": "number", "minimum": 0 }, "cache_read": { "type": "number", "minimum": 0 } } } } } },
    "limits": { "type": "object", "additionalProperties": false,
      "required": ["rounds_per_module", "review_repairs", "attempts_per_round", "draft_window", "max_in_flight", "parks_per_unit_before_stop", "jake_queue_max", "jake_queue_oldest_hours", "units_ahead_of_published"],
      "properties": {
        "rounds_per_module": { "type": "integer", "minimum": 1 },
        "review_repairs": { "type": "integer", "minimum": 0 },
        "attempts_per_round": { "type": "integer", "minimum": 1 },
        "draft_window": { "type": "integer", "minimum": 1 },
        "max_in_flight": { "type": "integer", "minimum": 1 },
        "parks_per_unit_before_stop": { "type": "integer", "minimum": 1 },
        "jake_queue_max": { "type": "integer", "minimum": 1 },
        "jake_queue_oldest_hours": { "type": "integer", "minimum": 1 },
        "units_ahead_of_published": { "type": "integer", "minimum": 0 } } },
    "timeouts": { "type": "object", "additionalProperties": false,
      "required": ["draft_task_min", "review_task_min", "check_s", "lock_lease_min", "lock_heartbeat_s"],
      "properties": {
        "draft_task_min": { "type": "integer", "minimum": 1 },
        "review_task_min": { "type": "integer", "minimum": 1 },
        "check_s": { "type": "integer", "minimum": 1 },
        "lock_lease_min": { "type": "integer", "minimum": 1 },
        "lock_heartbeat_s": { "type": "integer", "minimum": 1 } } },
    "budget": { "type": "object", "additionalProperties": false,
      "required": ["applies_to", "usd_per_module", "usd_per_unit", "usd_per_day", "usd_total"],
      "properties": {
        "applies_to": { "const": "api", "description": "dollar ceilings apply under adapter B only (section 5.2)" },
        "usd_per_module": { "type": "number", "minimum": 0 },
        "usd_per_unit": { "type": "number", "minimum": 0 },
        "usd_per_day": { "type": "number", "minimum": 0 },
        "usd_total": { "type": "number", "minimum": 0 } } },
    "units": { "type": "object", "description": "unit kind per unit (section 3.3)",
      "propertyNames": { "$ref": "la-pipeline-common@1#/$defs/unitKey" }, "additionalProperties": { "enum": ["standard", "completion"] } },
    "sampling": { "type": "object", "additionalProperties": false, "required": ["normal", "reduced"],
      "properties": { "normal": { "$ref": "#/$defs/sampleRate" }, "reduced": { "$ref": "#/$defs/sampleRate" } } },
    "alerts": { "type": "object", "additionalProperties": false, "required": ["desktop", "github_issue"],
      "properties": { "desktop": { "type": "boolean" }, "github_issue": { "type": "boolean" } } },
    "l_target": { "type": "object", "additionalProperties": false, "required": ["adapter", "autoload", "root"],
      "properties": {
        "adapter": { "enum": ["prototype"] },
        "autoload": { "type": "boolean", "description": "run L's own loader after delivery; off until Jake says otherwise (section 10.1)" },
        "root": { "type": ["string", "null"], "description": "L's folder, for the prototype adapter" } } }
  },
  "$defs": {
    "adapter": { "enum": ["agent", "api", "fake", "replay"] },
    "effort": { "enum": ["low", "medium", "high", "xhigh", "max", null] },
    "engine": { "type": "object", "additionalProperties": false, "required": ["adapter", "model", "effort"],
      "properties": { "adapter": { "$ref": "#/$defs/adapter" }, "model": { "type": ["string", "null"] }, "effort": { "$ref": "#/$defs/effort" } } },
    "reviewEngine": { "type": "object", "additionalProperties": false, "required": ["adapter", "model", "effort", "second_review_for"],
      "properties": { "adapter": { "$ref": "#/$defs/adapter" }, "model": { "type": ["string", "null"] }, "effort": { "$ref": "#/$defs/effort" },
        "second_review_for": { "type": "array", "items": { "$ref": "la-pipeline-common@1#/$defs/kind" } } } },
    "sampleRate": { "type": "object", "additionalProperties": false, "required": ["rate", "min"],
      "properties": { "rate": { "type": "number", "minimum": 0, "maximum": 1 }, "min": { "type": "integer", "minimum": 0 } } }
  }
}
