{
  "schema": "la-module@1",
  "module_key": "2024-03-24-rhetorical-negative",
  "kind": "lesson",
  "status": "written",
  "title": "Rhetorical & Negative Questions - Advanced Style",
  "description": "Add native sophistication: N'est-ce pas vrai? (Isn't that true?), Comment ne pas aimer ça? (How can you not love that?), Qui ne voudrait pas ça? (Who wouldn't want that?)",
  "teaches": {
    "constructions": [
      "fr:cx:q.negative-inversion",
      "fr:cx:neg.ne-pas-infinitive",
      "fr:cx:chunk.nest-ce-pas"
    ]
  },
  "vocabulary": [
    {
      "word_id": "n-est-ce-pas-vrai-fr",
      "fr": "N'est-ce pas vrai?",
      "gloss": "Isn't that true?",
      "note": "seeking agreement"
    },
    {
      "word_id": "n-est-ce-pas-fr",
      "fr": "N'est-ce pas?",
      "gloss": "Isn't it? / Right?",
      "note": "tag question for confirmation"
    },
    {
      "word_id": "n-es-tu-pas-content-fr",
      "fr": "N'es-tu pas content?",
      "gloss": "Aren't you happy?",
      "note": "negative question with tu"
    },
    {
      "word_id": "n-as-tu-pas-faim-fr",
      "fr": "N'as-tu pas faim?",
      "gloss": "Aren't you hungry?",
      "note": "negative question with avoir"
    },
    {
      "word_id": "ne-veux-tu-pas-essayer-fr",
      "fr": "Ne veux-tu pas essayer?",
      "gloss": "Don't you want to try?",
      "note": "negative question with vouloir"
    },
    {
      "word_id": "comment-ne-pas-aimer-ca-fr",
      "fr": "Comment ne pas aimer ça?",
      "gloss": "How can you not love that?",
      "note": "⭐ rhetorical - implies everyone loves it"
    },
    {
      "word_id": "qui-ne-voudrait-pas-ca-fr",
      "fr": "Qui ne voudrait pas ça?",
      "gloss": "Who wouldn't want that?",
      "note": "⭐ rhetorical - implies everyone wants it"
    },
    {
      "word_id": "pourquoi-ne-pas-essayer-fr",
      "fr": "Pourquoi ne pas essayer?",
      "gloss": "Why not try?",
      "note": "⭐ rhetorical suggestion"
    },
    {
      "word_id": "comment-ne-pas-aimer-le-soleil-fr",
      "fr": "Comment ne pas aimer le soleil?",
      "gloss": "How can one not love the sun?",
      "note": "rhetorical about nature"
    }
  ],
  "concepts": [
    {
      "id": "c-negative-questions-for-agreement",
      "term": "Asking for agreement",
      "definition": "A negative question asks the other person to agree with you.",
      "examples": [
        {
          "fr": "N'est-ce pas vrai ?",
          "en": "Isn't that true?"
        },
        {
          "fr": "N'as-tu pas faim ?",
          "en": "Aren't you hungry?"
        },
        {
          "fr": "N'es-tu pas content ?",
          "en": "Aren't you happy?"
        }
      ]
    },
    {
      "id": "c-rhetorical-questions-for-opinion",
      "term": "Questions that give an opinion",
      "definition": "Some questions expect no answer. They say what you think.",
      "examples": [
        {
          "fr": "Comment ne pas aimer ça ?",
          "en": "How can you not love that?",
          "note": "of course you love it"
        },
        {
          "fr": "Qui ne voudrait pas ça ?",
          "en": "Who wouldn't want that?",
          "note": "everyone wants it"
        }
      ]
    },
    {
      "id": "c-ne-pas-pattern-in",
      "term": "{ne} … {pas} in a question",
      "definition": "With an inverted verb, {ne} comes first and {pas} comes after the pronoun. Before an infinitive, both come first.",
      "examples": [
        {
          "fr": "N'es-tu pas content ?",
          "en": "Aren't you happy?"
        },
        {
          "fr": "Ne veux-tu pas essayer ?",
          "en": "Don't you want to try?"
        },
        {
          "fr": "Comment ne pas aimer le soleil ?",
          "en": "How can you not love the sun?"
        }
      ]
    },
    {
      "id": "c-persuasion-and-emphasis",
      "term": "Making a suggestion",
      "definition": "{Pourquoi ne pas} with a verb suggests doing it.",
      "examples": [
        {
          "fr": "Pourquoi ne pas essayer ?",
          "en": "Why not try?",
          "note": "you should try"
        },
        {
          "fr": "Pourquoi ne pas aller là-bas ?",
          "en": "Why not go there?"
        }
      ]
    },
    {
      "id": "c-native-level-sophistication",
      "term": "From plain to expressive",
      "definition": "The same idea can be a plain question or a question that gives your opinion.",
      "examples": [
        {
          "fr": "Tu aimes ça ?",
          "en": "Do you like that?",
          "note": "plain"
        },
        {
          "fr": "Comment ne pas aimer ça ?",
          "en": "How can you not love that?",
          "note": "expressive"
        }
      ]
    }
  ],
  "items": [
    {
      "id": "i-n-est-ce-pas",
      "type": "respond",
      "situation": "Your friend doubts that French bread is the best. Ask a negative question to get them to agree.",
      "answer": "n'est-ce pas vrai ?",
      "accept": [
        "n'est-ce pas vrai",
        "c'est vrai, n'est-ce pas ?"
      ]
    },
    {
      "id": "i-n-est-ce-pas-2",
      "type": "respond",
      "situation": "Use tag question: 'Isn't it?' / 'Right?'",
      "cue": "Isn't it? / Right?",
      "answer": "n'est-ce pas?",
      "accept": [
        "n'est-ce pas"
      ],
      "hint": "{n'est-ce pas}"
    },
    {
      "id": "i-n-es-tu-pas",
      "type": "transform",
      "instruction": "Ask it with inversion.",
      "shown": "Tu n'es pas content ?",
      "answer": "n'es-tu pas content ?",
      "accept": [
        "n'es-tu pas content",
        "n'es-tu pas contente ?",
        "n'es-tu pas contente"
      ],
      "mistakes": [
        {
          "answer": "ne es-tu pas content ?",
          "feedback": "{ne} becomes {n'} before a vowel: {n'es-tu pas}."
        }
      ]
    },
    {
      "id": "i-n-as-tu-pas",
      "type": "transform",
      "instruction": "Ask it with inversion.",
