    {
      "id": "p-keep-the-article",
      "heading": "Keep the article",
      "text": [
        "Every French noun is masculine or feminine, so learn each cognate with its article, {un} or {une}. French does not drop the article the way English does in “Coffee is good”."
      ],
      "note": "Every time you recognize a cognate, you add a French word without studying it.",
      "blocks": [
        {
          "lines": [
            [
              "J'ai un café.",
              "I have a coffee."
            ],
            [
              "Le café est bon.",
              "Coffee is good."
            ]
          ]
        }
      ]
    }
