      "hint": "tout le monde + comprend (singular verb)"
    },
    {
      "id": "comparison-modifiers-6",
      "type": "translate",
      "prompt": "I know everything",
      "answer": "je sais tout",
      "hint": "je sais + tout (pronoun)"
    }
  ],
  "glosses": [
