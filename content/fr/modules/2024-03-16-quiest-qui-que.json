{
  "schema": "la-module@1",
  "module_key": "2024-03-16-quiest-qui-que",
  "kind": "lesson",
  "status": "written",
  "title": "qui est-ce qui vs qui est-ce que - Master 'Who' Questions",
  "description": "Same pattern as WHAT questions, but for WHO! qui est-ce qui (who DOES - subject) vs qui est-ce que (who DO you - object). Transfer learning!",
  "vocabulary": [
    {
      "word_id": "qui-est-ce-qui-fr",
      "fr": "qui est-ce qui",
      "gloss": "who (subject)",
      "note": "⭐ SUBJECT: who DOES something"
    },
    {
      "word_id": "qui-est-ce-que-fr",
      "fr": "qui est-ce que",
      "gloss": "who (object)",
      "note": "⭐ OBJECT: who DO you verb"
    },
    {
      "word_id": "qui-est-ce-qui-parle-fr",
      "fr": "Qui est-ce qui parle?",
      "gloss": "Who speaks?",
      "note": "SUBJECT question - person is doing the speaking"
    },
    {
      "word_id": "qui-est-ce-qui-fait-ca-fr",
      "fr": "Qui est-ce qui fait ça?",
      "gloss": "Who does that?",
      "note": "SUBJECT question - person is doing that"
    },
    {
      "word_id": "qui-est-ce-qui-nage-fr",
      "fr": "Qui est-ce qui nage?",
      "gloss": "Who swims?",
      "note": "SUBJECT question - person is swimming"
    },
    {
      "word_id": "qui-est-ce-qui-parle-francais-fr",
      "fr": "Qui est-ce qui parle français?",
      "gloss": "Who speaks French?",
      "note": "SUBJECT question"
    },
    {
      "word_id": "qui-est-ce-que-tu-vois-fr",
      "fr": "Qui est-ce que tu vois?",
      "gloss": "Who do you see?",
      "note": "OBJECT question - you are seeing WHOM"
    },
    {
      "word_id": "qui-est-ce-que-tu-aimes-fr",
      "fr": "Qui est-ce que tu aimes?",
      "gloss": "Who do you like?",
      "note": "OBJECT question - you are liking WHOM"
    },
    {
      "word_id": "qui-est-ce-que-je-dois-appeler-fr",
      "fr": "Qui est-ce que je dois appeler?",
      "gloss": "Who should I call?",
      "note": "OBJECT question - I should call WHOM"
    },
    {
      "word_id": "qui-est-ce-que-tu-connais-fr",
      "fr": "Qui est-ce que tu connais?",
      "gloss": "Who do you know?",
      "note": "OBJECT question - you know WHOM"
    }
  ],
  "concepts": [
    {
      "id": "c-same-pattern-as-qu",
      "term": "Same Pattern as qu'est-ce qui/{que!}",
      "definition": "You already know this pattern from the qu'est-ce qui module - just change WHAT to WHO!",
      "example": "{qu'est-ce qui} → {qui est-ce qui} (what DOES → who DOES), {qu'est-ce que} → {qui est-ce que} (what DO you → who DO you)"
    },
    {
      "id": "c-qui-est-ce-qui",
      "term": "{qui est-ce qui} - Subject Questions",
      "definition": "Use QUI when asking WHO is doing the action. No other subject after qui!",
      "example": "{Qui est-ce qui parle?} (Who speaks?), {Qui est-ce qui fait ça?} (Who does that?), {Qui est-ce qui nage?} (Who swims?)"
    },
    {
      "id": "c-qui-est-ce-que",
      "term": "{qui est-ce que} - Object Questions",
      "definition": "Use QUE when asking who someone DOES something to. Subject comes after que!",
      "example": "{Qui est-ce que tu vois?} (Who do you see?), {Qui est-ce que tu aimes?} (Who do you like?), {Qui est-ce que je dois appeler?} (Who should I call?)"
    },
    {
      "id": "c-transfer-learning-from-qu",
      "term": "Transfer Learning from qu'est-ce qui Module",
      "definition": "You mastered qu'est-ce qui/que discrimination - same rule applies here!",
      "example": "Subject (thing doing action) → QUI. Object (thing receiving action) → {QUE}"
    }
  ],
  "items": [
