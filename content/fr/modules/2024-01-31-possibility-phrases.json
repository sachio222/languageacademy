  ],
  "concepts": [
    {
      "id": "c-il-est-possible-que",
      "term": "{il est possible que}: it might happen",
      "definition": "It says something might happen. The verb after it takes the special form.",
      "examples": [
        {
          "fr": "Il est possible qu'il vienne.",
          "en": "He might come."
        },
        {
          "fr": "Il est possible qu'on parte.",
          "en": "We might leave."
        }
      ]
    },
    {
      "id": "c-peut-etre-maybe",
      "term": "{peut-être} = maybe",
      "definition": "A quick way to say you are not sure. With {que} after it, the verb keeps its ordinary form.",
      "examples": [
        {
          "fr": "Peut-être qu'il viendra.",
          "en": "Maybe he'll come."
        },
        {
          "fr": "Peut-être demain.",
          "en": "Maybe tomorrow."
        },
        {
          "fr": "Peut-être pas.",
          "en": "Maybe not."
        }
      ]
    },
    {
      "id": "c-planning-and-hedging",
      "term": "Keeping plans open",
      "definition": "These phrases leave room to change a plan.",
      "examples": [
        {
          "fr": "Il est possible qu'on parte demain.",
          "en": "We might leave tomorrow."
        },
        {
          "fr": "Il se peut qu'il vienne.",
          "en": "He may come."
        }
      ]
    }
  ],
  "items": [
