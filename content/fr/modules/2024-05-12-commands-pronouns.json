{
  "schema": "la-module@1",
  "module_key": "2024-05-12-commands-pronouns",
  "kind": "lesson",
  "status": "written",
  "title": "Commands with Pronouns",
  "description": "Give commands with objects: Donne-le-moi! (Give it to me!), Regarde-moi! (Look at me!), Ne le fais pas! (Don't do it!)",
  "can_do": [
    "Give commands with object pronouns (Give it to me!)",
    "Use pronouns with affirmative and negative commands",
    "Form complex commands like 'Don't do it!' or 'Look at me!'",
    "Say some or how many with {en}: {j'en veux}, {j'en ai trois}."
  ],
  "teaches": {
    "constructions": [
      "fr:cx:imperative.pronouns",
      "fr:cx:pronoun.en"
    ]
  },
  "vocabulary": [
    {
      "word_id": "donne-le-moi-fr",
      "fr": "Donne-le-moi!",
      "gloss": "Give it to me!",
      "note": "⭐ command + object + indirect"
    },
    {
      "word_id": "montre-la-moi-fr",
      "fr": "Montre-la-moi!",
      "gloss": "Show it to me!",
      "note": "from {montrer} (to show); {la} before {moi}"
    },
    {
      "word_id": "regarde-moi-fr",
      "fr": "Regarde-moi!",
      "gloss": "Look at me!",
      "note": "command + moi"
    },
    {
      "word_id": "ecoute-le-fr",
      "fr": "Écoute-le!",
      "gloss": "Listen to him!",
      "note": "command + object"
    },
    {
      "word_id": "ne-le-fais-pas-fr",
      "fr": "Ne le fais pas!",
      "gloss": "Don't do it!",
      "note": "⭐ negative command"
    },
    {
      "word_id": "ne-me-regarde-pas-fr",
      "fr": "Ne me regarde pas!",
      "gloss": "Don't look at me!",
      "note": "negative with me"
    }
  ],
  "concepts": [
    {
      "id": "c-affirmative-commands-attach-with",
      "term": "Pronouns after the verb",
      "definition": "In a positive command, the pronoun comes after the verb, joined with a hyphen.",
      "examples": [
        {
          "fr": "Donne-le !",
          "en": "Give it!"
        },
        {
          "fr": "Regarde-moi !",
          "en": "Look at me!"
        },
        {
          "fr": "Écoute-le !",
          "en": "Listen to him!"
        },
        {
          "fr": "Amuse-toi bien !",
          "en": "Have fun!"
        },
        {
          "fr": "Dépêche-toi, habille-toi !",
          "en": "Hurry up, get dressed!"
        },
        {
          "fr": "Regarde-moi et fais attention !",
          "en": "Look at me and pay attention!"
        }
      ]
    },
    {
      "id": "c-negative-commands-separate-with",
      "term": "Pronouns in a negative command",
      "definition": "With {ne} … {pas}, the pronoun goes back before the verb.",
      "examples": [
        {
          "fr": "Ne le fais pas !",
          "en": "Don't do it!"
        },
        {
          "fr": "Ne me regarde pas !",
          "en": "Don't look at me!"
        }
      ]
    },
    {
      "id": "c-pronoun-order-in-commands",
      "term": "Two pronouns",
      "definition": "With two pronouns, the one for the thing comes first, then {moi}.",
      "examples": [
        {
          "fr": "Donne-le-moi !",
          "en": "Give it to me!"
        },
        {
          "fr": "Montre-la-moi !",
          "en": "Show it to me!"
        }
      ]
    },
    {
      "id": "c-en-some",
      "term": "{en}: some, of them",
      "definition": "{en} stands for some of a thing you already named. It goes before the verb, but after it in a positive command.",
      "examples": [
        {
          "fr": "Tu veux du café ? Oui, j'en veux.",
          "en": "Do you want some coffee? Yes, I'd like some."
        },
        {
          "fr": "Oui, j'en ai trois.",
          "en": "Yes, I have three of them."
        },
        {
          "fr": "Prends-en !",
          "en": "Take some!"
        }
      ]
    }
  ],
  "items": [
    {
      "id": "cmd-pron-1",
      "type": "respond",
      "situation": "Command: 'Give it!' (informal - it = masculine)",
      "cue": "Give it! (le)",
      "answer": "donne-le",
      "accept": [
        "donne le"
      ],
      "hint": "Donne + le with hyphen"
    },
    {
      "id": "cmd-pron-2",
      "type": "respond",
      "situation": "Command: 'Look at me!' (informal)",
      "cue": "Look at me!",
      "answer": "regarde-moi",
      "accept": [
        "regarde moi"
      ],
      "hint": "Regarde + moi with hyphen"
    },
    {
      "id": "cmd-pron-3",
      "type": "respond",
      "situation": "Command: 'Listen to him!' (informal)",
      "cue": "Listen to him!",
      "answer": "écoute-le",
      "accept": [
        "ecoute-le",
        "ecoute le"
      ],
      "hint": "Écoute + le with hyphen"
    },
    {
      "id": "cmd-pron-4",
      "type": "respond",
      "situation": "Negative command: 'Don't do it!' (informal)",
      "cue": "Don't do it!",
      "answer": "ne le fais pas",
      "hint": "Ne + le + fais + pas (pronoun BEFORE verb in negative)",
      "mistakes": [
        {
          "answer": "ne fais pas le",
          "feedback": "In negative commands, pronoun goes BEFORE: Ne le fais pas!"
        }
      ]
    },
    {
      "id": "cmd-pron-5",
      "type": "respond",
      "situation": "Command: 'Give it to me!' (informal, it = le)",
      "cue": "Give it to me!",
      "answer": "donne-le-moi",
      "accept": [
        "donne le moi"
      ],
      "hint": "Donne-le-moi! (verb-object-recipient)"
    },
    {
      "id": "i-oui-j-en-veux",
      "type": "respond",
      "situation": "A friend asks {Tu veux du café ?} Say yes, you want some. Use {en}.",
      "answer": "oui, j'en veux",
      "accept": [
        "j'en veux",
        "oui j en veux",
        "j en veux",
        "oui, j'en veux bien"
      ],
      "hint": "{en} goes before the verb",
      "mistakes": [
        {
          "answer": "oui, je veux en",
          "feedback": "{en} goes before the verb: {j'en veux}."
        }
      ]
    },
    {
      "id": "i-oui-j-en-ai-trois",
      "type": "respond",
      "situation": "A friend asks {Tu as des livres ?} Say yes, you have three. Use {en}.",
      "answer": "oui, j'en ai trois",
      "accept": [
        "j'en ai trois",
        "oui j en ai trois",
        "j en ai trois"
      ],
      "hint": "{en} before the verb, the number at the end",
      "mistakes": [
        {
          "answer": "oui, j'ai trois",
          "feedback": "Keep {en} before the verb, even with a number: {j'en ai trois}."
        }
      ]
    },
    {
      "id": "i-prends-en",
      "type": "respond",
      "situation": "Offer a friend some of your bread. Say “Take some!” with {en}.",
      "answer": "prends-en",
      "accept": [
        "prends en"
      ],
      "hint": "Like {donne-le}: the pronoun goes after the verb, with a hyphen",
      "mistakes": [
        {
          "answer": "en prends",
          "feedback": "In a positive command, {en} goes after the verb: {prends-en}."
        }
      ]
    }
  ]
}
