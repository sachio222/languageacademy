  "title": "Reciprocal Reflexives - Each Other",
  "description": "Express mutual actions: nous nous aimons (we love each other), ils se parlent (they talk to each other), on se voit (we see each other)",
  "can_do": [
    "Express mutual actions (we love each other, they see each other)",
    "Talk about reciprocal relationships",
    "Use reflexive pronouns for 'each other' meanings"
  ],
  "teaches": {
    "constructions": [
      "fr:cx:reciprocal"
    ]
  },
  "vocabulary": [
    {
      "word_id": "nous-nous-aimons-fr",
      "fr": "nous nous aimons",
      "gloss": "we love each other",
      "note": "⭐ reciprocal - mutual love"
    },
    {
      "word_id": "nous-nous-parlons-fr",
      "fr": "nous nous parlons",
      "gloss": "we talk to each other",
      "note": "mutual conversation"
    },
    {
      "word_id": "on-se-voit-fr",
      "fr": "on se voit",
      "gloss": "we see each other",
      "note": "⭐ very common!"
    },
    {
      "word_id": "on-se-voit-demain-fr",
      "fr": "on se voit demain",
      "gloss": "we'll see each other tomorrow",
      "note": "making plans"
    },
    {
      "word_id": "ils-se-connaissent-fr",
      "fr": "ils se connaissent",
      "gloss": "they know each other",
      "note": "acquaintances"
    },
    {
      "word_id": "ils-se-parlent-fr",
      "fr": "ils se parlent",
      "gloss": "they talk to each other",
      "note": "communication"
    },
    {
      "word_id": "vous-vous-comprenez-fr",
      "fr": "vous vous comprenez",
      "gloss": "you understand each other",
      "note": "mutual understanding"
    }
  ],
  "concepts": [
    {
      "id": "c-reciprocal-each-other",
      "term": "Each other",
      "definition": "With a plural subject, the reflexive pronoun can mean each other.",
      "examples": [
        {
          "fr": "Nous nous aimons.",
          "en": "We love each other."
        },
        {
          "fr": "Ils se regardent.",
          "en": "They look at each other."
        }
      ]
    },
    {
      "id": "c-only-with-plural-subjects",
      "term": "Plural subjects only",
      "definition": "Each other needs at least two people, so the subject is plural, or {on} meaning we.",
      "examples": [
        {
          "fr": "Nous nous parlons.",
          "en": "We talk to each other."
        },
        {
          "fr": "Ils se connaissent.",
          "en": "They know each other."
        },
        {
          "fr": "Vous vous comprenez.",
          "en": "You understand each other."
        }
      ]
    },
    {
      "id": "c-same-form-different-meaning",
      "term": "Ourselves or each other",
      "definition": "The form is the same for both meanings. The situation tells you which one is meant.",
      "examples": [
        {
          "fr": "Nous nous préparons.",
          "en": "We're getting ready.",
          "note": "or: we're getting each other ready"
        },
        {
          "fr": "Ils se voient.",
          "en": "They see each other.",
          "note": "or: they see themselves"
        }
      ]
    },
    {
      "id": "c-common-reciprocal-expressions",
      "term": "Seeing and talking to each other",
      "definition": "You hear these between friends all the time.",
      "examples": [
        {
          "fr": "On se voit demain.",
          "en": "See you tomorrow."
        },
        {
          "fr": "Ils se parlent.",
          "en": "They talk to each other."
        }
      ]
    }
  ],
  "items": [
    {
