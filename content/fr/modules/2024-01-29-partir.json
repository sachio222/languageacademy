      ]
    },
    {
      "id": "i-je-peux-partir-avec-vous",
      "type": "respond",
      "hint": "{je peux partir + de ça}",
      "situation": "Your teacher is leaving too. Tell her you can leave with her, politely.",
      "cue": "I can leave with you",
      "answer": "je peux partir avec vous",
      "accept": [
        "je peux partir avec toi"
      ],
      "mistakes": [
        {
          "answer": "je peux pars avec vous",
          "feedback": "After {peux}, the verb stays whole: {partir}."
        }
      ]
    },
    {
      "id": "i-je-vais-partir-en-normandie",
      "type": "respond",
      "hint": "{je vais partir + de ça}",
      "situation": "A friend asks about your summer.",
      "cue": "I'm going to leave for Normandy",
      "answer": "je vais partir en Normandie",
      "mistakes": [
        {
          "answer": "je vais pars en Normandie",
          "feedback": "After {vais}, the verb stays whole: {partir}."
        }
      ]
    },
    {
      "id": "i-quand-tu-vas-partir",
      "type": "respond",
      "hint": "{qu'est-ce que tu vas partir}",
      "situation": "Your friend says she is going away. Ask her when.",
      "cue": "When are you going to leave?",
      "answer": "quand est-ce que tu vas partir ?",
      "accept": [
        "quand vas-tu partir ?",
        "tu vas partir quand ?"
      ],
      "mistakes": [
        {
          "answer": "quand est-ce que tu vas pars ?",
          "feedback": "After {vas}, the verb stays whole: {partir}."
