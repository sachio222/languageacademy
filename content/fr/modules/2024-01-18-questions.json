{
  "schema": "la-module@1",
  "module_key": "2024-01-18-questions",
  "kind": "lesson",
  "status": "written",
  "title": "Question Words - Ask Anything!",
  "description": "The power to ask questions! How, what, where, when, who, why - unlock conversations.",
  "can_do": [
    "Ask questions with where, what, when, who, how, why",
    "Say 'Where is the book?' or 'What do you want?'",
    "Have actual two-way conversations in French"
  ],
  "teaches": {
    "constructions": [
      "fr:cx:q.est-ce-que",
      "fr:cx:q.intonation",
      "fr:cx:q.inversion",
      "fr:cx:q.words",
      "fr:cx:q.quest-ce-que",
      "fr:cx:chunk.quest-ce-que-cest",
      "fr:cx:chunk.comment-ca-va",
      "fr:cx:chunk.ca-va"
    ]
  },
  "vocabulary": [
    {
      "word_id": "que-quoi-fr",
      "fr": "que / quoi",
      "gloss": "what",
      "note": "most common question"
    },
    {
      "word_id": "qui-fr",
      "fr": "qui",
      "gloss": "who",
      "note": "ask about people"
    },
    {
      "word_id": "ou-fr.where",
      "fr": "où",
      "gloss": "where",
      "note": "with accent!"
    },
    {
      "word_id": "quand-fr",
      "fr": "quand",
      "gloss": "when",
      "note": "ask about time"
    },
    {
      "word_id": "comment-fr",
      "fr": "comment",
      "gloss": "how",
      "note": "ask about method"
    },
    {
      "word_id": "pourquoi-fr",
      "fr": "pourquoi",
      "gloss": "why",
      "note": "ask for reasons"
    },
    {
      "word_id": "combien-fr",
      "fr": "combien",
      "gloss": "how much/many",
      "note": "ask about quantity/price"
    },
    {
      "word_id": "combien-de-fr",
      "fr": "combien de",
      "gloss": "how many / how much"
    },
    {
      "word_id": "quel-quelle-fr",
      "fr": "quel/quelle",
      "gloss": "which/what",
      "note": "agrees with noun: quel livre? quelle maison?"
    },
    {
      "word_id": "est-ce-que-fr",
      "fr": "est-ce que",
      "gloss": "question maker",
      "note": "put before statement to make question"
    },
    {
      "word_id": "qu-est-ce-que-c-est-fr",
      "fr": "qu'est-ce que c'est",
      "gloss": "what is it?",
      "note": "fixed phrase - memorize!"
    },
    {
      "word_id": "comment-ca-va-fr",
      "fr": "comment ça va",
      "gloss": "how's it going?",
      "note": "informal greeting"
    },
    {
      "word_id": "ca-va-fr.question",
      "fr": "ça va?",
      "gloss": "you good?",
      "note": "super informal"
    },
    {
      "word_id": "qu-est-ce-que-tu-veux-fr",
      "fr": "qu'est-ce que tu veux",
      "gloss": "what do you want?",
      "note": "essential question"
    },
    {
      "word_id": "est-ce-que-tu-peux-fr",
      "fr": "est-ce que tu peux",
      "gloss": "can you?",
      "note": "asking for ability/permission"
    }
  ],
  "concepts": [
    {
      "id": "c-three-ways-to-ask",
      "term": "Three ways to ask a question",
      "definition": "French can ask the same question three ways. In speech the easiest are {est-ce que} and a rising voice.",
      "examples": [
        {
          "fr": "Est-ce que tu as un chat ?",
          "en": "Do you have a cat?",
          "note": "with {est-ce que}"
        },
        {
          "fr": "Tu as un chat ?",
          "en": "Do you have a cat?",
          "note": "with your voice rising"
        },
        {
          "fr": "As-tu un chat ?",
          "en": "Do you have a cat?",
          "note": "with the verb first, more formal"
        }
      ]
    },
    {
      "id": "c-method-1-est-ce",
      "term": "{Est-ce que}",
      "definition": "Put {est-ce que} before a statement to make it a question. The other words keep their order.",
      "examples": [
        {
          "fr": "Est-ce que tu veux un café ?",
          "en": "Do you want a coffee?"
        },
        {
          "fr": "Est-ce que vous voyez la maison ?",
          "en": "Do you see the house?"
        }
      ]
    },
    {
      "id": "c-with-question-words-est",
      "term": "A question word and {est-ce que}",
      "definition": "Put the question word first, then {est-ce que}, then the statement.",
      "examples": [
        {
          "fr": "Où est-ce que tu es ?",
          "en": "Where are you?"
        },
        {
          "fr": "Pourquoi est-ce que tu veux ça ?",
          "en": "Why do you want that?"
        },
        {
          "fr": "Qu'est-ce que tu veux ?",
          "en": "What do you want?"
        }
      ]
    },
    {
      "id": "c-method-2-rising-intonation",
      "term": "A rising voice",
      "definition": "Say the statement and let your voice rise at the end. It is the most common way to ask in conversation.",
      "examples": [
        {
          "fr": "Tu as un chat ?",
          "en": "You have a cat?"
        },
        {
          "fr": "Tu es où ?",
          "en": "Where are you?"
        },
        {
          "fr": "Ça va ?",
          "en": "Are you OK?"
        }
      ]
    },
    {
      "id": "c-method-3-inversion-formal",
      "term": "The verb first",
      "definition": "Put the verb before the pronoun and join them with a hyphen. It sounds formal and is used most in writing.",
      "examples": [
        {
          "fr": "As-tu un chat ?",
          "en": "Do you have a cat?"
        },
        {
          "fr": "Où es-tu ?",
          "en": "Where are you?"
        },
        {
          "fr": "Que veux-tu ?",
          "en": "What do you want?"
        }
      ]
    },
    {
      "id": "c-the-7-essential-question",
      "term": "Question words",
      "definition": "These words ask who, where, when, how, why, and how much or how many.",
      "examples": [
        {
          "fr": "qui",
          "en": "who"
        },
        {
          "fr": "où",
          "en": "where"
        },
        {
          "fr": "quand",
          "en": "when"
        },
        {
          "fr": "comment",
          "en": "how"
        },
        {
          "fr": "pourquoi",
          "en": "why"
        },
        {
          "fr": "combien",
          "en": "how much, how many"
        }
      ]
    },
    {
      "id": "c-que-vs-quoi-both",
      "term": "{que} and {quoi}: what",
      "definition": "{Que} starts a question. {Quoi} ends one or stands on its own.",
      "examples": [
        {
          "fr": "Que veux-tu ?",
          "en": "What do you want?"
        },
        {
          "fr": "Tu veux quoi ?",
          "en": "You want what?"
        },
        {
          "fr": "Quoi ?",
          "en": "What?"
        }
      ]
    },
    {
      "id": "c-common-question-phrases-memorize",
      "term": "Questions to learn whole",
      "definition": "Some questions are so common that people say them as one block.",
      "examples": [
        {
          "fr": "Qu'est-ce que c'est ?",
          "en": "What is it?"
        },
        {
          "fr": "Comment ça va ?",
          "en": "How are you?"
        },
        {
          "fr": "Qu'est-ce que tu veux ?",
          "en": "What do you want?"
        },
        {
          "fr": "Est-ce que tu peux ?",
          "en": "Can you?"
        }
      ]
    }
  ],
  "items": [
    {
      "id": "i-que",
      "type": "respond",
      "situation": "You see an object and don't know what it is. Ask this question word",
      "cue": "what",
      "answer": "que",
      "hint": "Most common question word - que or quoi",
      "mistakes": [
        {
          "answer": "qui",
          "feedback": "That means 'who', not 'what'"
        },
        {
          "answer": "où",
          "feedback": "That means 'where', not 'what'"
        }
      ]
    },
    {
      "id": "i-qui",
      "type": "respond",
      "situation": "Someone's at the door. Ask which person it is",
      "cue": "who",
      "answer": "qui",
      "hint": "Used to ask about people",
      "mistakes": [
        {
          "answer": "que",
          "feedback": "That means 'what', not 'who'"
        },
        {
          "answer": "quoi",
          "feedback": "That means 'what', not 'who'"
        }
      ]
    },
    {
      "id": "i-ou",
      "type": "respond",
      "situation": "You can't find your cat. Ask about location",
      "cue": "where",
      "answer": "où",
      "hint": "Remember the accent: où",
      "mistakes": [
        {
          "answer": "ou",
          "feedback": "Need accent: où, not 'ou' (which means 'or')"
        }
      ]
    },
    {
      "id": "i-quand",
      "type": "respond",
      "situation": "You want to know the time. Ask about timing",
      "cue": "when",
      "answer": "quand",
      "hint": "Sounds like 'con' in English",
      "mistakes": [
        {
          "answer": "comment",
          "feedback": "That means 'how', not 'when'"
        }
      ]
    },
    {
      "id": "i-comment",
      "type": "respond",
      "situation": "You don't understand a process. Ask about the method",
      "cue": "how",
      "answer": "comment",
      "hint": "Longer word, sounds like English 'comment'",
      "mistakes": [
        {
          "answer": "quand",
          "feedback": "That means 'when', not 'how'"
        }
      ]
    },
    {
      "id": "i-pourquoi",
      "type": "respond",
      "situation": "You want to know the reason. Ask this question",
      "cue": "why",
      "answer": "pourquoi",
      "hint": "Compound word literally meaning 'for what'",
      "mistakes": [
        {
          "answer": "comment",
          "feedback": "That means 'how', not 'why'"
        }
      ]
    },
    {
      "id": "i-combien",
      "type": "respond",
      "situation": "You want to know the quantity or price. Ask 'how much' or 'how many'",
      "cue": "how much/many",
      "answer": "combien",
      "hint": "Essential for shopping and counting",
      "mistakes": [
        {
          "answer": "comment",
          "feedback": "That means 'how', not 'how much'"
        },
        {
          "answer": "quand",
          "feedback": "That means 'when', not 'how much'"
        }
      ]
    },
    {
      "id": "i-qu-est-ce-que",
      "type": "respond",
      "situation": "Someone shows you an object you don't recognize. Ask what it is",
      "cue": "What is it?",
      "answer": "qu'est-ce que c'est",
      "hint": "Very common phrase - check vocab table for full expression!"
    },
    {
      "id": "i-comment-ca-va",
      "type": "respond",
      "situation": "Greet a friend and ask how they're doing (informal)",
      "cue": "How are you?",
      "answer": "comment ça va",
      "hint": "Very common greeting combining 'how' + 'that/it' + 'goes'"
    },
    {
      "id": "i-ou-est-ce",
      "type": "respond",
      "situation": "You're looking for something. Ask about its location",
      "cue": "Where is it?",
      "answer": "où est-ce",
      "hint": "Combine 'where' + est-ce - remember the accent!",
      "mistakes": [
        {
          "answer": "ou est-ce",
          "feedback": "Use où with an accent, not 'ou'"
        }
      ]
    },
    {
      "id": "i-est-ce-que-tu",
      "type": "respond",
      "situation": "Turn this statement into a question using est-ce que: \"{tu as un chat}\"",
      "cue": "do you have a cat?",
      "answer": "est-ce que tu as un chat",
      "hint": "Add est-ce que before the statement: est-ce que + tu as un chat",
      "mistakes": [
        {
          "answer": "tu as un chat",
          "feedback": "Need to add '{est-ce que}' at the beginning!"
        }
      ]
    },
    {
      "id": "i-ou-est-ce-que",
      "type": "respond",
      "situation": "Ask \"where are you?\" using où + est-ce que method",
      "cue": "where are you?",
      "answer": "où est-ce que tu es",
      "hint": "{où + est-ce que + tu es}",
      "mistakes": [
        {
          "answer": "où tu es",
          "feedback": "Add '{est-ce que}' between où and tu es"
        },
        {
          "answer": "ou est-ce que tu es",
          "feedback": "Use où (with accent), not 'ou' (which means 'or')"
        }
      ]
    },
    {
      "id": "i-quand-est-ce-que",
      "type": "respond",
      "situation": "Ask \"when do you have the book?\" using quand + est-ce que",
      "cue": "when do you have the book?",
      "answer": "quand est-ce que tu as le livre",
      "hint": "{quand + est-ce que + tu as le livre}",
      "mistakes": [
        {
          "answer": "quand tu as le livre",
          "feedback": "Add '{est-ce que}' between quand and tu as"
        }
      ]
    },
    {
      "id": "i-est-ce-que-elle",
      "type": "respond",
      "situation": "Ask \"is she a woman?\" using est-ce que method",
      "cue": "is she a woman?",
      "answer": "est-ce que elle est une femme",
      "accept": [
        "est-ce qu'elle est une femme"
      ],
      "hint": "{est-ce que + elle est une femme}",
      "mistakes": [
        {
          "answer": "elle est une femme",
          "feedback": "Add '{est-ce que}' at the beginning to make it a question!"
        }
      ]
    },
    {
      "id": "i-combien-est-ce",
      "type": "respond",
      "situation": "You're shopping and want to know the price. Ask \"how much is it?\" using combien",
      "cue": "how much is it?",
      "answer": "combien est-ce",
      "accept": [
        "c'est combien"
      ],
      "hint": "combien + est-ce - a very useful shopping phrase!",
      "mistakes": [
        {
          "answer": "comment est-ce",
          "feedback": "Use '{combien}' for quantity/price, not 'comment'"
        }
      ]
    },
    {
      "id": "i-combien-est-ce-que",
      "type": "respond",
      "situation": "Ask \"how many books do you have?\" using combien + est-ce que",
      "cue": "how many books do you have?",
      "answer": "combien est-ce que tu as de livres",
      "accept": [
        "combien de livres est-ce que tu as"
      ],
      "hint": "combien + est-ce que + tu as de livres (de = of)",
      "mistakes": [
        {
          "answer": "comment est-ce que tu as de livres",
          "feedback": "Use '{combien}' for counting, not 'comment'"
        }
      ]
    },
    {
      "id": "i-quel-livre",
      "type": "respond",
      "situation": "Ask 'which book?' (masculine noun)",
      "cue": "which book?",
      "answer": "quel livre",
      "hint": "quel + masculine noun",
      "mistakes": [
        {
          "answer": "quelle livre",
          "feedback": "livre is masculine, use '{quel}' not 'quelle'"
        },
        {
          "answer": "que livre",
          "feedback": "Use '{quel}' for 'which', not 'que'"
        }
      ]
    },
    {
      "id": "i-quelle-maison",
      "type": "respond",
      "situation": "Ask 'which house?' (feminine noun)",
      "cue": "which house?",
      "answer": "quelle maison",
      "hint": "quelle + feminine noun",
      "mistakes": [
        {
          "answer": "quel maison",
          "feedback": "maison is feminine, use '{quelle}' not 'quel'"
        },
        {
          "answer": "que maison",
          "feedback": "Use '{quelle}' for 'which', not 'que'"
        }
      ]
    },
    {
      "id": "i-quel-chat-est-ce",
      "type": "respond",
      "situation": "Ask 'which cat do you want?' (masculine)",
      "cue": "which cat do you want?",
      "answer": "quel chat est-ce que tu veux",
      "accept": [
        "quel chat tu veux"
      ],
      "hint": "{quel + chat + est-ce que + tu veux}",
      "mistakes": [
        {
          "answer": "quelle chat est-ce que tu veux",
          "feedback": "chat is masculine, use '{quel}' not 'quelle'"
        }
      ]
    }
  ]
}
