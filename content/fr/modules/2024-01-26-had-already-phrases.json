      "gloss": "I had already eaten",
      "note": "⭐ very common!"
    },
    {
      "word_id": "j-etais-deja-parti-fr",
      "fr": "j'étais déjà parti",
      "gloss": "I had already left",
      "note": "explaining absence"
    },
    {
      "word_id": "elle-etait-deja-partie-fr",
      "fr": "elle était déjà partie",
      "gloss": "she had already left",
      "note": "she left first"
    },
    {
      "word_id": "j-avais-deja-vu-ce-film-fr",
