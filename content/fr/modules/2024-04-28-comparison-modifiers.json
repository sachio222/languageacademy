      "gloss": "everyone / everybody",
      "note": "⭐⭐⭐ fixed expression!"
    },
    {
      "word_id": "toute-la-classe-fr",
      "fr": "toute la classe",
      "gloss": "the whole class",
      "note": "feminine '{toute}' + la classe"
    },
    {
      "word_id": "tout-petit-fr",
      "fr": "tout petit",
      "gloss": "very small",
      "note": "adverb use - intensifier"
    },
    {
      "word_id": "meme-fr",
      "fr": "même",
      "gloss": "same",
      "note": "rank 85 - comparison"
    },
    {
      "word_id": "le-la-meme-fr",
      "fr": "le/la même",
      "gloss": "the same (one)",
