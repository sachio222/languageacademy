  "sections": [
    {
      "id": "s-la-francophonie-the-french",
      "heading": "{la Francophonie}: the French-speaking world",
      "text": "About 300 million people speak French, and it is an official language in 29 countries.",
      "layout": "plain",
      "examples": [
        {
          "text": "The fifth most spoken language in the world"
        },
        {
          "text": "The second most studied language"
        },
        {
          "text": "An official language of the UN, the EU, NATO and the Olympic Games"
        }
      ]
    },
    {
      "id": "s-europe-where-it-all",
      "heading": "Europe, where French began",
      "text": "French is spoken in five European countries, three of them with other languages beside it.",
      "examples": [
        {
          "fr": "la France",
          "en": "France",
          "note": "67 million people"
        },
        {
          "fr": "la Belgique",
          "en": "Belgium",
          "note": "11.5 million people; Dutch and German are spoken too"
        },
        {
          "fr": "la Suisse",
          "en": "Switzerland",
          "note": "8.6 million people; German and Italian are spoken too"
        },
        {
          "fr": "le Luxembourg",
          "en": "Luxembourg",
          "note": "632,000 people"
        },
        {
          "fr": "Monaco",
          "en": "Monaco",
          "note": "39,000 people"
        }
      ]
    },
    {
      "id": "s-north-america-quebec-haiti",
      "heading": "North America and Haiti",
      "text": "French is spoken in Quebec, a province of Canada, and in Haiti, beside Haitian Creole.",
      "examples": [
        {
          "fr": "le Québec",
          "en": "Quebec",
          "note": "7.9 million people; its motto is {Je me souviens}, I remember"
        },
        {
          "fr": "Haïti",
          "en": "Haiti",
          "note": "11.4 million people; French and Creole"
        },
        {
          "fr": "la Louisiane",
          "en": "Louisiana",
          "note": "about 200,000 speakers"
        },
        {
          "fr": "Saint-Pierre-et-Miquelon",
          "en": "Saint Pierre and Miquelon",
          "note": "6,000 people; part of France"
        }
      ]
    },
    {
      "id": "s-africa-the-future-of",
      "heading": "Africa",
      "text": "About 60% of the world's French speakers live in Africa, and their number grows fast.",
      "layout": "plain",
      "examples": [
        {
          "text": "By 2050, about 85% of French speakers may live in Africa"
        },
        {
          "text": "The Democratic Republic of the Congo is set to pass France as the largest French-speaking country"
        }
      ]
    },
    {
      "id": "s-west-africa-french-belt",
      "heading": "West Africa",
      "text": "French is spoken across West Africa, in government, schools and business.",
      "examples": [
        {
          "fr": "le Sénégal",
          "en": "Senegal",
          "note": "16 million people"
        },
        {
          "fr": "la Côte d'Ivoire",
          "en": "Ivory Coast",
          "note": "26 million people; the region's business center"
        },
        {
          "fr": "le Mali",
          "en": "Mali",
          "note": "20 million people"
        },
        {
          "fr": "le Burkina Faso",
          "en": "Burkina Faso",
          "note": "21 million people"
        },
        {
          "fr": "le Niger",
          "en": "Niger",
          "note": "24 million people"
        },
        {
          "fr": "le Bénin",
          "en": "Benin",
          "note": "12 million people"
        }
      ]
    },
    {
      "id": "s-central-africa-congo-basin",
      "heading": "Central Africa",
      "text": "French connects people who speak hundreds of different languages.",
