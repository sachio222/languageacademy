  "concepts": [
    {
      "id": "c-what-happened-first",
      "term": "What Happened FIRST",
      "definition": "Use '{j'avais déjà...}' to show something happened BEFORE another past event",
      "example": "{Quand il est arrivé} (when he arrived), {j'avais déjà mangé} (I had already eaten) - I ate FIRST, he arrived SECOND"
    },
    {
      "id": "c-deja-already",
      "term": "'{Déjà}' = Already",
      "definition": "Often used with these phrases to emphasize 'already done'",
      "example": "{J'avais déjà fini} (I had already finished)"
    }
  ],
  "items": [
