      "id": "c-bien-que-although-even",
      "term": "{Bien que...} - Although / Even Though",
      "definition": "Express doing something DESPITE another condition",
      "example": "{Bien que je sois fatigué, je travaille} (Although I'm tired, I'm working)"
    },
    {
      "id": "c-showing-determination",
      "term": "Showing Determination",
      "definition": "Doing something despite obstacles - shows perseverance!",
      "example": "{Bien qu'il fasse froid, on sort} (Even though it's cold, we're going out)"
    }
  ],
