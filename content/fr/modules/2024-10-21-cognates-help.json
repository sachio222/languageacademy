  "checks": [
    {
      "id": "k1",
      "ask": "Listen. What does it mean?",
      "say": "un hôpital",
      "sound": "uh no-pee-tal",
      "options": [
        {
          "text": "hospital",
          "right": true
        },
        {
          "text": "hotel"
        },
        {
          "text": "park"
        }
      ],
      "why": "{un hôpital} is hospital. The ô stands for an s that French dropped long ago."
    },
    {
      "id": "k2",
      "ask": "Which one has an English twin?",
      "options": [
        {
          "text": "merci",
          "fr": true
        },
        {
          "text": "une salade",
          "fr": true,
          "right": true
        },
        {
          "text": "tu es",
          "fr": true
        }
      ],
      "why": "{une salade} is salad. {merci} means thank you, and {tu es} means you are."
    },
    {
      "id": "k3",
