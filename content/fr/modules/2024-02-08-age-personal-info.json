  "concepts": [
    {
      "id": "c-french-age-expression-j",
      "term": "French Age Expression: {J'ai ... ans}",
      "definition": "French uses '{avoir}' (to have) + number + '{ans}' (years) to express age",
      "example": "{J'ai vingt-cinq ans} (I am 25 years old - literally 'I have 25 years')"
    },
    {
      "id": "c-asking-age-quel-age",
      "term": "Asking Age: {Quel âge...?}",
      "definition": "Use '{quel âge}' (what age) to ask someone's age politely",
      "example": "{Quel âge avez-vous?} (How old are you? - formal), {Quel âge as-tu?} (informal)"
    },
    {
      "id": "c-birth-information",
      "term": "Birth Information",
      "definition": "Express when and where you were born using être + né(e)",
      "example": "{Je suis né en 1995} (I was born in 1995), {Je suis née à Paris} (I was born in Paris - feminine)"
    },
    {
      "id": "c-personal-details-integration",
      "term": "Personal Details Integration",
      "definition": "Combine with s'appeler, être, avoir for complete self-introduction",
      "example": "{Je m'appelle Marie, j'ai 30 ans, je suis née à Lyon} (My name is Marie, I'm 30, I was born in Lyon)"
    }
  ],
  "items": [
