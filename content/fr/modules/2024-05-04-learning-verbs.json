  "concepts": [
    {
      "id": "c-apprendre-to-learn",
      "term": "{apprendre} = to learn",
      "definition": "The verb for learning something. It changes like {prendre}.",
      "examples": [
        {
          "fr": "J'apprends le français.",
          "en": "I'm learning French."
        },
        {
          "fr": "J'apprends beaucoup de mots.",
          "en": "I'm learning a lot of words."
        },
        {
          "fr": "Nous apprenons ensemble.",
          "en": "We're learning together."
        }
      ]
    },
    {
      "id": "c-same-pattern-as-prendre",
      "term": "Like {prendre}",
      "definition": "{apprendre} is {prendre} with ap- in front, so its forms change the same way.",
      "layout": "forms",
      "examples": [
        {
          "fr": "j'apprends",
          "en": "I learn"
        },
        {
          "fr": "tu apprends",
          "en": "you learn"
        },
        {
          "fr": "il apprend",
          "en": "he learns"
        },
        {
          "fr": "nous apprenons",
          "en": "we learn"
        },
        {
          "fr": "vous apprenez",
          "en": "you learn"
        },
        {
          "fr": "ils apprennent",
          "en": "they learn"
        }
      ]
    },
    {
      "id": "c-enseigner-to-teach",
      "term": "{enseigner} = to teach",
      "definition": "A regular -er verb. One person teaches and another learns.",
      "examples": [
        {
          "fr": "J'enseigne le français.",
          "en": "I teach French."
        },
        {
          "fr": "Ils enseignent à l'université.",
          "en": "They teach at the university."
        }
      ]
    },
    {
      "id": "c-beautiful-semantic-progression",
      "term": "Teaching, learning, understanding",
      "definition": "One person teaches. The other learns, and then understands.",
      "examples": [
        {
          "fr": "Il m'enseigne le français.",
          "en": "He teaches me French."
        },
        {
          "fr": "J'apprends le français avec lui.",
          "en": "I'm learning French with him."
        },
        {
          "fr": "Maintenant, je comprends.",
          "en": "Now I understand."
        }
      ]
    },
    {
      "id": "c-apprendre-a-infinitive",
      "term": "Learning to do something",
      "definition": "Put {à} before the verb to say what you are learning to do.",
      "examples": [
        {
          "fr": "J'apprends à parler français.",
          "en": "I'm learning to speak French."
        },
        {
          "fr": "J'apprends à faire du café.",
          "en": "I'm learning to make coffee."
        }
      ]
    }
  ],
  "items": [
    {
      "id": "learning-verbs-1",
      "type": "translate",
      "prompt": "I'm learning French",
      "answer": "j'apprends le français",
      "hint": "apprendre conjugated for je + le français",
      "mistakes": [
        {
          "answer": "je prends le français",
          "feedback": "Use '{apprendre}' (to learn), not 'prendre' (to take)!"
        },
        {
          "answer": "j'enseigne le français",
          "feedback": "That means 'I teach French' - use '{j'apprends}' for learning!"
        }
      ]
    },
    {
      "id": "learning-verbs-2",
      "type": "respond",
      "situation": "You teach me (informal)",
      "answer": "tu m'enseignes",
      "hint": "enseigner for tu + me (object pronoun)",
      "mistakes": [
        {
          "answer": "tu m'apprends",
          "feedback": "That means 'you learn me' (incorrect) - use '{enseigner}' for teaching!"
        }
      ]
    },
    {
      "id": "learning-verbs-3",
      "type": "translate",
      "prompt": "He learns English",
      "answer": "il apprend l'anglais",
      "hint": "apprendre for il + l'anglais"
    },
    {
      "id": "learning-verbs-4",
      "type": "translate",
      "prompt": "She teaches French",
      "answer": "elle enseigne le français",
      "hint": "enseigner for elle + le français"
    },
    {
      "id": "learning-verbs-5",
      "type": "translate",
      "prompt": "We're learning together",
      "answer": "nous apprenons ensemble",
      "hint": "apprendre for nous + ensemble"
    },
    {
      "id": "learning-verbs-6",
      "type": "translate",
      "prompt": "They teach at university",
      "answer": "ils enseignent à l'université",
      "hint": "enseigner for ils + à l'université"
    }
  ]
