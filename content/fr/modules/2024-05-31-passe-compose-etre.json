  "status": "written",
  "title": "être Verbs - DR & MRS VANDERTRAMP (went, came, left)",
  "description": "Learn motion verbs that use '{être}' in passé composé: je suis allé (I went), je suis venu (I came), je suis parti (I left), je suis arrivé (I arrived)",
  "can_do": [
    "Describe movement in the past (I went, I came, I left)",
    "Use être instead of avoir for motion verbs",
    "Master DR & MRS VANDERTRAMP verb patterns"
  ],
  "teaches": {
    "constructions": [
      "fr:cx:passe-compose.etre",
      "fr:cx:ptcp.agreement"
    ]
  },
