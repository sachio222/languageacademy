{
  "schema": "la-module@1",
  "module_key": "2024-01-25-contractions",
  "kind": "lesson",
  "status": "written",
  "title": "Contractions - {du, au, de la, à la}",
  "description": "Learn how '{de}' and 'à' combine with articles! Simple rules that make French flow naturally.",
  "can_do": [
    "Use contractions naturally (du, au, de la, à la)",
    "Say 'some bread', 'at the café', 'of the book' in French",
    "Make your French flow smoothly with proper contractions"
  ],
  "teaches": {
    "constructions": [
      "fr:cx:contraction.de",
      "fr:cx:contraction.a",
      "fr:cx:article.partitive",
      "fr:cx:elision"
    ]
  },
  "vocabulary": [
    {
      "word_id": "du-fr",
      "fr": "du",
      "gloss": "of/from the (masc)",
      "note": "de + le = du (masculine)"
    },
    {
      "word_id": "de-la-fr",
      "fr": "de la",
      "gloss": "of/from the (fem)",
      "note": "no contraction (feminine)"
    },
    {
      "word_id": "de-l-fr",
      "fr": "de l'",
      "gloss": "of/from the (vowel)",
      "note": "before vowel"
    },
    {
      "word_id": "des-fr.of",
      "fr": "des",
      "gloss": "of/from the (plural)",
      "note": "de + les = des (plural)"
    },
    {
      "word_id": "au-fr",
      "fr": "au",
      "gloss": "to/at the (masc)",
      "note": "à + le = au (masculine) - section divider"
    },
    {
      "word_id": "a-la-fr",
      "fr": "à la",
      "gloss": "to/at the (fem)",
      "note": "no contraction (feminine)"
    },
    {
      "word_id": "a-l-fr",
      "fr": "à l'",
      "gloss": "to/at the (vowel)",
      "note": "before vowel"
    },
    {
      "word_id": "aux-fr",
      "fr": "aux",
      "gloss": "to/at the (plural)",
      "note": "à + les = aux (plural)"
    }
  ],
  "concepts": [
    {
      "id": "c-contractions-with-de-of",
      "term": "{de} with {le} and {les}",
      "definition": "{De} with {le} becomes {du}. With {les} it becomes {des}, but {de la} stays as it is.",
      "examples": [
        {
          "fr": "du chat",
          "en": "of the cat"
        },
        {
          "fr": "de la maison",
          "en": "of the house"
        },
        {
          "fr": "des livres",
          "en": "of the books"
        }
      ]
    },
    {
      "id": "c-contractions-with-a-to",
      "term": "{à} with {le} and {les}",
      "definition": "{À} with {le} becomes {au}. With {les} it becomes {aux}, but {à la} stays as it is.",
      "examples": [
        {
          "fr": "Je suis au café avec eux.",
          "en": "I'm at the café with them."
        },
        {
          "fr": "Le chat est à la maison.",
          "en": "The cat is at home."
        },
        {
          "fr": "aux amis",
          "en": "to the friends"
        }
      ]
    },
    {
      "id": "c-partitive-articles-some-any",
      "term": "Some",
      "definition": "The same words also mean some, for an amount you do not count. English often leaves the word out.",
      "examples": [
        {
          "fr": "Je veux du café.",
          "en": "I want some coffee."
        },
        {
          "fr": "de la musique",
          "en": "some music"
        },
        {
          "fr": "J'ai des livres.",
          "en": "I have some books."
        }
      ]
    },
    {
      "id": "c-before-vowels",
      "term": "Before a vowel",
      "definition": "Before a vowel sound, {de} and {à} take {l'} for both genders.",
      "examples": [
        {
          "fr": "de l'ami",
          "en": "of the friend"
        },
        {
          "fr": "à l'hôtel",
          "en": "at the hotel"
        }
      ]
    }
  ],
  "items": [
    {
      "id": "i-du-chat",
      "type": "respond",
      "situation": "Combine '{de}' + '{le chat}' (of the cat)",
      "cue": "of the cat (masculine)",
      "answer": "du chat",
      "hint": "de + le contracts to '{du}'",
      "mistakes": [
        {
          "answer": "de le chat",
          "feedback": "de + le must contract to '{du}'"
        },
        {
          "answer": "de la chat",
          "feedback": "chat is masculine, and de + le = du"
        }
      ]
    },
    {
      "id": "i-de-la-maison",
      "type": "respond",
      "situation": "Combine '{de}' + '{la maison}' (of the house)",
      "cue": "of the house (feminine)",
      "answer": "de la maison",
      "hint": "de + la does NOT contract - stays separate",
      "mistakes": [
        {
          "answer": "du maison",
          "feedback": "maison is feminine, use '{de la}' not 'du'"
        }
      ]
    },
    {
      "id": "i-des-livres",
      "type": "respond",
      "situation": "Combine '{de}' + '{les livres}' (of the books)",
      "cue": "of the books (plural)",
      "answer": "des livres",
      "hint": "de + les contracts to '{des}'",
      "mistakes": [
        {
          "answer": "de les livres",
          "feedback": "de + les must contract to '{des}'"
        }
      ]
    },
    {
      "id": "i-de-l-ami",
      "type": "respond",
      "situation": "Combine '{de}' + '{l'ami}' (of the friend - vowel)",
      "cue": "of the friend (starts with vowel)",
      "answer": "de l'ami",
      "hint": "de + l' stays as is before vowel",
      "mistakes": [
        {
          "answer": "du ami",
          "feedback": "Before vowels, use '{de l'}' not 'du'"
        }
      ]
    },
    {
      "id": "i-au-cafe",
      "type": "respond",
      "situation": "Combine 'à' + '{le café}' (to/at the café)",
      "cue": "to the café (masculine)",
      "answer": "au café",
      "hint": "à + le contracts to '{au}'",
      "mistakes": [
        {
          "answer": "à le café",
          "feedback": "à + le must contract to '{au}'"
        }
      ]
    },
    {
      "id": "i-a-la-maison",
      "type": "respond",
      "situation": "Combine 'à' + '{la maison}' (to/at the house)",
      "cue": "to the house (feminine)",
      "answer": "à la maison",
      "hint": "à + la does NOT contract - stays separate",
      "mistakes": [
        {
          "answer": "au maison",
          "feedback": "maison is feminine, use '{à la}' not 'au'"
        }
      ]
    },
    {
      "id": "i-aux-amis",
      "type": "respond",
      "situation": "Combine 'à' + '{les amis}' (to the friends)",
      "cue": "to the friends (plural)",
      "answer": "aux amis",
      "hint": "à + les contracts to '{aux}'",
      "mistakes": [
        {
          "answer": "à les amis",
          "feedback": "à + les must contract to '{aux}'"
        }
      ]
    },
    {
      "id": "i-je-suis-au-cafe",
      "type": "translate",
      "prompt": "I am at the café",
      "answer": "je suis au café",
      "hint": "je suis + à + le café (contracts!)",
      "mistakes": [
        {
          "answer": "je suis à le café",
          "feedback": "à + le must contract to '{au}'"
        }
      ]
    },
    {
      "id": "i-le-chat-est-a",
      "type": "translate",
      "prompt": "the cat is at the house",
      "answer": "le chat est à la maison",
      "hint": "{le chat + est + à la maison}",
      "mistakes": [
        {
          "answer": "le chat est au maison",
          "feedback": "maison is feminine, use '{à la}' not 'au'"
        }
      ]
    },
    {
      "id": "i-je-suis-avec-les",
      "type": "translate",
      "prompt": "I am with the friends",
      "answer": "je suis avec les amis",
      "hint": "je suis + avec + les amis (avec doesn't contract!)",
      "mistakes": [
        {
          "answer": "je suis aux amis",
          "feedback": "avec doesn't contract - use '{avec les amis}'"
        }
      ]
    }
  ]
}
