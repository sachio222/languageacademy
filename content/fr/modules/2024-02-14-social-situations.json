  "concepts": [
    {
      "id": "c-attendre-to-wait-rank",
      "term": "{attendre} = to wait for",
      "definition": "Like {chercher}, {attendre} takes the person or thing straight after it, with no word for \"for\".",
      "examples": [
        {
          "fr": "J'attends le bus.",
          "en": "I'm waiting for the bus."
        },
        {
          "fr": "Tu attends quelqu'un ?",
          "en": "Are you waiting for someone?"
        },
        {
          "fr": "J'attends Marie et j'écoute de la musique.",
          "en": "I'm waiting for Marie and listening to music."
        }
      ]
    },
    {
      "id": "c-arriver-to-arrive-rank",
      "term": "{arriver} = to arrive",
      "definition": "Use {à} for the time or the place you arrive.",
      "examples": [
        {
          "fr": "J'arrive à neuf heures.",
          "en": "I arrive at nine."
        },
        {
          "fr": "Le train arrive.",
          "en": "The train is coming in."
        },
        {
          "fr": "Quand tu arrives ?",
          "en": "When do you get here?"
        }
      ]
    },
    {
      "id": "c-rester-to-stay-rank",
      "term": "{rester} = to stay",
      "definition": "The verb for staying where you are.",
      "examples": [
        {
          "fr": "Je reste ici.",
          "en": "I'm staying here."
        },
        {
          "fr": "Tu restes combien de temps ?",
          "en": "How long are you staying?"
        },
        {
          "fr": "Il reste du pain.",
          "en": "There's some bread left.",
          "note": "{il reste} also means there is some left"
        }
      ]
    },
    {
      "id": "c-social-coordination",
      "term": "Making plans",
      "definition": "With these three verbs you can plan a meeting.",
      "examples": [
        {
          "fr": "J'attends Marie, elle arrive à sept heures et nous restons ensemble.",
          "en": "I'm waiting for Marie, she arrives at seven and we're staying together."
        }
      ]
    }
  ],
