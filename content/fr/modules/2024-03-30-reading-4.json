    {
      "id": "b-marie-tu-veux-aller",
      "speaker": "Paul",
      "fr": "Marie ! Tu veux aller au Jardin du Luxembourg avec moi ?",
      "en": "Marie! Do you want to go to Jardin du Luxembourg with me?"
    },
    {
      "id": "b-oui-mais-je-ne",
      "speaker": "Marie",
      "fr": "Oui ! Mais je ne peux pas maintenant. Je dois aller au travail.",
      "en": "Yes! But I can't right now. I must go to work."
    },
    {
      "id": "img-matin",
      "fr": "Marie doit aller au travail.",
      "en": "Marie must go to work.",
      "img": {
        "src": "img/reading4/matin",
        "w": 1600,
        "h": 1067,
        "alt": "At the door of her building, Marie in a cream trench coat checks her watch while Paul in a navy coat and teal scarf points toward a park; a flying car glides past."
      }
    },
    {
      "id": "b-tu-vas-au-travail",
      "speaker": "Paul",
      "fr": "Tu vas au travail aujourd'hui ? C'est demain ton jour de travail, non ?",
      "en": "You're going to work today? Tomorrow is your work day, no?"
    },
    {
      "id": "b-non-aujourd-hui-je",
      "speaker": "Marie",
      "fr": "Non, aujourd'hui ! Je vais toujours au travail le matin. Mais ce soir, je ne vais pas au travail.",
      "en": "No, today! I always go to work in the morning. But this evening, I'm not going to work."
    },
    {
      "id": "b-ah-bon-ce-soir",
      "speaker": "Paul",
      "fr": "Ah bon ! Ce soir alors ! Tu veux venir à Saint-Germain ce soir avec moi ?",
      "en": "Ah good! This evening then! Do you want to come to Saint-Germain this evening with me?"
    },
    {
      "id": "b-oui-mais-j-ai",
      "speaker": "Marie",
      "fr": "Oui ! Mais j'ai un problème. Je n'ai pas d'argent avec moi.",
      "en": "Yes! But I have a problem. I don't have money with me."
    },
    {
      "id": "b-tu-n-as-pas",
      "speaker": "Paul",
      "fr": "Tu n'as pas d'argent ? Tu as ta carte de crédit ?",
      "en": "You don't have money? Do you have your credit card?"
    },
    {
      "id": "b-oui-j-ai-ma",
      "speaker": "Marie",
      "fr": "Oui, j'ai ma carte de crédit chez moi. Je vais la chercher là-bas.",
      "en": "Yes, I have my credit card at home. I'm going to look for it there."
    },
