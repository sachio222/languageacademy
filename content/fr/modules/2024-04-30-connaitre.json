  "concepts": [
    {
      "id": "c-connaitre-to-know-people",
      "term": "{connaître} = to know (people or places)",
      "definition": "CRITICAL distinction: connaître is for people you know or places you're familiar with",
      "example": "{je connais Marie} (I know Marie), {je connais Paris} (I know/am familiar with Paris)"
    },
    {
      "id": "c-irregular-conjugation-with-i",
      "term": "Irregular conjugation with î",
      "definition": "Present: je connais, tu connais, il connaît, nous connaissons, vous connaissez, ils connaissent",
      "example": "Notice: î with circumflex accent in il/elle form, double -ss- in plural"
    },
    {
      "id": "c-the-key-distinction-savoir",
      "term": "THE KEY DISTINCTION: savoir vs connaître",
      "definition": "savoir = facts/skills (learned), connaître = people/places (familiarity)",
      "example": "{je sais la réponse} (I know the answer) BUT je connais Marie (I know Marie)"
    },
    {
      "id": "c-never-use-connaitre-infinitive",
      "term": "NEVER use connaître + infinitive",
      "definition": "You CANNOT say '{je connais parler}' - use savoir for skills!",
      "example": "✓ {je sais parler} (I know how to speak), ✗ {je connais parler} (WRONG!)"
    },
    {
      "id": "c-common-uses",
      "term": "Common uses",
      "definition": "Know people, know places, be familiar with things (movies, books, brands)",
      "example": "{je connais ce film} (I know this movie), {tu connais ce restaurant?} (do you know this restaurant?)"
    }
  ],
