  "sections": [
    {
      "id": "s-numbers-0-20",
      "heading": "Numbers 0 to 20",
      "text": "Every number up to 16 is its own word, and these six from 11 to 16 follow no pattern. From 17 on, French adds: {dix-sept} is ten-seven.",
      "examples": [
        {
          "fr": "onze",
          "en": "eleven"
        },
        {
          "fr": "douze",
          "en": "twelve"
        },
        {
          "fr": "treize",
          "en": "thirteen"
        },
        {
          "fr": "quatorze",
          "en": "fourteen"
        },
        {
          "fr": "quinze",
          "en": "fifteen"
        },
        {
          "fr": "seize",
          "en": "sixteen"
        }
      ]
    },
    {
      "id": "s-tens-20-60",
      "heading": "Tens from 20 to 60",
      "text": "Each ten has its own word.",
      "examples": [
        {
          "fr": "vingt",
          "en": "twenty"
        },
        {
          "fr": "trente",
          "en": "thirty"
        },
        {
          "fr": "quarante",
          "en": "forty"
        },
        {
          "fr": "cinquante",
          "en": "fifty"
        },
        {
          "fr": "soixante",
          "en": "sixty"
        }
      ]
    },
    {
      "id": "s-the-famous-french-70s",
      "heading": "70 to 79",
      "text": "French counts 70 as sixty-ten, so 71 is sixty-eleven and 75 is sixty-fifteen.",
      "examples": [
        {
          "fr": "soixante-dix",
          "en": "seventy",
          "note": "sixty-ten"
        },
        {
          "fr": "soixante-et-onze",
          "en": "seventy-one",
          "note": "sixty-eleven"
        },
        {
          "fr": "soixante-quinze",
          "en": "seventy-five",
          "note": "sixty-fifteen"
        },
        {
          "fr": "soixante-dix-neuf",
          "en": "seventy-nine",
          "note": "sixty-nineteen"
        }
      ]
    },
    {
      "id": "s-the-infamous-french-80s",
      "heading": "80 to 89",
      "text": "French counts 80 as four twenties. It takes an s only when nothing comes after it.",
      "examples": [
        {
          "fr": "quatre-vingts",
          "en": "eighty",
          "note": "four twenties"
        },
        {
          "fr": "quatre-vingt-un",
          "en": "eighty-one"
        },
        {
          "fr": "quatre-vingt-cinq",
          "en": "eighty-five"
        },
        {
          "fr": "quatre-vingt-neuf",
          "en": "eighty-nine"
        }
      ]
    },
    {
      "id": "s-the-wild-french-90s",
      "heading": "90 to 99",
      "text": "French counts 90 as four twenties and ten, so 91 is four twenties and eleven.",
      "examples": [
        {
          "fr": "quatre-vingt-dix",
          "en": "ninety"
        },
        {
          "fr": "quatre-vingt-onze",
          "en": "ninety-one"
        },
        {
          "fr": "quatre-vingt-quinze",
          "en": "ninety-five"
        },
        {
          "fr": "quatre-vingt-dix-neuf",
          "en": "ninety-nine"
        }
      ]
    },
    {
      "id": "s-numbers-21-69-pattern",
      "heading": "21 to 69",
      "text": "Join the ten and the unit with a hyphen. For 21, 31, 41, 51 and 61, put {et} between them.",
      "examples": [
        {
          "fr": "vingt-et-un",
          "en": "twenty-one"
        },
        {
          "fr": "vingt-deux",
          "en": "twenty-two"
        },
        {
          "fr": "trente-cinq",
          "en": "thirty-five"
        },
        {
          "fr": "quarante-sept",
          "en": "forty-seven"
        },
        {
          "fr": "soixante-neuf",
          "en": "sixty-nine"
        }
      ]
    },
    {
      "id": "s-large-numbers",
      "heading": "Hundreds and more",
      "text": "{cent} is a hundred and {mille} is a thousand. Bigger numbers are built from them.",
      "examples": [
        {
          "fr": "cent",
          "en": "one hundred"
        },
        {
          "fr": "deux cents",
          "en": "two hundred"
        },
        {
          "fr": "mille",
          "en": "one thousand"
        },
        {
          "fr": "un million",
          "en": "one million"
        },
        {
          "fr": "un milliard",
          "en": "one billion"
        }
      ]
    },
    {
      "id": "s-belgian-swiss-variation",
      "heading": "In Belgium and Switzerland",
      "text": "People there say {septante} for 70 and {nonante} for 90. In parts of Switzerland they also say {huitante} for 80.",
      "examples": [
        {
          "fr": "septante",
          "en": "seventy",
          "note": "in France, {soixante-dix}"
        },
        {
          "fr": "septante-cinq",
          "en": "seventy-five",
          "note": "in France, {soixante-quinze}"
        },
        {
          "fr": "nonante",
          "en": "ninety",
          "note": "in France, {quatre-vingt-dix}"
        }
      ]
    },
    {
      "id": "s-important-exceptions-rules",
      "heading": "Spelling rules that catch people out",
      "text": "A few small rules decide when a number takes an s or {et}. Each example shows one.",
      "examples": [
        {
          "fr": "quatre-vingt-un",
          "en": "eighty-one",
          "note": "no {et}, unlike {vingt-et-un}"
        },
        {
          "fr": "quatre-vingts",
          "en": "eighty",
          "note": "an s when nothing follows"
        },
        {
          "fr": "quatre-vingt-deux",
          "en": "eighty-two",
          "note": "no s when a number follows"
        },
        {
          "fr": "deux cents",
          "en": "two hundred",
          "note": "an s when nothing follows"
        },
        {
          "fr": "deux cent un",
          "en": "two hundred one",
          "note": "no s when a number follows"
        },
        {
          "fr": "trois mille",
          "en": "three thousand",
          "note": "{mille} never takes an s"
        }
      ]
    }
  ]
}
