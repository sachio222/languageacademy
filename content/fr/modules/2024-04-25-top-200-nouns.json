  "concepts": [
    {
      "id": "c-time-nouns",
      "term": "Words for time",
      "definition": "These nouns name lengths of time and moments.",
      "examples": [
        {
          "fr": "une année",
          "en": "a year"
        },
        {
          "fr": "une fois",
          "en": "once"
        },
        {
          "fr": "un moment",
          "en": "a moment"
        },
        {
          "fr": "au début",
          "en": "at the beginning"
        },
        {
          "fr": "à la fin",
          "en": "at the end"
        }
      ]
    },
    {
      "id": "c-people-relationships",
      "term": "Family and people",
      "definition": "Words for your family and for people in general.",
      "examples": [
        {
          "fr": "Toute ma famille est ici.",
          "en": "My whole family is here."
        },
        {
