  "concepts": [
    {
      "id": "c-should-devrais-conditional-of",
      "term": "Should: {je devrais}",
      "definition": "{devoir} in this form gives advice. It is softer than must.",
      "examples": [
        {
          "fr": "Tu devrais partir.",
          "en": "You should leave."
        },
        {
          "fr": "Nous devrions parler.",
          "en": "We should talk."
        },
        {
          "fr": "Il devrait travailler.",
          "en": "He should work."
        }
      ]
    },
    {
      "id": "c-could-pourrais-conditional-of",
      "term": "Could: {je pourrais}",
      "definition": "{pouvoir} in this form says what is possible. It also makes a request polite.",
      "examples": [
        {
          "fr": "Je pourrais venir.",
          "en": "I could come."
        },
        {
          "fr": "Tu pourrais m'aider ?",
          "en": "Could you help me?"
        },
        {
          "fr": "Elle pourrait le faire.",
          "en": "She could do it."
        }
      ]
    },
    {
      "id": "c-pattern-alternating-should-could",
      "term": "Same endings for both",
      "definition": "{devoir} and {pouvoir} take the same endings in this form, so if you know one you know the other.",
      "layout": "forms",
      "examples": [
        {
          "fr": "je devrais",
          "en": "I should"
        },
        {
          "fr": "tu devrais",
          "en": "you should"
        },
        {
          "fr": "il devrait",
          "en": "he should"
        },
        {
          "fr": "nous devrions",
          "en": "we should"
        },
        {
          "fr": "vous devriez",
          "en": "you should"
        },
        {
          "fr": "ils devraient",
          "en": "they should"
        }
      ]
    },
    {
      "id": "c-negation",
      "term": "Should not, could not",
      "definition": "Put {ne} … {pas} around the verb, as in the present.",
      "examples": [
        {
          "fr": "Je ne devrais pas partir.",
          "en": "I shouldn't leave."
        },
        {
          "fr": "Tu ne pourrais pas faire ça.",
          "en": "You couldn't do that."
        },
        {
          "fr": "Nous ne devrions pas partir.",
          "en": "We shouldn't leave."
        }
      ]
    }
  ],
  "items": [
    {
      "id": "i-je-devrais-partir",
      "type": "translate",
      "prompt": "I should go",
      "answer": "je devrais partir",
      "hint": "{je + devrais + partir}",
      "mistakes": [
        {
          "answer": "je dois partir",
          "feedback": "That's 'I must go' - use conditional '{devrais}' for 'should'"
        }
      ]
    },
    {
