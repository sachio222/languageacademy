{
  "name": "language-academy",
  "version": "1.0.0",
  "description": "Interactive French learning platform with grammar linting",
  "main": "index.js",
  "scripts": {
    "build": "pnpm content:validate && ./prepare-historical-css.sh && pnpm content:bundle && pnpm content:bundle --units unit1",
    "vite:build": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "vocab:sort": "node scripts/alphabetize-vocabulary.js",
    "vocab:validate": "node scripts/validate-vocabulary.js",
    "graph:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/graph/cli.mjs check fr",
    "graph:due": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/graph/cli.mjs due fr",
    "graph:report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/graph/cli.mjs report fr",
    "graph:extract": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/graph/extract-teaches.mjs",
    "content:validate": "node scripts/content/cli.mjs validate",
    "content:bundle": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/cli.mjs bundle",
    "content:vendor-check": "node scripts/content/vendor-check.mjs",
    "content:migrate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/content/migrate/run.mjs",
    "content:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"scripts/content/test/**/*.test.mjs\"",
    "graph:test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"scripts/graph/test/**/*.test.mjs\""
  },
  "keywords": [
    "french",
    "language",
    "learning",
    "interactive"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@clerk/clerk-react": "^5.51.0",
    "@microsoft/clarity": "^1.0.0",
    "@supabase/supabase-js": "^2.74.0",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@vercel/analytics": "^1.5.0",
    "edge-tts-client": "^1.0.2",
    "jsdom": "^27.0.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.3",
    "lamejs": "^1.2.1",
    "lucide-react": "^0.544.0",
    "microsoft-cognitiveservices-speech-sdk": "^1.47.0",
    "node-fetch": "^3.3.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-force-graph-2d": "^1.29.0",
    "react-router-dom": "^7.9.4",
    "react-window": "^2.2.3",
    "sharp": "^0.34.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "dotenv": "^17.2.3",
    "vite": "^4.3.9"
  }
}
