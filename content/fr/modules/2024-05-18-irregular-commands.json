  "concepts": [
    {
      "id": "c-most-common-verbs-irregular",
      "term": "Most Common Verbs = Irregular Commands",
      "definition": "être, avoir, aller, and faire don't follow normal command patterns",
      "example": "{Sois gentil!} (Be nice!), {Aie courage!} (Have courage!), {Va là-bas!} (Go over there!)"
    },
    {
      "id": "c-must-memorize-these",
      "term": "Must Memorize These",
      "definition": "These irregular forms are used constantly - worth memorizing!",
      "example": "{Vas-y!} (Go ahead! / Go for it!) - extremely common phrase"
    },
    {
      "id": "c-etre-commands",
      "term": "être Commands",
      "definition": "{tu: Sois! vous: Soyez! nous: Soyons!}",
      "example": "{Sois sage!} (Be good!), {Soyez gentil!} (Be kind!)"
    },
    {
      "id": "c-avoir-commands",
      "term": "avoir Commands",
      "definition": "{tu: Aie! vous: Ayez! nous: Ayons!}",
      "example": "{Aie confiance!} (Have confidence!), {Ayez patience!} (Have patience!)"
    },
    {
      "id": "c-aller-commands",
      "term": "aller Commands",
      "definition": "tu: Va! vous: Allez! nous: Allons! Special: Vas-y!",
      "example": "{Va là-bas!} (Go over there!), {Allons-y!} (Let's go!), {Vas-y!} (Go ahead!)"
    },
    {
      "id": "c-faire-commands",
      "term": "faire Commands",
      "definition": "{tu: Fais! vous: Faites! nous: Faisons!}",
      "example": "{Fais attention!} (Pay attention! / Be careful!), {Faites ça!} (Do that!)"
    },
    {
      "id": "c-y-there",
      "term": "{y}: there",
      "definition": "{y} stands for a place you already named, like {au café} or {chez Paul}. In a statement it goes before the verb. In a positive command it goes after the verb, which is where the {y} in {vas-y} comes from.",
      "example": "{Tu vas au café ? Oui, j'y vais.} (Are you going to the café? Yes, I'm going there.)"
    }
  ],
  "items": [
    {
      "id": "irreg-cmd-1",
      "type": "respond",
      "situation": "Command: 'Be nice!' (informal)",
      "cue": "Be nice! (to a friend)",
      "answer": "sois gentil",
      "hint": "{Sois + gentil!}",
      "mistakes": [
        {
          "answer": "es gentil",
          "feedback": "Use command form '{Sois}', not 'es'"
        }
      ]
    },
    {
      "id": "irreg-cmd-2",
      "type": "respond",
      "situation": "Command: 'Have courage!' (informal)",
      "cue": "Have courage!",
      "answer": "aie courage",
      "hint": "{Aie + courage!}"
    },
    {
      "id": "irreg-cmd-3",
      "type": "respond",
      "situation": "Command: 'Go over there!' (informal)",
      "cue": "Go over there!",
      "answer": "va là-bas",
      "accept": [
        "va la-bas"
      ],
      "hint": "{Va + là-bas!}"
    },
    {
      "id": "irreg-cmd-4",
      "type": "respond",
      "situation": "Say the famous phrase 'Go ahead!' or 'Go for it!'",
      "cue": "Go ahead!",
      "answer": "vas-y",
      "accept": [
        "vas y"
      ],
      "hint": "Va + -s + -y! (special form)",
      "mistakes": [
        {
          "answer": "va-y",
          "feedback": "Add -s before -y: Vas-y! (special form)"
        }
      ]
    },
    {
      "id": "irreg-cmd-5",
      "type": "respond",
      "situation": "Command: 'Pay attention!' or 'Be careful!' (informal)",
      "cue": "Be careful! / Pay attention!",
      "answer": "fais attention",
      "hint": "{Fais + attention!}"
    },
    {
      "id": "irreg-cmd-6",
      "type": "respond",
      "situation": "Command: 'Let's go!' (nous form)",
      "cue": "Let's go!",
      "answer": "allons-y",
      "accept": [
        "allons y"
      ],
      "hint": "{Allons + -y!}"
    },
    {
      "id": "i-oui-j-y-vais",
      "type": "respond",
      "situation": "A friend asks {Tu vas au café ?} Say yes, you're going there.",
      "answer": "oui, j'y vais",
      "accept": [
        "j'y vais",
        "oui j y vais",
        "j y vais"
      ],
      "hint": "{y} goes before the verb",
      "mistakes": [
        {
          "answer": "oui, je vais y",
          "feedback": "{y} goes before the verb: {j'y vais}."
        }
      ]
    },
    {
      "id": "i-nous-y-allons",
      "type": "transform",
      "instruction": "Swap the place for {y}.",
      "shown": "Nous allons à Paris.",
      "answer": "nous y allons",
      "mistakes": [
        {
          "answer": "nous allons y",
          "feedback": "{y} goes before the verb: {nous y allons}."
        }
      ]
    },
    {
      "id": "i-non-je-n-y-vais-pas",
      "type": "respond",
      "situation": "A friend asks {Tu vas chez Paul ?} Say no, you're not going there.",
      "answer": "non, je n'y vais pas",
      "accept": [
        "je n'y vais pas",
        "non je n y vais pas",
        "je n y vais pas"
      ],
      "hint": "{ne} goes before {y}, and {pas} after the verb",
      "mistakes": [
        {
          "answer": "non, je ne vais pas y",
          "feedback": "{y} stays before the verb, after {ne}: {je n'y vais pas}."
        }
      ]
    }
  ]
}
