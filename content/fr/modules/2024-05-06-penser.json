  "title": "{penser} - To Think",
  "description": "Express thoughts and opinions: je pense que oui (I think so), qu'est-ce que tu penses? (what do you think?)",
  "can_do": [
    "Express your thoughts and opinions (I think that...)",
    "Ask what others think (What do you think?)",
    "Use penser with que to share ideas"
  ],
  "teaches": {
    "constructions": [
      "fr:cx:frame.verb-que-clause"
    ]
  },
  "vocabulary": [
