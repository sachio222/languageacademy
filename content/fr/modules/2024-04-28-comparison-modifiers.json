      "gloss": "badly / poorly",
      "note": "rank 87 - opposite of '{bien}'"
    },
    {
      "word_id": "je-comprends-mal-fr",
      "fr": "je comprends mal",
      "gloss": "I understand poorly",
      "note": "adverb after verb"
    },
    {
      "word_id": "aller-mal-fr",
      "fr": "aller mal",
      "gloss": "to go badly / to be unwell",
      "note": "Ça va mal (It's going badly)"
    }
  ],
  "concepts": [
    {
      "id": "c-tout-all-everything",
      "term": "{tout} = all, everything",
      "definition": "On its own, {tout} means everything. Before a noun it means all or the whole, and it agrees with the noun.",
      "examples": [
        {
          "fr": "Je sais tout.",
          "en": "I know everything."
        },
        {
          "fr": "Toute la classe est là.",
          "en": "The whole class is here."
        },
        {
          "fr": "On apprend tous les jours.",
          "en": "We learn every day."
        },
        {
          "fr": "C'est tout petit.",
          "en": "It's very small.",
          "note": "before an adjective, {tout} means very"
        }
      ]
    },
    {
      "id": "c-tout-le-monde-everyone",
      "term": "{tout le monde} = everyone",
      "definition": "Literally all the world. Its verb is singular.",
      "examples": [
        {
          "fr": "Tout le monde comprend.",
          "en": "Everyone understands."
        },
        {
          "fr": "Tout le monde est là ?",
          "en": "Is everyone here?"
        }
      ]
    },
    {
      "id": "c-meme-same-even",
      "term": "{même} = same, even",
      "definition": "With an article in front, {même} means same. Before a word, it means even.",
      "examples": [
        {
          "fr": "C'est la même chose.",
          "en": "It's the same thing."
        },
        {
          "fr": "Même moi, je sais.",
          "en": "Even I know."
        }
      ]
    },
    {
      "id": "c-mal-badly-poorly",
      "term": "{mal} = badly",
      "definition": "The opposite of {bien}.",
      "examples": [
        {
          "fr": "Ça va mal.",
          "en": "Things are going badly."
        },
        {
          "fr": "Il va mal.",
          "en": "He's not well."
        }
      ]
    },
    {
      "id": "c-complete-comparison-toolkit",
      "term": "Saying how well",
      "definition": "Put these words after the verb to say how well something goes.",
      "examples": [
        {
          "fr": "Je comprends très bien.",
          "en": "I understand very well."
        },
        {
          "fr": "Je comprends bien.",
          "en": "I understand well."
        },
        {
          "fr": "Je comprends mal.",
          "en": "I don't understand well."
        }
      ]
    }
  ],
  "items": [
    {
      "id": "comparison-modifiers-1",
      "type": "translate",
      "prompt": "Everyone knows",
      "answer": "tout le monde sait",
      "hint": "tout le monde + sait (savoir for il/elle/on form)",
      "mistakes": [
        {
          "answer": "tout le monde savent",
          "feedback": "'Tout le monde' is singular (like 'everyone') - use '{sait}' not 'savent'!"
        }
      ]
    },
    {
      "id": "comparison-modifiers-2",
      "type": "translate",
      "prompt": "It's the same thing",
      "answer": "c'est la même chose",
      "hint": "c'est + la même chose (feminine)"
    },
    {
      "id": "comparison-modifiers-3",
      "type": "translate",
      "prompt": "Even I know",
      "answer": "même moi, je sais",
      "hint": "même + moi + comma + je sais"
    },
    {
      "id": "comparison-modifiers-4",
      "type": "translate",
      "prompt": "I understand poorly",
      "answer": "je comprends mal",
      "hint": "je comprends + mal (adverb after verb)",
      "mistakes": [
        {
          "answer": "je mal comprends",
          "feedback": "Put 'mal' AFTER the verb - 'je comprends mal'!"
        }
      ]
    },
    {
      "id": "comparison-modifiers-5",
      "type": "translate",
      "prompt": "Everyone understands",
