      "fr": "j'ai eu",
      "gloss": "I had",
      "note": "⭐ avoir → eu (irregular!)"
    },
    {
      "word_id": "j-ai-ete-fr",
      "fr": "j'ai été",
      "gloss": "I was / I have been",
      "note": "⭐ être → été (irregular!)"
    },
    {
      "word_id": "j-ai-fait-fr",
      "fr": "j'ai fait",
      "gloss": "I did / I made",
      "note": "⭐ faire → fait (irregular!)"
    },
    {
      "word_id": "j-ai-vu-fr",
      "fr": "j'ai vu",
      "gloss": "I saw",
      "note": "⭐ voir → vu (irregular!)"
    },
