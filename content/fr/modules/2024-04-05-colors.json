  "sections": [
    {
      "id": "s-colors-are-adjectives",
      "heading": "Colors are Adjectives",
      "text": "In French, colors are adjectives that agree with the noun in gender and number. They usually come AFTER the noun.",
      "example": "{le ciel bleu} (the blue sky), {une maison blanche} (a white house), {des yeux verts} (green eyes)"
    },
    {
      "id": "s-basic-colors",
      "heading": "Basic Colors",
      "text": "The most common colors you'll use every day - memorize these first!",
      "example": "{bleu} (blue), {rouge} (red), {vert} (green), {jaune} (yellow), {blanc} (white), {noir} (black)"
    },
    {
      "id": "s-feminine-forms",
      "heading": "Feminine Forms",
      "text": "Add -e to make most colors feminine. Some have special forms.",
      "example": "{bleu} → {bleue}, {vert} → {verte}, {blanc} → {blanche}, {rouge} → rouge (no change)"
    },
    {
      "id": "s-plural-forms",
      "heading": "Plural Forms",
      "text": "Add -s for plural (unless already ends in -s or -x)",
      "example": "{bleu} → {bleus} (masculine plural), {bleue} → {bleues} (feminine plural), {gris} → gris (no change)"
    },
    {
      "id": "s-invariable-colors",
      "heading": "Invariable Colors",
      "text": "Some colors never change: marron (brown), orange (orange). These are actually nouns used as adjectives!",
      "example": "{un chat marron}, {une maison marron}, {des chats marron} (no -s!)"
    },
    {
      "id": "s-compound-colors",
      "heading": "Compound Colors",
      "text": "Colors with two words or modified colors are invariable (never change)",
      "example": "{des yeux bleu clair} (light blue eyes), {des robes bleu foncé} (dark blue dresses)"
    },
    {
      "id": "s-using-colors-in-questions",
      "heading": "Using Colors in Questions",
      "text": "Now you can ask about colors of things!",
      "example": "{De quelle couleur est le ciel?} (What color is the sky?) → {Le ciel est bleu. Pourquoi est-ce que l'herbe est verte?} (Why is grass green?)"
    }
  ]
