{
  "schema": "la-module@1",
  "module_key": "2026-11-24-negation-guide",
  "kind": "guide",
  "status": "written",
  "title": "Saying No - Negation Guide",
  "short_title": "Negation",
  "description": "Say not, no more, nothing and never with sentences you already know.",
  "can_do": [
    "Say what you are not and what you do not have",
    "Say not anymore, nothing and never"
  ],
  "teaches": {
    "constructions": [
      "fr:cx:neg.ne-pas",
      "fr:cx:neg.de",
      "fr:cx:neg.ne-plus",
      "fr:cx:neg.ne-rien",
      "fr:cx:neg.ne-jamais"
    ],
    "words": [
      "fr:lex:ne",
      "fr:form:ne.elided",
      "fr:lex:pas",
      "fr:lex:plus",
      "fr:lex:rien",
      "fr:lex:jamais"
    ]
  },
  "minutes": 3,
  "line": "Say not, no more, nothing and never with sentences you already know.",
  "parts": [
    {
      "id": "p-not-ne-pas",
      "heading": "Not: {ne … pas}",
      "text": [
        "Put {ne} before the verb and {pas} after it. Before a vowel, {ne} becomes {n'}."
      ],
      "blocks": [
        {
          "pairs": [
            [
              "je ne suis pas",
              "I'm not"
            ],
            [
              "tu n'es pas",
              "you're not"
            ],
            [
              "elle n'est pas",
              "she isn't"
            ],
            [
              "je n'ai pas",
              "I don't have"
            ],
            [
              "nous n'avons pas",
              "we don't have"
            ],
            [
              "ils n'ont pas",
              "they don't have"
            ]
          ]
        },
        {
          "lines": [
            [
              "Non, je ne suis pas fatigué.",
              "No, I'm not tired."
            ],
            [
              "Paul n'est pas content.",
              "Paul isn't happy."
            ]
          ]
        }
      ]
    },
    {
      "id": "p-not-any-pas-de",
      "heading": "Not any: {pas de}",
      "text": [
        "After {pas}, the articles {un}, {une} and {des} become {de}, or {d'} before a vowel."
      ],
      "note": "{Le}, {la} and {les} stay as they are. After {être}, {un} and {une} stay as they are.",
      "blocks": [
        {
          "lines": [
            [
              "Je n'ai pas de chat.",
              "I don't have a cat."
            ],
            [
              "Il n'a pas de voiture.",
              "He doesn't have a car."
            ],
            [
              "Nous n'avons pas d'amis.",
              "We don't have any friends."
            ],
            [
              "Je n'ai pas le livre.",
              "I don't have the book."
            ],
            [
              "Paul n'est pas un enfant.",
              "Paul isn't a child."
            ]
          ]
        },
        {
          "lines": [
            [
              "J'ai un chat, mais je n'ai pas de chien.",
              "I have a cat, but I don't have a dog."
            ]
          ]
        }
      ]
    },
    {
      "id": "p-no-more-nothing-never",
      "heading": "No more, nothing, never: swap {pas}",
      "text": [
        "Keep {ne} and put another word where {pas} goes."
      ],
      "blocks": [
        {
          "pairs": [
            [
              "ne … pas",
              "not"
            ],
            [
              "ne … plus",
              "not anymore, no more"
            ],
            [
              "ne … rien",
              "nothing"
            ],
            [
              "ne … jamais",
              "never"
            ]
          ]
        },
        {
          "lines": [
            [
              "Je ne suis plus fatigué.",
              "I'm not tired anymore."
            ],
            [
              "Je n'ai plus de café.",
              "I don't have any more coffee."
            ],
            [
              "Il n'a rien.",
              "He has nothing."
            ],
            [
              "Tu n'es jamais content.",
              "You're never happy."
            ]
          ]
        }
      ]
    }
  ],
  "checks": [
    {
      "id": "k1",
      "ask": "Which one means “I don't have a cat”?",
      "options": [
        {
          "text": "Je n'ai pas de chat.",
          "fr": true,
          "right": true
        },
        {
          "text": "Je n'ai pas un chat.",
          "fr": true
        },
        {
          "text": "Je ne ai pas de chat.",
          "fr": true
        }
      ],
      "why": "After {pas}, {un} becomes {de}, and {ne} becomes {n'} before a vowel: {Je n'ai pas de chat.}"
    },
    {
      "id": "k2",
      "ask": "Which one means “You aren't a child”?",
      "options": [
        {
          "text": "Tu ne pas es un enfant.",
          "fr": true
        },
        {
          "text": "Tu n'es pas un enfant.",
          "fr": true,
          "right": true
        },
        {
          "text": "Tu n'es pas d'enfant.",
          "fr": true
        }
      ],
      "why": "{ne} goes before the verb and {pas} after it. After {être}, {un} stays as it is: {Tu n'es pas un enfant.}"
    },
    {
      "id": "k3",
      "ask": "Which one means “I don't have a car anymore”?",
      "options": [
        {
          "text": "Je n'ai jamais de voiture.",
          "fr": true
        },
        {
          "text": "Je n'ai pas de voiture.",
          "fr": true
        },
        {
          "text": "Je n'ai plus de voiture.",
          "fr": true,
          "right": true
        }
      ],
      "why": "{plus} takes the place of {pas} and means anymore."
    }
  ]
}
