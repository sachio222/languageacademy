{
  "schema": "la-module@1",
  "module_key": "2024-04-05-avoir-past",
  "kind": "lesson",
  "status": "written",
  "title": "{avoir} - Past Tense (had)",
  "description": "Talk about what you had in the past: j'avais (I had), tu avais (you had), il avait (he had)",
  "can_do": [
    "Express past possession (I had, you had, they had)",
    "Describe what you possessed in the past",
    "Combine with être past to tell complete stories"
  ],
  "teaches": {
    "constructions": [
      "fr:cx:imparfait"
    ]
  },
  "vocabulary": [
    {
      "word_id": "j-avais-fr",
      "fr": "j'avais",
      "gloss": "I had",
      "note": "imperfect tense"
    },
    {
      "word_id": "tu-avais-fr",
      "fr": "tu avais",
      "gloss": "you had (informal)",
      "note": "sounds same as j'avais"
    },
    {
      "word_id": "il-elle-avait-fr",
      "fr": "il/elle avait",
      "gloss": "he/she had",
      "note": "slightly different pronunciation"
    },
    {
      "word_id": "nous-avions-fr",
      "fr": "nous avions",
      "gloss": "we had",
      "note": "imperfect tense"
    },
    {
      "word_id": "vous-aviez-fr",
      "fr": "vous aviez",
      "gloss": "you had (formal/plural)",
      "note": "imperfect tense"
    },
    {
      "word_id": "ils-elles-avaient-fr",
      "fr": "ils/elles avaient",
      "gloss": "they had",
      "note": "sounds like 'avè'"
    },
    {
      "word_id": "avoir-faim-fr",
      "fr": "avoir faim",
      "gloss": "to be hungry",
      "note": "literally 'to have hunger'"
    },
    {
      "word_id": "avoir-raison-fr",
      "fr": "avoir raison",
      "gloss": "to be right",
      "note": "literally 'to have reason'"
    }
  ],
  "concepts": [
    {
      "id": "c-past-tense-imperfect-imparfait",
      "term": "{j'avais} = I had",
      "definition": "This past tense describes what you had, or how things were.",
      "examples": [
        {
          "fr": "J'avais un chat.",
          "en": "I had a cat."
        },
        {
          "fr": "Nous avions une maison.",
          "en": "We had a house."
        }
      ]
    },
    {
      "id": "c-avais-had-singular",
      "term": "I had, you had",
      "definition": "{j'avais} and {tu avais} have the same ending and the same sound.",
      "examples": [
        {
          "fr": "J'avais un livre.",
          "en": "I had a book."
        },
        {
          "fr": "Tu avais raison.",
          "en": "You were right.",
          "note": "French says you had reason"
        }
      ]
    },
    {
      "id": "c-avait-had-third-person",
      "term": "He had, she had",
      "definition": "{il avait} ends in -ait, but it sounds just like {j'avais}.",
      "examples": [
        {
          "fr": "Il avait un chien.",
          "en": "He had a dog."
        },
        {
          "fr": "Elle avait le temps.",
          "en": "She had time."
        }
      ]
    },
    {
      "id": "c-avions-aviez-avaient-had",
      "term": "Had: the plural forms",
      "definition": "For we, you and they. {ils avaient} sounds like {il avait}.",
      "examples": [
        {
          "fr": "Nous avions une voiture.",
          "en": "We had a car."
        },
        {
          "fr": "Vous aviez de l'argent.",
          "en": "You had money."
        },
        {
          "fr": "Ils avaient faim.",
          "en": "They were hungry."
        }
      ]
    },
    {
      "id": "c-common-expressions-with-avoir",
      "term": "Hungry and right with {avoir}",
      "definition": "French uses {avoir} where English uses to be: you have hunger, you have reason.",
      "examples": [
        {
          "fr": "J'avais faim.",
          "en": "I was hungry."
        },
        {
          "fr": "Tu avais raison.",
          "en": "You were right."
        },
        {
          "fr": "Nous avions faim.",
          "en": "We were hungry."
        }
      ]
    }
  ],
