      "fr": "toute",
      "gloss": "all (feminine singular adjective)",
      "note": "agrees with feminine nouns"
    },
    {
      "word_id": "tous-fr",
      "fr": "tous",
      "gloss": "all (masculine plural adjective/pronoun)",
      "note": "pronounced 'too' (adjective) or 'toos' (pronoun)"
    },
    {
      "word_id": "toutes-fr",
      "fr": "toutes",
      "gloss": "all (feminine plural adjective)",
      "note": "agrees with feminine plural nouns"
    },
    {
