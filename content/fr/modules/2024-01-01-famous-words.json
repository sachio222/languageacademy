  "concepts": [
    {
      "id": "c-internationally-recognized-words",
      "term": "Words you may already know",
      "definition": "Some French words are already familiar from cafés, films and travel.",
      "examples": [
        {
          "fr": "Voilà !",
          "en": "There you go!"
        },
        {
          "fr": "Café ? Oui, merci.",
          "en": "Coffee? Yes, thank you."
        }
      ]
    },
    {
      "id": "c-essential-greetings-politeness",
      "term": "Greetings and polite words",
      "definition": "Say {bonjour} when you arrive and {au revoir} when you leave. Add please when you ask for something, and thank you when you get it.",
      "examples": [
        {
          "fr": "Bonjour !",
          "en": "Hello!"
        },
        {
          "fr": "Merci !",
          "en": "Thank you!"
        },
        {
          "fr": "Oui.",
          "en": "Yes."
        },
        {
          "fr": "Non.",
          "en": "No."
        },
        {
          "fr": "Au revoir !",
          "en": "Goodbye!"
        }
      ]
    },
    {
      "id": "c-building-your-foundation",
      "term": "Short answers",
      "definition": "These words already make whole replies. Each one answers a question on its own.",
      "examples": [
        {
          "fr": "Oui, merci.",
          "en": "Yes, thank you."
        },
        {
          "fr": "Bien, merci.",
          "en": "Fine, thank you."
        },
        {
          "fr": "Bon, au revoir !",
          "en": "Right, goodbye!"
        }
      ]
    }
  ],
  "items": [
    {
      "id": "i-bonjour",
      "type": "respond",
      "situation": "You're entering a shop. Greet the shopkeeper",
      "cue": "hello / good day",
      "answer": "bonjour",
      "hint": "Famous greeting - literally 'good day'",
      "mistakes": [
        {
          "answer": "bon",
          "feedback": "That's just 'good' - need the full greeting"
        },
        {
          "answer": "salut",
          "feedback": "That's informal 'hi' - use bonjour for hello"
        }
      ]
    },
    {
      "id": "i-bonsoir",
      "type": "respond",
      "situation": "You're arriving at a restaurant in the evening. Greet the host",
      "cue": "good evening",
      "answer": "bonsoir",
      "hint": "Evening greeting - literally 'good evening'",
      "mistakes": [
        {
          "answer": "bonjour",
          "feedback": "That's for daytime - use bonsoir for evening"
        },
        {
          "answer": "bon",
          "feedback": "That's just 'good' - need the full evening greeting"
        }
      ]
    },
    {
      "id": "i-merci",
      "type": "respond",
      "situation": "Someone hands you something. How do you thank them?",
      "cue": "thank you",
      "answer": "merci",
      "hint": "Expression of gratitude - used worldwide!"
    },
    {
      "id": "i-oui",
      "type": "respond",
      "situation": "Someone offers you coffee. Accept the offer",
      "cue": "yes",
      "answer": "oui",
      "hint": "Simple affirmative - 3 letters",
      "mistakes": [
        {
          "answer": "non",
          "feedback": "That means 'no', not 'yes'"
        }
      ]
    },
    {
      "id": "i-non",
      "type": "respond",
      "situation": "Someone offers you something. Decline politely",
      "cue": "no",
      "answer": "non",
      "hint": "Simple negative - 3 letters",
      "mistakes": [
        {
          "answer": "oui",
          "feedback": "That means 'yes', not 'no'"
        }
      ]
    },
    {
      "id": "i-s-il-vous-plait",
      "type": "respond",
      "situation": "You're making a request. Add this word to be polite",
      "cue": "please (formal)",
      "answer": "s'il vous plaît",
      "hint": "Literally 'if it pleases you' - makes any request polite"
    },
    {
      "id": "i-pardon",
      "type": "respond",
      "situation": "You accidentally bump into someone. Apologize",
      "cue": "excuse me / sorry",
      "answer": "pardon",
      "hint": "Same word in English! Universal apology"
    },
    {
      "id": "i-au-revoir",
      "type": "respond",
      "situation": "You're leaving a place or conversation. Say farewell",
      "cue": "goodbye",
      "answer": "au revoir",
      "hint": "Literally 'until seeing again' - formal farewell",
      "mistakes": [
        {
          "answer": "salut",
          "feedback": "That's informal - use au revoir for goodbye"
        }
      ]
    },
    {
      "id": "i-voila",
      "type": "respond",
      "situation": "A waiter brings your order. What do they often say?",
      "cue": "there it is / here you go",
      "answer": "voilà",
      "hint": "Very French expression - presenting with flair!"
    },
    {
      "id": "i-cafe",
      "type": "respond",
      "situation": "You're at a café. Order this popular drink",
      "cue": "coffee",
      "answer": "café",
      "hint": "Cognate - spelled almost the same, just add accent!"
    },
    {
      "id": "i-bon",
      "type": "respond",
      "situation": "Wish someone well on their trip. Use this adjective",
      "cue": "good",
      "answer": "bon",
      "hint": "Used in '{bon voyage}', '{bon appétit}'",
      "mistakes": [
        {
          "answer": "bien",
          "feedback": "That means 'well' (adverb), not 'good' (adjective)"
        }
      ]
    },
    {
      "id": "i-bien",
      "type": "respond",
      "situation": "Someone asks how you are. Respond positively",
      "cue": "well",
      "answer": "bien",
      "hint": "Adverb - '{très bien}' = very well",
      "mistakes": [
        {
          "answer": "bon",
          "feedback": "That means 'good' (adjective), not 'well' (adverb)"
        }
      ]
    },
    {
      "id": "i-salut",
      "type": "respond",
      "situation": "You see a friend on the street. Greet them casually",
      "cue": "hi / bye (informal)",
      "answer": "salut",
      "hint": "Casual greeting - use with friends only!",
      "mistakes": [
        {
          "answer": "bonjour",
          "feedback": "That's more formal - salut is casual"
        }
      ]
    }
  ]
}
