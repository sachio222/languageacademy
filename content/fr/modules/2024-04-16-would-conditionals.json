  "concepts": [
    {
      "id": "c-would-like-voudrais-conditional",
      "term": "Would like: {je voudrais}",
      "definition": "{vouloir} in this form asks for something politely. It sounds softer than {je veux}.",
      "examples": [
        {
          "fr": "Je voudrais de l'eau.",
          "en": "I would like some water."
        },
        {
          "fr": "Tu voudrais du café ?",
          "en": "Would you like some coffee?"
        },
        {
          "fr": "Nous voudrions partir.",
          "en": "We would like to leave."
        }
      ]
    },
    {
      "id": "c-would-go-irais-conditional",
      "term": "Would go: {j'irais}",
      "definition": "{aller} in this form says where you would go.",
      "examples": [
        {
          "fr": "J'irais à Paris.",
          "en": "I would go to Paris."
        },
        {
          "fr": "Ils iraient avec toi.",
          "en": "They would go with you."
        },
        {
          "fr": "Tu irais là-bas ?",
          "en": "Would you go there?"
        }
      ]
    },
    {
      "id": "c-would-do-ferais-conditional",
      "term": "Would do: {je ferais}",
      "definition": "{faire} in this form says what you would do.",
      "examples": [
        {
          "fr": "Je ferais ça.",
          "en": "I would do that."
        },
        {
          "fr": "Vous feriez quoi ?",
          "en": "What would you do?"
        },
        {
          "fr": "Elle ferait ça.",
          "en": "She would do that."
        }
      ]
    },
    {
      "id": "c-negation-with-would",
      "term": "Would not",
      "definition": "Put {ne} … {pas} around the verb. Before a vowel, {ne} becomes {n'}.",
      "examples": [
        {
          "fr": "Je ne voudrais pas ça.",
          "en": "I wouldn't want that."
        },
        {
          "fr": "Il n'irait pas.",
          "en": "He wouldn't go."
        },
        {
          "fr": "Nous ne ferions pas ça.",
          "en": "We wouldn't do that."
        }
      ]
    }
  ],
