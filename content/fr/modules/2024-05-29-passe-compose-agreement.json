  "concepts": [
    {
      "id": "c-agreement-rule-with-etre",
      "term": "Agreement Rule with être",
      "definition": "When using ÊTRE in passé composé, past participle MUST agree with subject in gender and number",
      "example": "{il est allé} (masculine), {elle est allée} (+e), {ils sont allés} (+s), {elles sont allées} ({+es})"
    },
    {
      "id": "c-masculine-singular-no-change",
      "term": "Masculine singular - No change",
      "definition": "Il/On: No change to past participle (base form)",
      "example": "{il est allé}, {il est venu}, {il est parti}, {on est resté}"
    },
    {
      "id": "c-feminine-singular-add-e",
      "term": "Feminine singular - Add e",
      "definition": "Elle: Add -e to past participle",
      "example": "{elle est allée}, {elle est venue}, {elle est partie}, {elle est restée}"
    },
    {
      "id": "c-masculine-plural-add-s",
      "term": "Masculine plural - Add s",
      "definition": "Ils/Nous/Vous (masculine): Add -s to past participle",
      "example": "{ils sont allés}, {nous sommes venus}, {vous êtes partis}"
    },
    {
      "id": "c-feminine-plural-add-es",
      "term": "Feminine plural - Add es",
      "definition": "Elles/Nous/Vous (feminine): Add -es to past participle",
      "example": "{elles sont allées}, {nous sommes venues} (all feminine), {vous êtes parties} (all feminine)"
    },
    {
      "id": "c-mixed-group-use-masculine",
      "term": "Mixed group - Use masculine form",
      "definition": "When group has both masculine and feminine, use masculine plural (-s)",
      "example": "{Pierre et Marie sont allés} (masculine plural wins)"
    },
    {
      "id": "c-remember-only-with-etre",
      "term": "Remember: Only with ÊTRE verbs!",
      "definition": "This rule ONLY applies to être verbs (DR MRS VANDERTRAMP + reflexives)",
      "example": "{j'ai mangé} (no change with avoir!), BUT je suis allé/{allée} (agrees with être)"
    }
  ],
