  "concepts": [
    {
      "id": "c-most-common-verbs-irregular",
      "term": "Irregular commands",
      "definition": "The most common verbs have command forms of their own.",
      "examples": [
        {
          "fr": "Sois gentil !",
          "en": "Be nice!"
        },
        {
          "fr": "Aie courage !",
          "en": "Have courage!"
        },
        {
          "fr": "Va là-bas !",
          "en": "Go over there!"
        },
        {
          "fr": "Fais attention !",
          "en": "Be careful!"
        }
      ]
    },
    {
      "id": "c-must-memorize-these",
      "term": "{Vas-y !}",
      "definition": "A very common phrase for go ahead or go for it. The {y} means there.",
      "examples": [
        {
          "fr": "Vas-y !",
          "en": "Go ahead!"
        },
        {
          "fr": "Allons-y !",
          "en": "Let's go!"
        }
      ]
    },
    {
      "id": "c-etre-commands",
      "term": "Commands of {être}",
      "definition": "The command forms of {être} are irregular.",
      "examples": [
        {
          "fr": "Sois gentil !",
          "en": "Be nice!",
          "note": "to a friend"
        },
        {
          "fr": "Soyez gentil !",
          "en": "Be kind!",
          "note": "to someone you call {vous}"
        },
        {
          "fr": "Soyons gentils !",
          "en": "Let's be nice!"
        },
        {
          "fr": "Sois là à six heures !",
          "en": "Be there at six!"
        }
      ]
    },
    {
      "id": "c-avoir-commands",
      "term": "Commands of {avoir}",
      "definition": "The command forms of {avoir} are irregular too.",
      "examples": [
        {
          "fr": "Aie confiance !",
          "en": "Have confidence!",
          "note": "to a friend"
        },
        {
          "fr": "N'ayez pas peur !",
          "en": "Don't be afraid!",
          "note": "to someone you call {vous}"
        },
        {
          "fr": "Ayons confiance !",
          "en": "Let's be confident!"
        }
      ]
    },
    {
      "id": "c-aller-commands",
      "term": "Commands of {aller}",
      "definition": "To a friend, the command is {va}, with no s. Before {y}, the s comes back: {vas-y}.",
      "examples": [
        {
          "fr": "Va là-bas !",
          "en": "Go over there!"
        },
        {
          "fr": "Allons-y !",
          "en": "Let's go!"
        },
        {
          "fr": "Vas-y !",
          "en": "Go ahead!"
        }
      ]
    },
    {
      "id": "c-faire-commands",
      "term": "Commands of {faire}",
      "definition": "Say {fais} to a friend and {faites} to someone you call {vous}.",
      "examples": [
        {
          "fr": "Fais attention !",
          "en": "Be careful!"
        },
        {
          "fr": "Faites ça !",
          "en": "Do that!"
        }
      ]
    },
    {
      "id": "c-y-there",
      "term": "{y}: there",
      "definition": "{y} stands for a place you already named, like {au café}. It goes before the verb, but after the verb in a positive command.",
      "examples": [
        {
          "fr": "Tu vas au café ? Oui, j'y vais.",
          "en": "Are you going to the café? Yes, I'm going there."
        },
        {
          "fr": "Non, je n'y vais pas.",
          "en": "No, I'm not going there."
        },
        {
          "fr": "Nous y allons.",
          "en": "We're going there."
        }
      ]
    }
  ],
  "items": [
    {
      "id": "irreg-cmd-1",
      "type": "respond",
      "situation": "Command: 'Be nice!' (informal)",
      "cue": "Be nice! (to a friend)",
      "answer": "sois gentil",
      "hint": "{Sois + gentil!}",
      "mistakes": [
        {
          "answer": "es gentil",
          "feedback": "Use command form '{Sois}', not 'es'"
        }
      ]
    },
    {
      "id": "irreg-cmd-2",
      "type": "respond",
      "situation": "Command: 'Have courage!' (informal)",
      "cue": "Have courage!",
      "answer": "aie courage",
      "hint": "{Aie + courage!}"
    },
    {
      "id": "irreg-cmd-3",
      "type": "respond",
      "situation": "Command: 'Go over there!' (informal)",
      "cue": "Go over there!",
      "answer": "va là-bas",
      "accept": [
        "va la-bas"
      ],
      "hint": "{Va + là-bas!}"
    },
    {
      "id": "irreg-cmd-4",
      "type": "respond",
      "situation": "Say the famous phrase 'Go ahead!' or 'Go for it!'",
      "cue": "Go ahead!",
      "answer": "vas-y",
      "accept": [
        "vas y"
      ],
      "hint": "Va + -s + -y! (special form)",
      "mistakes": [
        {
          "answer": "va-y",
          "feedback": "Add -s before -y: Vas-y! (special form)"
        }
      ]
    },
    {
      "id": "irreg-cmd-5",
      "type": "respond",
      "situation": "Command: 'Pay attention!' or 'Be careful!' (informal)",
      "cue": "Be careful! / Pay attention!",
      "answer": "fais attention",
      "hint": "{Fais + attention!}"
    },
    {
      "id": "irreg-cmd-6",
      "type": "respond",
      "situation": "Command: 'Let's go!' (nous form)",
      "cue": "Let's go!",
      "answer": "allons-y",
      "accept": [
        "allons y"
      ],
      "hint": "{Allons + -y!}"
    },
    {
      "id": "i-oui-j-y-vais",
      "type": "respond",
      "situation": "A friend asks {Tu vas au café ?} Say yes, you're going there. Use {y}.",
      "answer": "oui, j'y vais",
      "accept": [
        "j'y vais",
        "oui j y vais",
        "j y vais"
      ],
      "hint": "{y} goes before the verb",
      "mistakes": [
        {
          "answer": "oui, je vais y",
          "feedback": "{y} goes before the verb: {j'y vais}."
        }
      ]
    },
    {
      "id": "i-nous-y-allons",
      "type": "transform",
      "instruction": "Swap the place for {y}.",
      "shown": "Nous allons à Paris.",
      "answer": "nous y allons",
      "mistakes": [
        {
          "answer": "nous allons y",
          "feedback": "{y} goes before the verb: {nous y allons}."
        }
      ]
    },
    {
      "id": "i-non-je-n-y-vais-pas",
      "type": "respond",
      "situation": "A friend asks {Tu vas chez Paul ?} Say no, you're not going there. Use {y}.",
      "answer": "non, je n'y vais pas",
      "accept": [
        "je n'y vais pas",
        "non je n y vais pas",
        "je n y vais pas"
      ],
      "hint": "{ne} goes before {y}, and {pas} after the verb",
      "mistakes": [
        {
          "answer": "non, je ne vais pas y",
          "feedback": "{y} stays before the verb, after {ne}: {je n'y vais pas}."
        }
      ]
    }
  ]
}
