  "concepts": [
    {
      "id": "c-passe-compose-avoir-past",
      "term": "Passé Composé = avoir + past participle",
      "definition": "Compound past tense for completed actions: auxiliary verb '{avoir}' + past participle",
      "example": "{j'ai parlé} (I spoke), {tu as mangé} (you ate), {il a étudié} (he studied)"
    },
    {
      "id": "c-regular-er-verbs-e",
      "term": "Regular -ER verbs → -é past participle",
      "definition": "Remove -er, add -é: parler → parlé, manger → mangé, étudier → étudié",
      "example": "{parler} → {parlé} (spoken), {manger} → {mangé} (eaten), {aimer} → {aimé} (loved)"
    },
    {
      "id": "c-formation-j-ai-past",
      "term": "Formation: j'ai + past participle",
      "definition": "Use present tense of avoir + past participle ending in -é",
      "example": "{j'ai parlé}, {tu as parlé}, {il}/{elle a parlé}, {nous avons parlé}, {vous avez parlé}, {ils}/{elles ont parlé}"
    },
    {
      "id": "c-negation-ne-pas-around",
      "term": "Negation: ne...pas around avoir",
      "definition": "Place ne and pas around the auxiliary verb avoir",
      "example": "{je n'ai pas parlé} (I didn't speak), {tu n'as pas mangé} (you didn't eat)"
    },
    {
      "id": "c-questions-inversion-or-est",
      "term": "Questions: inversion or {Est-ce que}",
      "definition": "Invert avoir with subject, or use est-ce que",
      "example": "{As-tu parlé?} (Did you speak?), {Est-ce que tu as mangé?} (Did you eat?)"
    },
    {
      "id": "c-when-to-use-passe",
      "term": "When to use Passé Composé",
      "definition": "For specific completed actions in the past, countable events",
      "example": "{Hier, j'ai parlé avec Marie} (Yesterday, I spoke with Marie), {J'ai mangé à 8h} (I ate at 8)"
    }
  ],
