{
  "schema": "la-module@1",
  "module_key": "2024-03-26-location-adverbs",
  "kind": "lesson",
  "status": "written",
  "title": "Location Adverbs - here, there, everywhere",
  "description": "Express where things are! From 'here' to 'over there' to 'everywhere'.",
  "can_do": [
    "Point to locations (here, there, over there, everywhere)",
    "Express presence across different places",
    "Say 'I'm here' or 'It's over there' in French"
  ],
  "teaches": {
    "constructions": [
      "fr:cx:adverb.placement",
      "fr:cx:chunk.quelque-part",
      "fr:cx:chunk.nulle-part"
    ],
    "words": [
      "fr:lex:part"
    ]
  },
  "vocabulary": [
    {
      "word_id": "ici-fr",
      "fr": "ici",
      "gloss": "here",
      "note": "this location, nearby"
    },
    {
      "word_id": "la-fr.there",
      "fr": "là",
      "gloss": "there",
      "note": "that location"
    },
    {
      "word_id": "la-bas-fr",
      "fr": "là-bas",
      "gloss": "over there",
      "note": "farther away"
    },
    {
      "word_id": "partout-fr",
      "fr": "partout",
      "gloss": "everywhere",
      "note": "all places"
    },
    {
      "word_id": "quelque-part-fr",
      "fr": "quelque part",
      "gloss": "somewhere",
      "note": "some place"
    },
    {
      "word_id": "nulle-part-fr",
      "fr": "nulle part",
      "gloss": "nowhere (with ne)",
      "note": "no place"
    }
  ],
  "concepts": [
    {
      "id": "c-basic-location",
      "term": "{ici} and {là}",
      "definition": "{ici} is here, where you are. {là} is there, a place you can point to.",
      "examples": [
        {
          "fr": "Je suis ici.",
          "en": "I'm here."
        },
        {
          "fr": "Le chat est là.",
          "en": "The cat is there."
        }
      ]
    },
    {
      "id": "c-distance-with-la-bas",
      "term": "{là-bas} = over there",
      "definition": "{là-bas} is farther away than {là}.",
      "examples": [
        {
          "fr": "Le café est là-bas.",
          "en": "The café is over there."
        },
        {
          "fr": "Je vais là-bas.",
          "en": "I'm going over there."
        }
      ]
    },
    {
      "id": "c-quantity-of-places",
      "term": "Everywhere, somewhere, nowhere",
      "definition": "{nulle part} needs {ne} before the verb, like {jamais}.",
      "examples": [
        {
          "fr": "Je vais partout.",
          "en": "I go everywhere."
        },
        {
          "fr": "Le livre est quelque part.",
          "en": "The book is somewhere."
        },
        {
          "fr": "Je ne vais jamais nulle part.",
          "en": "I never go anywhere."
        }
      ]
    },
    {
      "id": "c-position-in-sentence",
      "term": "Where these words go",
      "definition": "They usually come after the verb.",
      "examples": [
        {
          "fr": "Il est ici.",
          "en": "He's here."
        },
        {
          "fr": "Le chat est partout.",
          "en": "The cat is everywhere."
        },
        {
          "fr": "Demain, il est là-bas.",
          "en": "Tomorrow he's over there."
        }
      ]
    }
  ],
  "items": [
    {
      "id": "i-ici",
      "type": "translate",
      "prompt": "here",
      "answer": "ici",
      "hint": "This location - nearby",
      "mistakes": [
        {
          "answer": "là",
          "feedback": "That's 'there', not 'here'"
        }
      ]
    },
    {
      "id": "i-la",
      "type": "translate",
      "prompt": "there",
      "answer": "là",
      "hint": "That location",
      "mistakes": [
        {
          "answer": "ici",
          "feedback": "That's 'here', not 'there'"
        }
      ]
    },
    {
      "id": "i-la-bas",
      "type": "respond",
      "situation": "Say 'over there' (farther away)",
      "cue": "over there",
      "answer": "là-bas",
      "hint": "là + bas (over there, in the distance)",
      "mistakes": [
        {
          "answer": "là",
          "feedback": "That's just 'there' - use '{là-bas}' for 'over there'"
        }
      ]
    },
    {
      "id": "i-partout",
      "type": "translate",
      "prompt": "everywhere",
      "answer": "partout",
      "hint": "All places - par + tout"
    },
    {
      "id": "i-quelque-part",
      "type": "translate",
      "prompt": "somewhere",
      "answer": "quelque part",
      "hint": "quelque + part (some place)"
    },
    {
      "id": "i-nulle-part",
      "type": "respond",
      "situation": "Say 'nowhere' (used with ne)",
      "cue": "nowhere",
      "answer": "nulle part",
      "hint": "nulle + part (no place)"
    },
    {
      "id": "i-je-suis-ici",
      "type": "translate",
      "prompt": "I am here",
      "answer": "je suis ici",
      "hint": "{je suis + ici}"
    },
    {
      "id": "i-le-chat-est-la",
      "type": "translate",
      "prompt": "the cat is there",
      "answer": "le chat est là",
      "hint": "{le chat + est + là}"
    },
    {
      "id": "i-le-cafe-est-la",
      "type": "translate",
      "prompt": "the café is over there",
      "answer": "le café est là-bas",
      "hint": "{le café + est + là-bas}"
    },
    {
      "id": "i-je-vais-partout",
      "type": "translate",
      "prompt": "I go everywhere",
      "answer": "je vais partout",
      "hint": "{je vais + partout}"
    },
    {
      "id": "i-je-ne-vais-jamais",
      "type": "respond",
      "situation": "Say 'I never go nowhere' (double negative for 'I never go anywhere')",
      "cue": "I never go anywhere",
      "answer": "je ne vais jamais nulle part",
      "accept": [
        "je ne vais nulle part"
      ],
      "hint": "{je ne vais jamais + nulle part}"
    },
    {
      "id": "i-le-livre-est-quelque",
      "type": "translate",
      "prompt": "the book is somewhere",
      "answer": "le livre est quelque part",
      "hint": "{le livre + est + quelque part}"
    }
  ]
}
