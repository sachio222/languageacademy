  "concepts": [
    {
      "id": "c-etre-to-be",
      "term": "{être} = to be",
      "definition": "The most important verb. Describes states and identity.",
      "example": "Express: I am, you are, he is, she is, we are, they are"
    },
    {
      "id": "c-conjugation-pattern",
      "term": "Conjugation Pattern",
      "definition": "Each pronoun gets a unique verb form - you must memorize all 8 to communicate who is doing what!",
      "example": "{je suis}, {tu es}, {il est}, {elle est}, {nous sommes}, {vous êtes}, {ils sont}, {elles sont}"
    },
    {
      "id": "c-practical-usage",
      "term": "Practical Usage",
      "definition": "Use it with an adjective, as in \"I am happy\", or with your name, as in \"I am Paul\".",
      "example": "{Je suis heureux} (I am happy), {Il est heureux} (he is happy), {Je suis Paul} (I am Paul), {Tu es bon !} (you're good!)"
    },
    {
      "id": "c-at-the-cafe",
      "term": "At the café",
      "definition": "With the words from the first lesson, you can already answer a waiter.",
      "example": "{Bonjour ! Café ?} (Hello! Coffee?) {Oui, merci !} (Yes, thanks!)"
    }
  ],
