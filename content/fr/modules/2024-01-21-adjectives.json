{
  "schema": "la-module@1",
  "module_key": "2024-01-21-adjectives",
  "kind": "lesson",
  "status": "written",
  "title": "Common Adjectives - Describing Things",
  "description": "Learn essential adjectives WITH gender agreement: un bon livre (a good book), une grande maison (a big house)",
  "can_do": [
    "Describe things as big, small, good, bad, new, old",
    "Use adjectives with correct gender agreement",
    "Say 'a good book' or 'a big house' in French"
  ],
  "teaches": {
    "constructions": [
      "fr:cx:adj.agreement",
      "fr:cx:adj.placement",
      "fr:cx:adj.regular",
      "fr:cx:adj.e"
    ]
  },
  "vocabulary": [
    {
      "word_id": "bon-bonne-fr",
      "fr": "bon / bonne",
      "gloss": "good",
      "note": "{un bon livre / une bonne maison}"
    },
    {
      "word_id": "grand-grande-fr",
      "fr": "grand / grande",
      "gloss": "big, tall",
      "note": "{un grand homme / une grande femme}"
    },
    {
      "word_id": "petit-petite-fr",
      "fr": "petit / petite",
      "gloss": "small",
      "note": "{un petit chat / une petite maison}"
    },
    {
      "word_id": "nouveau-nouvelle-fr",
      "fr": "nouveau / nouvelle",
      "gloss": "new",
      "note": "{un nouveau livre / une nouvelle voiture}"
    },
    {
      "word_id": "vieux-vieille-fr",
      "fr": "vieux / vieille",
      "gloss": "old",
      "note": "{un vieux chat / une vieille maison}"
    },
    {
      "word_id": "jeune-jeune-fr",
      "fr": "jeune / jeune",
      "gloss": "young",
      "note": "un jeune homme / une jeune femme (same both)"
    },
    {
      "word_id": "beau-belle-fr",
      "fr": "beau / belle",
      "gloss": "beautiful",
      "note": "{un beau livre / une belle maison}"
    },
    {
      "word_id": "autre-autre-fr",
      "fr": "autre / autre",
      "gloss": "other",
      "note": "un autre livre / une autre maison (same both)"
    },
    {
      "word_id": "bel-nouvel-vieil-fr",
      "fr": "bel / nouvel / vieil",
      "gloss": "beautiful / new / old, before a masculine singular noun with a vowel sound",
      "note": "{un bel enfant / un nouvel ami / un vieil homme}"
    },
    {
      "word_id": "belles-vieilles-fr",
      "fr": "belles / vieilles",
      "gloss": "beautiful / old, feminine plural",
      "note": "{les belles maisons / les vieilles maisons}"
    }
  ],
  "concepts": [
    {
      "id": "c-adjective-gender-agreement-critical",
      "term": "Adjectives match their noun",
      "definition": "An adjective takes the gender of the noun it describes. Most add an -e for a feminine noun.",
      "examples": [
        {
          "fr": "J'ai un bon livre.",
          "en": "I have a good book."
        },
        {
          "fr": "Elle a une bonne maison.",
          "en": "She has a good house."
        }
      ]
    },
    {
      "id": "c-regular-vs-irregular-forms",
      "term": "Regular and irregular forms",
      "definition": "Most adjectives add -e for the feminine, as {petit} does. A few change more, as {nouveau} and {vieux} do.",
      "examples": [
        {
          "fr": "un petit chat",
          "en": "a small cat"
        },
        {
          "fr": "une petite maison",
          "en": "a small house"
        },
        {
          "fr": "un nouveau livre",
          "en": "a new book"
        },
        {
          "fr": "une nouvelle voiture",
          "en": "a new car"
        },
        {
          "fr": "un vieux chat",
          "en": "an old cat"
        },
        {
          "fr": "une vieille maison",
          "en": "an old house"
        }
      ]
    },
    {
      "id": "c-same-form-both-genders",
      "term": "One form for both genders",
      "definition": "A few adjectives, such as {jeune} and {autre}, have one form for both genders.",
      "examples": [
        {
          "fr": "un jeune homme",
          "en": "a young man"
        },
        {
          "fr": "une jeune femme",
          "en": "a young woman"
        },
        {
          "fr": "un autre livre",
          "en": "another book"
        },
        {
          "fr": "une autre voiture",
          "en": "another car"
        }
      ]
    },
    {
      "id": "c-adjective-placement",
      "term": "Before the noun",
      "definition": "These common adjectives go before the noun, while most French adjectives go after it.",
      "examples": [
        {
          "fr": "J'ai un petit chat.",
          "en": "I have a small cat."
        },
        {
          "fr": "C'est un beau livre.",
          "en": "It's a beautiful book."
        },
        {
          "fr": "Nous avons une belle maison.",
          "en": "We have a beautiful house."
        }
      ]
    },
    {
      "id": "c-before-a-vowel-bel",
      "term": "Before a vowel sound",
      "definition": "Before a masculine noun that starts with a vowel sound, three of these adjectives change form so the words run together. Feminine forms stay the same.",
      "examples": [
        {
          "fr": "un bel enfant",
          "en": "a beautiful child"
        },
        {
          "fr": "un nouvel ami",
          "en": "a new friend"
        },
        {
          "fr": "un vieil homme",
          "en": "an old man"
        },
        {
          "fr": "une nouvelle amie",
          "en": "a new friend, a woman"
        }
      ]
    }
  ],
  "items": [
    {
      "id": "i-j-ai-un-bon",
      "type": "translate",
      "prompt": "I have a good book",
      "answer": "j'ai un bon livre",
      "hint": "Combine: j'ai + article + bon (masculine form) + livre",
      "mistakes": [
        {
          "answer": "j'ai une bonne livre",
          "feedback": "livre is masculine, use '{un bon}'"
        },
        {
          "answer": "j'ai un livre bon",
          "feedback": "bon goes BEFORE the noun: un bon livre"
        }
      ]
    },
    {
      "id": "i-elle-a-une-bonne",
      "type": "translate",
      "prompt": "she has a good house",
      "answer": "elle a une bonne maison",
      "hint": "maison is feminine - use feminine form of 'good'",
      "mistakes": [
        {
          "answer": "elle a un bon maison",
          "feedback": "maison is feminine, use '{une bonne}'"
        }
      ]
    },
    {
