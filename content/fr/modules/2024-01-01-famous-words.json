  "title": "Famous Words & Greetings",
  "description": "Start here! Learn greetings and internationally known words. You might already know some of these!",
  "can_do": [
    "Greet someone in French (bonjour, bonsoir)",
    "Say thank you, please, excuse me",
    "Recognize internationally known French words"
  ],
  "teaches": {
    "constructions": [
      "fr:cx:chunk.au-revoir",
      "fr:cx:chunk.sil-vous-plait"
    ]
  },
  "vocabulary": [
