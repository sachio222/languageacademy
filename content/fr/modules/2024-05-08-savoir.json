    {
      "id": "c-je-ne-sais-pas",
      "term": "{Je ne sais pas}",
      "definition": "One of the most common sentences in French.",
      "examples": [
        {
          "fr": "Je ne sais pas.",
          "en": "I don't know."
        },
        {
          "fr": "Tu sais ?",
          "en": "You know?"
        },
        {
          "fr": "Vous savez ?",
          "en": "Do you know?"
        }
      ]
    },
    {
      "id": "c-savoir-infinitive-know-how",
      "term": "Knowing how to do something",
      "definition": "Put a verb after {savoir} to say what you know how to do.",
      "examples": [
        {
          "fr": "Je sais parler français.",
          "en": "I can speak French."
        },
        {
          "fr": "Je sais faire du café.",
          "en": "I know how to make coffee."
        }
      ]
    },
    {
      "id": "c-savoir-vs-connaitre-preview",
      "term": "Knowing a fact",
      "definition": "{savoir} is for facts and skills, never for people or places.",
      "examples": [
        {
          "fr": "Je sais qu'il est là.",
          "en": "I know he's here."
        },
        {
          "fr": "Nous savons ça.",
          "en": "We know that."
        }
      ]
    }
