{
  "schema": "la-module@1",
  "module_key": "2024-06-01-passe-compose-irregular-1",
  "kind": "lesson",
  "status": "written",
  "title": "Irregular Past Participles - Set 1 (had, was, did, saw)",
  "description": "Learn the 4 most common irregular past participles: avoir → eu (had), être → été (was/been), faire → fait (did/made), voir → vu (saw)",
  "can_do": [
    "Use the 4 most common irregular past forms (had, was, did, saw)",
    "Say 'I had time', 'It was good', 'I did it', 'I saw him'",
    "Form past tense with the most frequent verbs"
  ],
  "teaches": {
    "constructions": [
      "fr:cx:passe-compose.avoir"
    ]
  },
  "vocabulary": [
    {
      "word_id": "j-ai-eu-fr",
      "fr": "j'ai eu",
      "gloss": "I had",
      "note": "⭐ avoir → eu (irregular!)"
    },
    {
      "word_id": "j-ai-ete-fr",
      "fr": "j'ai été",
      "gloss": "I was / I have been",
      "note": "⭐ être → été (irregular!)"
    },
    {
      "word_id": "j-ai-fait-fr",
      "fr": "j'ai fait",
      "gloss": "I did / I made",
      "note": "⭐ faire → fait (irregular!)"
    },
    {
      "word_id": "j-ai-vu-fr",
      "fr": "j'ai vu",
      "gloss": "I saw",
      "note": "⭐ voir → vu (irregular!)"
    },
    {
      "word_id": "tu-as-eu-fr",
      "fr": "tu as eu",
      "gloss": "you had",
      "note": "avoir → eu conjugated"
    },
    {
      "word_id": "il-a-fait-fr",
      "fr": "il a fait",
      "gloss": "he did / he made",
      "note": "faire → fait conjugated"
    },
    {
      "word_id": "nous-avons-vu-fr",
      "fr": "nous avons vu",
      "gloss": "we saw",
      "note": "voir → vu conjugated"
    },
    {
      "word_id": "ils-ont-ete-fr",
      "fr": "ils ont été",
      "gloss": "they were / they have been",
      "note": "être → été conjugated"
    },
    {
      "word_id": "la-chance-fr",
      "fr": "la chance",
      "gloss": "luck",
      "note": "feminine noun - avoir de la chance = to be lucky",
      "example_fr": "J'ai eu de la chance"
    },
    {
      "word_id": "les-devoirs-fr",
      "fr": "les devoirs",
      "gloss": "homework",
      "note": "plural noun",
      "example_fr": "faire ses devoirs"
    }
  ],
  "concepts": [
    {
      "id": "c-avoir-eu-had",
      "term": "{avoir}: {j'ai eu}",
      "definition": "The participle of {avoir} is {eu}, said like the French letter u.",
      "examples": [
        {
          "fr": "Hier, j'ai eu le temps.",
          "en": "Yesterday I had time."
        },
        {
          "fr": "Nous avons eu de la chance.",
          "en": "We were lucky."
        },
        {
          "fr": "Ils n'ont pas eu le temps.",
          "en": "They didn't have time."
        }
      ]
    },
    {
      "id": "c-etre-ete-was-been",
      "term": "{être}: {j'ai été}",
      "definition": "The participle of {être} is {été}, and it takes {avoir}.",
      "examples": [
        {
          "fr": "Tu as été content ?",
          "en": "Were you happy?"
        },
        {
          "fr": "Elle a été très occupée.",
          "en": "She was very busy."
        },
        {
          "fr": "J'ai été au cinéma hier.",
          "en": "I went to the cinema yesterday.",
          "note": "in everyday speech, {j'ai été} can mean I went"
        }
      ]
    },
    {
      "id": "c-faire-fait-did-made",
      "term": "{faire}: {j'ai fait}",
      "definition": "The participle of {faire} is {fait}.",
      "examples": [
        {
          "fr": "Qu'est-ce que tu as fait ?",
          "en": "What did you do?"
        },
        {
          "fr": "Elle a fait ses devoirs.",
          "en": "She did her homework."
        },
        {
          "fr": "J'ai fait un gâteau.",
          "en": "I made a cake."
        }
      ]
    },
    {
      "id": "c-voir-vu-saw",
      "term": "{voir}: {j'ai vu}",
      "definition": "The participle of {voir} is {vu}.",
      "examples": [
        {
          "fr": "J'ai vu le film hier.",
          "en": "I saw the movie yesterday."
        },
        {
          "fr": "Tu as vu Marie ?",
          "en": "Did you see Marie?"
        },
        {
          "fr": "Nous avons vu un bon film.",
          "en": "We saw a good movie."
        },
        {
          "fr": "J'ai vu Paul, il est assis au café.",
          "en": "I saw Paul, he's sitting at the café."
        }
      ]
    },
    {
      "id": "c-memory-tip",
      "term": "Learn these four first",
      "definition": "These four participles come up in almost every story about the past.",
      "examples": [
        {
          "fr": "J'ai eu raison.",
          "en": "I was right."
        },
        {
          "fr": "On a été à Paris.",
          "en": "We went to Paris."
        },
        {
          "fr": "On a fait attention.",
          "en": "We were careful."
        },
        {
          "fr": "Est-ce que vous avez vu le problème ?",
          "en": "Did you see the problem?"
        }
      ]
    },
    {
      "id": "c-all-use-avoir-as",
      "term": "All four take {avoir}",
      "definition": "Like most verbs, these four make their past with {avoir}.",
      "examples": [
        {
          "fr": "j'ai eu",
          "en": "I had"
        },
        {
          "fr": "j'ai été",
          "en": "I was"
        },
        {
          "fr": "j'ai fait",
          "en": "I did, I made"
        },
        {
          "fr": "j'ai vu",
          "en": "I saw"
        }
      ]
    }
  ],
